-- FILTER LIST AND FAVOURITES

--========================================================

local function clearFilterButtons()

    for _, child in ipairs(filterScroll:GetChildren()) do

        if child:IsA("Frame") then

            child:Destroy()

        end

    end

end

function refreshFilters()

    if not running then

        return

    end

    clearFilterButtons()

    allTab.BackgroundColor3 =

        currentTab == "All"

        and Color3.fromRGB(70, 85, 125)

        or Color3.fromRGB(42, 45, 58)

    favouriteTab.BackgroundColor3 =

        currentTab == "Favourites"

        and Color3.fromRGB(110, 85, 45)

        or Color3.fromRGB(42, 45, 58)

    for name, button in pairs(categoryButtons) do

        button.BackgroundColor3 =

            currentCategory == name

            and Color3.fromRGB(70, 85, 125)

            or Color3.fromRGB(42, 45, 58)

    end

    local shown = 0

    for _, filter in ipairs(filters) do

        local matchesTab =

            currentTab == "All"

            or favourites[filter.id] == true

        local matchesCategory =

            currentCategory == "All"

            or filter.category == currentCategory

        local matchesSearch =

            searchText == ""

            or string.find(string.lower(filter.name), searchText, 1, true)

            or string.find(string.lower(filter.category), searchText, 1, true)

        if matchesTab and matchesCategory and matchesSearch then

            shown += 1

            local row = Instance.new("Frame")

            row.Size = UDim2.new(1, -4, 0, 36)

            row.BackgroundColor3 =

                selectedFilter == filter

                and Color3.fromRGB(57, 67, 91)

                or Color3.fromRGB(38, 41, 53)

            row.BorderSizePixel = 0

            row.LayoutOrder = shown

            row.Parent = filterScroll

            local rowCorner = Instance.new("UICorner")

            rowCorner.CornerRadius = UDim.new(0, 6)

            rowCorner.Parent = row

            local selectButton = Instance.new("TextButton")

            selectButton.Size = UDim2.new(1, -48, 1, 0)

            selectButton.Position = UDim2.fromOffset(8, 0)

            selectButton.BackgroundTransparency = 1

            selectButton.Text = filter.name .. "  ·  " .. filter.category

            selectButton.TextColor3 = Color3.fromRGB(235, 235, 245)

            selectButton.TextXAlignment = Enum.TextXAlignment.Left

            selectButton.Font = Enum.Font.Gotham

            selectButton.TextSize = 11

            selectButton.Parent = row

            connect(selectButton.MouseButton1Click, function()

                applyFilter(filter)

                refreshFilters()

            end)

            local starButton = Instance.new("TextButton")

            starButton.Size = UDim2.fromOffset(36, 30)

            starButton.Position = UDim2.new(1, -40, 0, 3)

            starButton.BackgroundTransparency = 1

            starButton.Text = favourites[filter.id] and "★" or "☆"

            starButton.TextColor3 = favourites[filter.id]

                and Color3.fromRGB(255, 205, 85)

                or Color3.fromRGB(160, 165, 180)

            starButton.Font = Enum.Font.GothamBold

            starButton.TextSize = 20

            starButton.Parent = row

            connect(starButton.MouseButton1Click, function()

                favourites[filter.id] = not favourites[filter.id]

                    or nil

                refreshFilters()

            end)

        end

    end

    if shown == 0 then

        local empty = makeLabel(

            filterScroll,

            currentTab == "Favourites"

                and "No favourites yet. Press ☆ beside a filter to save it."

                or "No filters found.",

            UDim2.new(1, -15, 0, 50),

            UDim2.fromOffset(8, 8),

            11

        )

        empty.TextColor3 = Color3.fromRGB(155, 160, 175)

        empty.TextWrapped = true

    end

end

