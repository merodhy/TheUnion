local iconsHidden = false

local coreGuiTypes = {

    Enum.CoreGuiType.Backpack,

    Enum.CoreGuiType.Chat,

    Enum.CoreGuiType.EmotesMenu,

    Enum.CoreGuiType.Health,

    Enum.CoreGuiType.PlayerList

}

local function setIconsHidden(hidden)

    iconsHidden = hidden

    for _, guiType in ipairs(coreGuiTypes) do

        pcall(function()

            StarterGui:SetCoreGuiEnabled(guiType, not hidden)

        end)

    end

    pcall(function()

        StarterGui:SetCore("TopbarEnabled", not hidden)

    end)

    iconButton.Text = hidden and "SHOW ICONS" or "HIDE ICONS"

end

connect(iconButton.MouseButton1Click, function()

    setIconsHidden(not iconsHidden)

end)

