local selectedFilter = nil

local function applySky(category)

    local settings = skySettings[category]

    if not settings then

        return

    end

    existingAtmosphere.Color = settings.color

    existingAtmosphere.Decay = settings.decay

    existingAtmosphere.Density = 0.25

    existingAtmosphere.Haze = 1.2

    existingAtmosphere.Glare = 0.1

    Lighting.Ambient = settings.decay:Lerp(settings.color, 0.35)

    Lighting.OutdoorAmbient = settings.color:Lerp(settings.decay, 0.25)

end

local function resetVisuals()

    colorEffect.Enabled = false

    bloomEffect.Enabled = false

    raysEffect.Enabled = false

    depthEffect.Enabled = false

    Lighting.Ambient = originalLighting.Ambient

    Lighting.OutdoorAmbient = originalLighting.OutdoorAmbient

    Lighting.Brightness = originalLighting.Brightness

    Lighting.ExposureCompensation = originalLighting.ExposureCompensation

    Lighting.ClockTime = originalLighting.ClockTime

    Lighting.FogColor = originalLighting.FogColor

    Lighting.FogEnd = originalLighting.FogEnd

    Lighting.FogStart = originalLighting.FogStart

    Lighting.GlobalShadows = originalLighting.GlobalShadows

    if originalAtmosphere then

        local obj = originalAtmosphere.object

        if obj and obj.Parent then

            obj.Color = originalAtmosphere.Color

            obj.Decay = originalAtmosphere.Decay

            obj.Density = originalAtmosphere.Density

            obj.Haze = originalAtmosphere.Haze

            obj.Glare = originalAtmosphere.Glare

            obj.Offset = originalAtmosphere.Offset

        end

    elseif createdAtmosphere and existingAtmosphere then

        existingAtmosphere.Density = 0

        existingAtmosphere.Haze = 0

        existingAtmosphere.Glare = 0

    end

end

local function applyFilter(filter)

    if not filter then

        return

    end

    selectedFilter = filter

    resetVisuals()

    colorEffect.Enabled = true

    colorEffect.TintColor = filter.tint

    colorEffect.Saturation = filter.saturation

    colorEffect.Contrast = filter.contrast

    colorEffect.Brightness = filter.brightness

    bloomEffect.Enabled = true

    bloomEffect.Intensity = 0.25

    bloomEffect.Size = 24

    bloomEffect.Threshold = 1.1

    raysEffect.Enabled = true

    raysEffect.Intensity = 0.08

    raysEffect.Spread = 0.8

    depthEffect.Enabled = false

    applySky(filter.category)

end

