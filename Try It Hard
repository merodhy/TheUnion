local filters = {}

local function addFilter(name, category, tint, saturation, contrast, brightness)

    table.insert(filters, {

        name = name,

        category = category,

        tint = tint,

        saturation = saturation or 0.1,

        contrast = contrast or 0.1,

        brightness = brightness or 0,

        id = #filters + 1

    })

end

