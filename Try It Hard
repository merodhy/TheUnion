--========================================================

-- KEYBOARD SHORTCUTS

--========================================================

local function cleanup()

    if not running then

        return

    end

    running = false

    for targetPlayer in pairs(ESPObjects) do
        removePlayerESP(targetPlayer)
    end

    for targetPlayer in pairs(ESPPlayerConnections) do
        removeESPPlayerConnections(targetPlayer)
    end

    for _, connection in ipairs(connections) do

        pcall(function()

            connection:Disconnect()

        end)

    end

    resetVisuals()

    if createdAtmosphere and existingAtmosphere then

        existingAtmosphere:Destroy()

    end

    colorEffect:Destroy()

    bloomEffect:Destroy()

    raysEffect:Destroy()

    depthEffect:Destroy()

    if gui and gui.Parent then

        gui:Destroy()

    end

    setIconsHidden(false)

    _G.AestheticStudioCleanup = nil

end

_G.AestheticStudioCleanup = cleanup

connect(UserInputService.InputBegan, function(input, processed)

    if processed or not running then

        return

    end

    if input.KeyCode == Enum.KeyCode.T then

        guiVisible = not guiVisible

        gui.Enabled = guiVisible

    elseif input.KeyCode == Enum.KeyCode.R then
        togglePlayerESP()
    elseif input.KeyCode == Enum.KeyCode.P then

        cleanup()

    end

end)

