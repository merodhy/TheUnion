local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local espToggleButton = nil
local ESPEnabled = true
local ESPObjects = {}
local ESPPlayerConnections = {}

local ESP_COLOR = Color3.fromRGB(255, 65, 65)
local ESP_TEXT_COLOR = Color3.fromRGB(255, 255, 255)
local DISPLAY_NAME_SIZE = 14
local DISPLAY_NAME_WIDTH = 220
local DISPLAY_NAME_HEIGHT = 28

local function removePlayerESP(targetPlayer)
    local data = ESPObjects[targetPlayer]
    if not data then return end

    if data.Highlight then data.Highlight:Destroy() end
    if data.Billboard then data.Billboard:Destroy() end
    ESPObjects[targetPlayer] = nil
end

local function createPlayerESP(targetPlayer)
    if not running or targetPlayer == LocalPlayer then return end

    local character = targetPlayer.Character
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root then return end

    local old = ESPObjects[targetPlayer]
    if old and old.Character == character then
        old.Highlight.Enabled = ESPEnabled
        old.Billboard.Enabled = ESPEnabled
        if old.Label then
            old.Label.Text = targetPlayer.DisplayName
        end
        return
    end

    removePlayerESP(targetPlayer)

    local highlight = Instance.new("Highlight")
    highlight.Name = "UniversalStudio_PlayerHighlight"
    highlight.Adornee = character
    highlight.FillColor = ESP_COLOR
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.FillTransparency = 0.65
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Enabled = ESPEnabled
    highlight.Parent = character

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "UniversalStudio_PlayerName"
    billboard.Adornee = root
    billboard.Size = UDim2.fromOffset(DISPLAY_NAME_WIDTH, DISPLAY_NAME_HEIGHT)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Enabled = ESPEnabled
    billboard.Parent = playerGui

    local label = Instance.new("TextLabel")
    label.Name = "DisplayName"
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Text = targetPlayer.DisplayName
    label.TextColor3 = ESP_TEXT_COLOR
    label.TextStrokeColor3 = Color3.new(0, 0, 0)
    label.TextStrokeTransparency = 0
    label.TextScaled = false
    label.TextSize = DISPLAY_NAME_SIZE
    label.TextWrapped = false
    label.TextTruncate = Enum.TextTruncate.AtEnd
    label.Font = Enum.Font.GothamBold
    label.Parent = billboard

    ESPObjects[targetPlayer] = {
        Character = character,
        Highlight = highlight,
        Billboard = billboard,
        Label = label
    }
end

local function refreshPlayerESP()
    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= LocalPlayer then
            if ESPEnabled then
                createPlayerESP(targetPlayer)
            else
                local data = ESPObjects[targetPlayer]
                if data then
                    data.Highlight.Enabled = false
                    data.Billboard.Enabled = false
                end
            end
        end
    end
end

local function togglePlayerESP()
    if not running then return end
    ESPEnabled = not ESPEnabled
    refreshPlayerESP()
    if espToggleButton then
        espToggleButton.Text = ESPEnabled and "PLAYER ESP: ON" or "PLAYER ESP: OFF"
    end
end

local function setupESPPlayer(targetPlayer)
    if targetPlayer == LocalPlayer or ESPPlayerConnections[targetPlayer] then
        return
    end

    local playerConnections = {}
    ESPPlayerConnections[targetPlayer] = playerConnections

    table.insert(playerConnections, targetPlayer.CharacterAdded:Connect(function(character)
        removePlayerESP(targetPlayer)
        if not running or not ESPEnabled then return end

        task.spawn(function()
            local root = character:WaitForChild("HumanoidRootPart", 10)
            if root and running and ESPEnabled then
                createPlayerESP(targetPlayer)
            end
        end)
    end))

    table.insert(playerConnections, targetPlayer.CharacterRemoving:Connect(function()
        removePlayerESP(targetPlayer)
    end))

    if targetPlayer.Character and ESPEnabled then
        createPlayerESP(targetPlayer)
    end
end

local function removeESPPlayerConnections(targetPlayer)
    removePlayerESP(targetPlayer)
    local list = ESPPlayerConnections[targetPlayer]
    if list then
        for _, connection in ipairs(list) do
            pcall(function() connection:Disconnect() end)
        end
        ESPPlayerConnections[targetPlayer] = nil
    end
end


