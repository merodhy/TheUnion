-- Global lifecycle management. Every long-lived module can register one cleanup callback.
local activeConnections = {}
local cleanupCallbacks = {}
local shuttingDown = false
local cleanupComplete = false

local function addConnection(conn)
    if conn and typeof(conn) == "RBXScriptConnection" then
        table.insert(activeConnections, conn)
        if shuttingDown then
            pcall(function() conn:Disconnect() end)
        end
    end
    return conn
end

local function registerCleanup(callback)
    if type(callback) ~= "function" then return end
    if shuttingDown then
        pcall(callback)
        return
    end
    table.insert(cleanupCallbacks, callback)
end

local function disconnectConnection(conn)
    if conn and typeof(conn) == "RBXScriptConnection" then
        pcall(function() conn:Disconnect() end)
    end
end

