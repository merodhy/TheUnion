    sessionStats.Parent = sessionTab
    Instance.new("UICorner", sessionStats).CornerRadius = UDim.new(0, 5)

    local sessionSearch = Instance.new("TextBox")
    sessionSearch.Name = "SessionSearch"
    sessionSearch.Size = UDim2.new(1, 0, 0, 25)
    sessionSearch.Position = UDim2.fromOffset(0, 63)
    sessionSearch.BackgroundColor3 = Color3.fromRGB(24, 29, 42)
    sessionSearch.BorderSizePixel = 0
    sessionSearch.TextColor3 = Color3.fromRGB(235, 240, 250)
    sessionSearch.PlaceholderColor3 = Color3.fromRGB(130, 145, 165)
    sessionSearch.PlaceholderText = "Search player, username, or event..."
    sessionSearch.Text = ""
    sessionSearch.ClearTextOnFocus = false
    sessionSearch.Font = Enum.Font.Gotham
    sessionSearch.TextSize = 10
    sessionSearch.Parent = sessionTab
    Instance.new("UICorner", sessionSearch).CornerRadius = UDim.new(0, 5)

    local activityList = Instance.new("ScrollingFrame")
    activityList.Name = "SessionActivityLog"
    activityList.Size = UDim2.new(1, 0, 1, -100)
    activityList.Position = UDim2.fromOffset(0, 94)
    activityList.BackgroundColor3 = Color3.fromRGB(16, 20, 28)
    activityList.BorderSizePixel = 0
    activityList.ScrollBarThickness = 4
    activityList.CanvasSize = UDim2.new()
    activityList.AutomaticCanvasSize = Enum.AutomaticSize.Y
    activityList.Parent = sessionTab
    Instance.new("UICorner", activityList).CornerRadius = UDim.new(0, 6)

    local activityPadding = Instance.new("UIPadding")
    activityPadding.PaddingTop = UDim.new(0, 6)
    activityPadding.PaddingBottom = UDim.new(0, 6)
    activityPadding.PaddingLeft = UDim.new(0, 6)
    activityPadding.PaddingRight = UDim.new(0, 6)
    activityPadding.Parent = activityList

    local activityLayout = Instance.new("UIListLayout")
    activityLayout.Padding = UDim.new(0, 4)
    activityLayout.SortOrder = Enum.SortOrder.LayoutOrder
    activityLayout.Parent = activityList

    local function applySessionFilter()
        local query = string.lower(sessionSearch.Text or "")
        for _, row in ipairs(activityRows) do
            if row and row.Parent then
                local searchable = string.lower(
                    tostring(row:GetAttribute("SearchText") or "")
                )
                row.Visible = query == "" or string.find(searchable, query, 1, true) ~= nil
            end
        end
    end

    addConnection(sessionSearch:GetPropertyChangedSignal("Text"):Connect(applySessionFilter))

    local function updateSessionStats()
        sessionStats.Text = string.format(
            "Players: %d  |  Joined: %d  |  Left: %d",
            #Players:GetPlayers(),
            sessionJoins,
            sessionLeaves
        )
    end

    local function addActivity(eventType, playerName, username, timestamp)
        local joined = eventType == "JOIN"
        local row = Instance.new("Frame")
        row.Name = "Activity_" .. eventType
        row.Size = UDim2.new(1, -4, 0, 42)
        row.BackgroundColor3 = Color3.fromRGB(24, 29, 42)
        row.BorderSizePixel = 0
        row.Parent = activityList
        row:SetAttribute("SearchText", eventType .. " " .. playerName .. " " .. username)
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 5)

        local accent = Instance.new("Frame")
        accent.Size = UDim2.new(0, 3, 1, -10)
        accent.Position = UDim2.fromOffset(6, 5)
        accent.BackgroundColor3 = joined and Color3.fromRGB(55, 200, 120) or Color3.fromRGB(235, 90, 95)
        accent.BorderSizePixel = 0
        accent.Parent = row
        Instance.new("UICorner", accent).CornerRadius = UDim.new(1, 0)

        local eventLabel = Instance.new("TextLabel")
        eventLabel.Size = UDim2.new(1, -20, 0, 19)
        eventLabel.Position = UDim2.fromOffset(16, 3)
        eventLabel.BackgroundTransparency = 1
        eventLabel.Text = (joined and "▲ JOINED  " or "▼ LEFT  ") .. playerName .. " (@" .. username .. ")"
        eventLabel.TextColor3 = joined and Color3.fromRGB(105, 230, 155) or Color3.fromRGB(255, 130, 130)
        eventLabel.Font = Enum.Font.GothamBold
        eventLabel.TextSize = 10
        eventLabel.TextXAlignment = Enum.TextXAlignment.Left
        eventLabel.TextTruncate = Enum.TextTruncate.AtEnd
        eventLabel.Parent = row

        local timeLabel = Instance.new("TextLabel")
        timeLabel.Size = UDim2.new(1, -20, 0, 15)
        timeLabel.Position = UDim2.fromOffset(16, 22)
        timeLabel.BackgroundTransparency = 1
        timeLabel.Text = timestamp or os.date("%H:%M:%S")
        timeLabel.TextColor3 = Color3.fromRGB(135, 155, 180)
        timeLabel.Font = Enum.Font.Gotham
        timeLabel.TextSize = 9
        timeLabel.TextXAlignment = Enum.TextXAlignment.Left
        timeLabel.Parent = row

        table.insert(activityRows, row)
        table.insert(activityRecords, {
            event = eventType,
            displayName = tostring(playerName),
            username = tostring(username),
            timestamp = tostring(timestamp or os.date("%Y-%m-%d %H:%M:%S"))
        })
        if #activityRows > MAX_ACTIVITY_ROWS then
            local oldest = table.remove(activityRows, 1)
            table.remove(activityRecords, 1)
            if oldest then oldest:Destroy() end
        end
        applySessionFilter()

        task.defer(function()
            if activityList and activityList.Parent then
                activityList.CanvasPosition = Vector2.new(
                    0,
                    math.max(0, activityLayout.AbsoluteContentSize.Y - activityList.AbsoluteSize.Y)
                )
            end
        end)
    end

    -- Snapshot other players already present when tracking starts.
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            addActivity("JOIN", player.DisplayName, player.Name, os.date("%H:%M:%S") .. "  •  Already in server")
        end
    end

    addConnection(Players.PlayerAdded:Connect(function(player)
        sessionJoins = sessionJoins + 1
        addActivity("JOIN", player.DisplayName, player.Name)
        updateSessionStats()
    end))

    addConnection(Players.PlayerRemoving:Connect(function(player)
        sessionLeaves = sessionLeaves + 1
        addActivity("LEAVE", player.DisplayName, player.Name)
        updateSessionStats()
    end))

    exportSessionBtn.MouseButton1Click:Connect(function()
        local lines = {"THE UNION HUB - SESSION ACTIVITY", "Exported: " .. os.date("%Y-%m-%d %H:%M:%S"), ""}
        for _, record in ipairs(activityRecords) do
            table.insert(lines, string.format("[%s] %s - %s (@%s)", record.timestamp, record.event, record.displayName, record.username))
        end
        local output = table.concat(lines, "\n")
        local saved = false
        if type(writefile) == "function" then
            saved = pcall(writefile, "TheUnionHub_SessionLog.txt", output)
        end
        local copied = false
        if not saved and type(setclipboard) == "function" then
            copied = pcall(setclipboard, output)
        end
        if saved then
            exportSessionBtn.Text = "Saved Log!"
        elseif copied then
            exportSessionBtn.Text = "Copied!"
        else
            exportSessionBtn.Text = "Export unavailable"
        end
        task.delay(2, function()
            if exportSessionBtn and exportSessionBtn.Parent then exportSessionBtn.Text = "Export Log" end
        end)
    end)

    clearSessionBtn.MouseButton1Click:Connect(function()
        for _, row in ipairs(activityRows) do
            if row and row.Parent then row:Destroy() end
        end
        table.clear(activityRows)
        table.clear(activityRecords)
        sessionJoins = 0
        sessionLeaves = 0
        updateSessionStats()
    end)

    updateSessionStats()
end

--========================================================
-- ADDITIVE MODULES: PERFORMANCE, NOTIFICATION CENTER, SETTINGS
-- Existing tabs and controls above remain intact.
--========================================================
do
    local CONFIG_FILE = "TheUnionHub_Settings.json"
    local hubSettings = {
        joinNotifications = true,
        leaveNotifications = true,
        characterNotifications = true,
        toastNotifications = true,
        toastDuration = 3,
        performanceInterval = 1
    }

    local function loadHubSettings()
        if type(isfile) ~= "function" or type(readfile) ~= "function" then
            return false
        end
        local ok, exists = pcall(isfile, CONFIG_FILE)
        if not ok or not exists then return false end
        local readOk, raw = pcall(readfile, CONFIG_FILE)
        if not readOk or type(raw) ~= "string" then return false end
        local decodeOk, decoded = pcall(function()
            return HttpService:JSONDecode(raw)
        end)
        if not decodeOk or type(decoded) ~= "table" then return false end
        if type(decoded.joinNotifications) == "boolean" then hubSettings.joinNotifications = decoded.joinNotifications end
        if type(decoded.leaveNotifications) == "boolean" then hubSettings.leaveNotifications = decoded.leaveNotifications end
        if type(decoded.characterNotifications) == "boolean" then hubSettings.characterNotifications = decoded.characterNotifications end
        if type(decoded.toastNotifications) == "boolean" then hubSettings.toastNotifications = decoded.toastNotifications end
        if decoded.toastDuration == 3 or decoded.toastDuration == 5 or decoded.toastDuration == 8 then hubSettings.toastDuration = decoded.toastDuration end
        if decoded.performanceInterval == 1 or decoded.performanceInterval == 2 or decoded.performanceInterval == 5 then
            hubSettings.performanceInterval = decoded.performanceInterval
        end
        return true
    end

    local function saveHubSettings()
        if type(writefile) ~= "function" then return false end
        local ok, encoded = pcall(function() return HttpService:JSONEncode(hubSettings) end)
        if not ok then return false end
        local writeOk = pcall(writefile, CONFIG_FILE, encoded)
        return writeOk
    end

    loadHubSettings()

    local function makeSectionLabel(parent, text, y, height)
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -4, 0, height or 24)
        label.Position = UDim2.fromOffset(2, y)
        label.BackgroundTransparency = 1
        label.Text = text
        label.TextColor3 = Color3.fromRGB(0, 220, 255)
        label.Font = Enum.Font.GothamBold
        label.TextSize = 12
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = parent
        return label
    end

    local function makeValueLabel(parent, text, y, height)
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -4, 0, height or 28)
        label.Position = UDim2.fromOffset(2, y)
        label.BackgroundColor3 = Color3.fromRGB(16, 20, 28)
        label.BorderSizePixel = 0
        label.Text = text
        label.TextColor3 = Color3.fromRGB(205, 220, 240)
        label.Font = Enum.Font.GothamSemibold
        label.TextSize = 10
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = parent
        Instance.new("UICorner", label).CornerRadius = UDim.new(0, 5)
        return label
    end

    -- Notification center
    local notificationRows = {}
    local MAX_NOTIFICATION_ROWS = 60
    local notificationList = Instance.new("ScrollingFrame")
    notificationList.Name = "NotificationCenterList"
    notificationList.Size = UDim2.new(1, 0, 1, -42)
    notificationList.Position = UDim2.fromOffset(0, 38)
    notificationList.BackgroundColor3 = Color3.fromRGB(16, 20, 28)
    notificationList.BorderSizePixel = 0
    notificationList.ScrollBarThickness = 4
    notificationList.AutomaticCanvasSize = Enum.AutomaticSize.Y
    notificationList.CanvasSize = UDim2.new()
    notificationList.Parent = notificationsTab
    Instance.new("UICorner", notificationList).CornerRadius = UDim.new(0, 6)
    local notificationLayout = Instance.new("UIListLayout")
    notificationLayout.Padding = UDim.new(0, 4)
    notificationLayout.SortOrder = Enum.SortOrder.LayoutOrder
    notificationLayout.Parent = notificationList
    local notificationPadding = Instance.new("UIPadding")
    notificationPadding.PaddingTop = UDim.new(0, 6)
    notificationPadding.PaddingLeft = UDim.new(0, 6)
    notificationPadding.PaddingRight = UDim.new(0, 6)
    notificationPadding.Parent = notificationList

    local notificationHeader = makeSectionLabel(notificationsTab, "NOTIFICATION CENTER", 2, 28)
    notificationHeader.Size = UDim2.new(1, -110, 0, 28)
    local clearNotificationsBtn = createContentButton(
        notificationsTab, "Clear", UDim2.fromOffset(90, 26), UDim2.new(1, -90, 0, 2),
        Color3.fromRGB(130, 45, 55)
    )

    local toastFrame = Instance.new("Frame")
    toastFrame.Name = "UnionNotificationToast"
    toastFrame.Size = UDim2.fromOffset(320, 42)
    toastFrame.Position = UDim2.new(0.5, -160, 0, 54)
    toastFrame.BackgroundColor3 = Color3.fromRGB(18, 22, 32)
    toastFrame.BackgroundTransparency = 0.08
    toastFrame.BorderSizePixel = 0
    toastFrame.Visible = false
    toastFrame.ZIndex = 20
    toastFrame.Parent = gui
    Instance.new("UICorner", toastFrame).CornerRadius = UDim.new(0, 7)
    local toastStroke = Instance.new("UIStroke", toastFrame)
    toastStroke.Color = Color3.fromRGB(0, 180, 255)
    toastStroke.Thickness = 1.5
    local toastText = Instance.new("TextLabel")
    toastText.Size = UDim2.new(1, -18, 1, 0)
    toastText.Position = UDim2.fromOffset(9, 0)
    toastText.BackgroundTransparency = 1
    toastText.TextColor3 = Color3.fromRGB(235, 245, 255)
    toastText.Font = Enum.Font.GothamSemibold
    toastText.TextSize = 11
    toastText.TextWrapped = true
    toastText.ZIndex = 21
    toastText.Parent = toastFrame
    local toastSequence = 0

    local function showToast(kind, message)
        if not hubSettings.toastNotifications then return end
        toastSequence = toastSequence + 1
        local thisToast = toastSequence
        toastText.Text = tostring(message)
        toastStroke.Color = kind == "JOIN" and Color3.fromRGB(55, 200, 120)
            or (kind == "LEAVE" and Color3.fromRGB(235, 90, 95) or Color3.fromRGB(0, 180, 255))
        toastFrame.Visible = true
        toastFrame.BackgroundTransparency = 0.08
        toastFrame.Position = UDim2.new(0.5, -160, 0, 44)
        TweenService:Create(toastFrame, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.new(0.5, -160, 0, 54)
        }):Play()
        task.delay(hubSettings.toastDuration, function()
            if thisToast == toastSequence and toastFrame and toastFrame.Parent then
                local hideTween = TweenService:Create(toastFrame, TweenInfo.new(0.2), {
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0.5, -160, 0, 44)
                })
                hideTween:Play()
                hideTween.Completed:Wait()
                if thisToast == toastSequence then toastFrame.Visible = false end
            end
        end)
    end

    local function addNotification(kind, message)
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, -4, 0, 38)
        row.BackgroundColor3 = Color3.fromRGB(24, 29, 42)
        row.BorderSizePixel = 0
        row.Parent = notificationList
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 5)
        local accent = Instance.new("Frame")
        accent.Size = UDim2.new(0, 3, 1, -8)
        accent.Position = UDim2.fromOffset(5, 4)
        accent.BackgroundColor3 = kind == "JOIN" and Color3.fromRGB(55, 200, 120)
            or (kind == "LEAVE" and Color3.fromRGB(235, 90, 95) or Color3.fromRGB(0, 180, 255))
        accent.BorderSizePixel = 0
        accent.Parent = row
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -18, 1, 0)
        label.Position = UDim2.fromOffset(13, 0)
        label.BackgroundTransparency = 1
        label.Text = string.format("[%s] %s", os.date("%H:%M:%S"), tostring(message))
        label.TextColor3 = Color3.fromRGB(220, 230, 245)
        label.Font = Enum.Font.Gotham
        label.TextSize = 10
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.TextTruncate = Enum.TextTruncate.AtEnd
        label.Parent = row
        table.insert(notificationRows, row)
        if #notificationRows > MAX_NOTIFICATION_ROWS then
            local old = table.remove(notificationRows, 1)
            if old then old:Destroy() end
        end
        task.defer(function()
            if notificationList.Parent then
                notificationList.CanvasPosition = Vector2.new(0, math.max(0, notificationLayout.AbsoluteContentSize.Y - notificationList.AbsoluteSize.Y))
            end
        end)
        showToast(kind, message)
    end

    clearNotificationsBtn.MouseButton1Click:Connect(function()
        for _, row in ipairs(notificationRows) do
            if row and row.Parent then row:Destroy() end
        end
        table.clear(notificationRows)
    end)

    -- Performance monitor: one lightweight frame counter, refreshed at a configurable interval.
    makeSectionLabel(performanceTab, "LIVE PERFORMANCE MONITOR", 2, 26)
    local fpsLabel = makeValueLabel(performanceTab, "FPS: measuring...", 34)
    local pingLabel = makeValueLabel(performanceTab, "Ping: measuring...", 68)
    local memoryLabel = makeValueLabel(performanceTab, "Memory: measuring...", 102)
    local playersLabel = makeValueLabel(performanceTab, "Players: 0", 136)
    local sessionAgeLabel = makeValueLabel(performanceTab, "Session duration: 00:00:00", 170)
    local performanceNote = makeValueLabel(performanceTab, "Metrics are approximate and update periodically.", 210, 42)
    performanceNote.TextWrapped = true

    local frameCount = 0
    local lastFrameSample = os.clock()
    local sessionStartedAt = os.clock()
    addConnection(RunService.RenderStepped:Connect(function()
        frameCount = frameCount + 1
    end))

    local lastPerformanceUpdate = 0
    addConnection(RunService.Heartbeat:Connect(function()
        local now = os.clock()
        if now - lastPerformanceUpdate < hubSettings.performanceInterval then return end
        lastPerformanceUpdate = now
        local elapsed = math.max(now - lastFrameSample, 0.001)
        local fps = math.floor(frameCount / elapsed + 0.5)
        frameCount = 0
        lastFrameSample = now
        fpsLabel.Text = "FPS: " .. tostring(fps)
        local pingOk, pingSeconds = pcall(function() return LocalPlayer:GetNetworkPing() end)
        pingLabel.Text = pingOk and ("Ping: " .. tostring(math.floor(pingSeconds * 1000 + 0.5)) .. " ms") or "Ping: unavailable"
        local memoryOk, memoryMb = pcall(function() return game:GetService("Stats"):GetTotalMemoryUsageMb() end)
        memoryLabel.Text = memoryOk and ("Memory: " .. string.format("%.1f MB", memoryMb)) or "Memory: unavailable"
        playersLabel.Text = string.format("Players: %d / %d", #Players:GetPlayers(), Players.MaxPlayers)
        local seconds = math.floor(now - sessionStartedAt)
        local hours = math.floor(seconds / 3600)
        local minutes = math.floor((seconds % 3600) / 60)
        local remaining = seconds % 60
        sessionAgeLabel.Text = string.format("Session duration: %02d:%02d:%02d", hours, minutes, remaining)
    end))

    -- Settings are additive: no existing tab styling or controls are replaced.
    makeSectionLabel(settingsTab, "PREFERENCES & CONFIGURATION", 2, 26)
    local joinSettingBtn = createContentButton(settingsTab, "Join notifications: ON", UDim2.new(1, -4, 0, 34), UDim2.fromOffset(2, 36))
    local leaveSettingBtn = createContentButton(settingsTab, "Leave notifications: ON", UDim2.new(1, -4, 0, 34), UDim2.fromOffset(2, 78))
    local characterSettingBtn = createContentButton(settingsTab, "Respawn notifications: ON", UDim2.new(1, -4, 0, 34), UDim2.fromOffset(2, 120))
    local toastSettingBtn = createContentButton(settingsTab, "Toast notifications: ON", UDim2.new(1, -4, 0, 34), UDim2.fromOffset(2, 162))
    local toastDurationBtn = createContentButton(settingsTab, "Toast duration: 3 seconds", UDim2.new(1, -4, 0, 34), UDim2.fromOffset(2, 204))
    local intervalSettingBtn = createContentButton(settingsTab, "Performance refresh: 1 second", UDim2.new(1, -4, 0, 34), UDim2.fromOffset(2, 246))
    local saveSettingsBtn = createContentButton(settingsTab, "Save Settings", UDim2.new(0.5, -4, 0, 34), UDim2.fromOffset(2, 294), Color3.fromRGB(35, 75, 130))
    local resetSettingsBtn = createContentButton(settingsTab, "Reset Defaults", UDim2.new(0.5, -4, 0, 34), UDim2.new(0.5, 2, 0, 294), Color3.fromRGB(130, 45, 55))
    local settingsStatus = makeValueLabel(settingsTab, "Settings apply immediately. Save requires supported file APIs.", 338, 42)
    settingsStatus.TextWrapped = true

    local function refreshSettingsUI()
        joinSettingBtn.Text = "Join notifications: " .. (hubSettings.joinNotifications and "ON" or "OFF")
        leaveSettingBtn.Text = "Leave notifications: " .. (hubSettings.leaveNotifications and "ON" or "OFF")
        characterSettingBtn.Text = "Respawn notifications: " .. (hubSettings.characterNotifications and "ON" or "OFF")
        toastSettingBtn.Text = "Toast notifications: " .. (hubSettings.toastNotifications and "ON" or "OFF")
        toastDurationBtn.Text = "Toast duration: " .. tostring(hubSettings.toastDuration) .. " seconds"
        intervalSettingBtn.Text = "Performance refresh: " .. tostring(hubSettings.performanceInterval) .. " second(s)"
    end

    joinSettingBtn.MouseButton1Click:Connect(function()
        hubSettings.joinNotifications = not hubSettings.joinNotifications
        refreshSettingsUI()
    end)
    leaveSettingBtn.MouseButton1Click:Connect(function()
        hubSettings.leaveNotifications = not hubSettings.leaveNotifications
        refreshSettingsUI()
    end)
    characterSettingBtn.MouseButton1Click:Connect(function()
        hubSettings.characterNotifications = not hubSettings.characterNotifications
        refreshSettingsUI()
    end)
    toastSettingBtn.MouseButton1Click:Connect(function()
        hubSettings.toastNotifications = not hubSettings.toastNotifications
        if not hubSettings.toastNotifications then toastFrame.Visible = false end
        refreshSettingsUI()
    end)
    toastDurationBtn.MouseButton1Click:Connect(function()
        hubSettings.toastDuration = ({[3] = 5, [5] = 8, [8] = 3})[hubSettings.toastDuration] or 3
        refreshSettingsUI()
    end)
    intervalSettingBtn.MouseButton1Click:Connect(function()
        local nextInterval = ({[1] = 2, [2] = 5, [5] = 1})[hubSettings.performanceInterval] or 1
        hubSettings.performanceInterval = nextInterval
        refreshSettingsUI()
    end)
    saveSettingsBtn.MouseButton1Click:Connect(function()
        if saveHubSettings() then
            settingsStatus.Text = "Settings saved to " .. CONFIG_FILE
        else
            settingsStatus.Text = "File APIs unavailable. Settings remain active for this session."
        end
    end)
    resetSettingsBtn.MouseButton1Click:Connect(function()
        hubSettings.joinNotifications = true
        hubSettings.leaveNotifications = true
        hubSettings.characterNotifications = true
        hubSettings.toastNotifications = true
        hubSettings.toastDuration = 3
        hubSettings.performanceInterval = 1
        refreshSettingsUI()
        if saveHubSettings() then
            settingsStatus.Text = "Default settings restored and saved."
        else
            settingsStatus.Text = "Default settings restored for this session; file APIs unavailable."
        end
    end)
    refreshSettingsUI()

    -- Centralized event wiring for the new modules. All connections join the existing cleanup list.
    addConnection(Players.PlayerAdded:Connect(function(player)
        if hubSettings.joinNotifications then
            addNotification("JOIN", player.DisplayName .. " ( @" .. player.Name .. " ) joined the server")
        end
    end))
    addConnection(Players.PlayerRemoving:Connect(function(player)
        if hubSettings.leaveNotifications then
            addNotification("LEAVE", player.DisplayName .. " ( @" .. player.Name .. " ) left the server")
        end
    end))
    addConnection(LocalPlayer.CharacterAdded:Connect(function()
        if hubSettings.characterNotifications then
            addNotification("INFO", "Your character respawned")
        end
    end))

    addNotification("INFO", "Notification center initialized")
    addNotification("INFO", "Performance monitor initialized")
end

--========================================================
-- GLOBAL DESTROY / KILLSWITCH FUNCTION [KEYBIND P]
--========================================================
destroyAll = function()
    if cleanupComplete or shuttingDown then return end
    shuttingDown = true
    refreshCharacterGeneration = refreshCharacterGeneration + 1
    refreshingCharacter = false

    -- Stop module-specific systems before disconnecting shared event connections.
    if cleanupSubmerge then pcall(cleanupSubmerge) end

    for index = #cleanupCallbacks, 1, -1 do
        local callback = cleanupCallbacks[index]
        if type(callback) == "function" then
            local ok, err = pcall(callback)
            if not ok then warn("[TheUnionHub] Cleanup callback failed: " .. tostring(err)) end
        end
    end
    table.clear(cleanupCallbacks)

    -- Run ESP cleanup after friend callbacks so no callback can recreate ESP objects.
    if cleanupPlayerESP then pcall(cleanupPlayerESP) end

    for index = #activeConnections, 1, -1 do
        disconnectConnection(activeConnections[index])
        activeConnections[index] = nil
    end

    -- Restore the Lighting properties captured before this hub started.
    for property, value in pairs(originalLightingState) do
        if property ~= "Sky" then
            pcall(function() Lighting[property] = value end)
        end
    end

    -- Remove only ESP instances owned by this hub; do not delete unrelated highlights.
    for _, player in ipairs(Players:GetPlayers()) do
        local character = player.Character
        if character then
            for _, child in ipairs(character:GetChildren()) do
                if child:GetAttribute("TheUnionHubOwned") == true then
                    pcall(function() child:Destroy() end)
                end
            end
        end
    end

    cleanupComplete = true
    if gui and gui.Parent then pcall(function() gui:Destroy() end) end
end

--========================================================
-- MAIN TAB: BRIGHTNESS, ESP, MOVEMENT, EMOTES
--========================================================
do
    local mainScroll = Instance.new("ScrollingFrame")
    mainScroll.Size = UDim2.new(1, 0, 1, -5)
    mainScroll.Position = UDim2.fromOffset(0, 5)
    mainScroll.BackgroundTransparency = 1
    mainScroll.BorderSizePixel = 0
    mainScroll.ScrollBarThickness = 4
    mainScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    mainScroll.CanvasSize = UDim2.new()
    mainScroll.Parent = mainTab

    local mainLayout = Instance.new("UIListLayout")
    mainLayout.Padding = UDim.new(0, 8)
    mainLayout.Parent = mainScroll

    -- 1. Brightness
    local originalLighting = {
        Brightness = Lighting.Brightness,
        ClockTime = Lighting.ClockTime,
        Ambient = Lighting.Ambient,
        OutdoorAmbient = Lighting.OutdoorAmbient,
        GlobalShadows = Lighting.GlobalShadows,
        ExposureCompensation = Lighting.ExposureCompensation
    }
    local brightEnabled = false
    local brightBtn, brightStroke = createContentButton(mainScroll, "Brightness: OFF [L]", UDim2.new(1, -6, 0, 38), UDim2.new(), Color3.fromRGB(28, 33, 46))

    local function toggleBrightness()
        brightEnabled = not brightEnabled
        if brightEnabled then
            Lighting.Brightness = 3
            Lighting.ClockTime = 14
            Lighting.Ambient = Color3.fromRGB(200, 200, 200)
            Lighting.GlobalShadows = false
            brightBtn.Text = "Brightness: ON [L]"
            TweenService:Create(brightBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(35, 140, 85)}):Play()
            TweenService:Create(brightStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(60, 200, 120)}):Play()
        else
            for prop, val in pairs(originalLighting) do pcall(function() Lighting[prop] = val end) end
            brightBtn.Text = "Brightness: OFF [L]"
            TweenService:Create(brightBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(28, 33, 46)}):Play()
            TweenService:Create(brightStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(45, 55, 80)}):Play()
        end
    end
    brightBtn.MouseButton1Click:Connect(toggleBrightness)
    addConnection(UserInputService.InputBegan:Connect(function(input, processed)
        if processed or UserInputService:GetFocusedTextBox() then return end
        if input.KeyCode == Enum.KeyCode.L then toggleBrightness() end
    end))

    -- 2. Player ESP 2.0
    -- One shared ESP object per player; Friend ESP reuses this manager.
    local espEnabled = true
    local espNamesEnabled = true
    local espHighlightsEnabled = true
    local espHealthEnabled = true
    local espDistanceEnabled = true
    local espMaxDistance = 500
    local espObjects = {}
    local friendESPFlags = {}
    local ESP_UPDATE_INTERVAL = 0.2

    local PLAYER_COLOR = Color3.fromRGB(0, 200, 255)
    local FRIEND_COLOR = Color3.fromRGB(255, 215, 0)

    local function getLocalRoot()
        local character = LocalPlayer.Character
        return character and character:FindFirstChild("HumanoidRootPart")
    end

    local function removeESP(player)
        local data = espObjects[player]
        if not data then return end
        if data.Highlight then pcall(function() data.Highlight:Destroy() end) end
        if data.Billboard then pcall(function() data.Billboard:Destroy() end) end
        espObjects[player] = nil
    end

    local function isWithinRange(player, root)
        if espMaxDistance <= 0 then return true end
        local localRoot = getLocalRoot()
        if not localRoot or not root then return false end
        return (root.Position - localRoot.Position).Magnitude <= espMaxDistance
    end

    local function refreshESPStyle(player)
        local data = espObjects[player]
        if not data then return end
        local isFriend = friendESPFlags[player] == true
        local isTeammate = player.Team ~= nil and LocalPlayer.Team ~= nil and player.Team == LocalPlayer.Team
        local color = isFriend and FRIEND_COLOR or (isTeammate and player.Team.TeamColor.Color or PLAYER_COLOR)
        if data.Highlight then
            data.Highlight.FillColor = color
            data.Highlight.OutlineColor = isFriend and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(220, 245, 255)
            data.Highlight.Enabled = espHighlightsEnabled and (espEnabled or isFriend)
        end
        if data.Billboard then
            data.Billboard.Enabled = (espNamesEnabled or espHealthEnabled or espDistanceEnabled) and (espEnabled or isFriend)
        end
        if data.Label then
            data.Label.TextColor3 = color
        end
    end

    local function createESP(player)
        if player == LocalPlayer or not player.Parent then return end
        local character = player.Character
        if not character then return end
        local root = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not root or not humanoid then return end

        local existing = espObjects[player]
        if existing and existing.Character == character then
            existing.Root = root
            existing.Humanoid = humanoid
            refreshESPStyle(player)
            return
        end
        removeESP(player)

        local highlight = Instance.new("Highlight")
        highlight.Name = "ESPHighlight"
        highlight:SetAttribute("TheUnionHubOwned", true)
        highlight.Adornee = character
        highlight.FillColor = PLAYER_COLOR
        highlight.OutlineColor = Color3.fromRGB(220, 245, 255)
        highlight.FillTransparency = 0.65
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Enabled = false
        highlight.Parent = character

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "ESPName"
        billboard:SetAttribute("TheUnionHubOwned", true)
        billboard.Adornee = root
        billboard.Size = UDim2.fromOffset(220, 54)
        billboard.StudsOffset = Vector3.new(0, 3.2, 0)
        billboard.AlwaysOnTop = true
        billboard.Enabled = false
        billboard.Parent = PlayerGui

        local label = Instance.new("TextLabel")
        label.Name = "ESPInfo"
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.Text = player.DisplayName .. " (@" .. player.Name .. ")"
        label.TextColor3 = PLAYER_COLOR
        label.TextStrokeTransparency = 0.2
        label.TextStrokeColor3 = Color3.new(0, 0, 0)
        label.TextSize = 12
        label.Font = Enum.Font.GothamBold
        label.TextWrapped = true
        label.Parent = billboard

        espObjects[player] = {
            Character = character,
            Root = root,
            Humanoid = humanoid,
            Highlight = highlight,
            Billboard = billboard,
            Label = label,
        }
        refreshESPStyle(player)
    end

    local function updateESPDisplay(player, data)
        local character = player.Character
        if not character or character ~= data.Character or not data.Root or not data.Root.Parent then
            removeESP(player)
            if (espEnabled or friendESPFlags[player]) and player.Character then
                createESP(player)
            end
            return
        end

        local active = espEnabled or friendESPFlags[player] == true
        local inRange = isWithinRange(player, data.Root)
        if not active or not inRange then
            if data.Highlight then data.Highlight.Enabled = false end
            if data.Billboard then data.Billboard.Enabled = false end
            return
        end

        refreshESPStyle(player)
        local parts = {}
        if espNamesEnabled then
            table.insert(parts, player.DisplayName .. " (@" .. player.Name .. ")")
        end
        if espHealthEnabled then
            local humanoid = data.Humanoid
            if humanoid and humanoid.Parent then
                local health = math.max(0, math.floor(humanoid.Health + 0.5))
                local maxHealth = math.max(1, math.floor(humanoid.MaxHealth + 0.5))
                table.insert(parts, "HP: " .. health .. "/" .. maxHealth)
            end
        end
        if espDistanceEnabled then
            local localRoot = getLocalRoot()
            if localRoot then
                local distance = math.floor((data.Root.Position - localRoot.Position).Magnitude + 0.5)
                table.insert(parts, tostring(distance) .. " studs")
            end
        end
        data.Label.Text = table.concat(parts, "\n")
        data.Billboard.Enabled = #parts > 0
    end

    local function setESPEnabled(enabled)
        espEnabled = enabled
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                if espEnabled or friendESPFlags[player] then
                    createESP(player)
                else
                    removeESP(player)
                end
            end
        end
    end

    playerESPManager.SetFriend = function(player, enabled)
        friendESPFlags[player] = enabled == true and true or nil
        if espEnabled or friendESPFlags[player] then
            createESP(player)
        elseif not friendESPFlags[player] then
            removeESP(player)
        end
        refreshESPStyle(player)
    end
    playerESPManager.Refresh = function(player)
        if player and player ~= LocalPlayer then
            if espEnabled or friendESPFlags[player] then createESP(player) end
        end
    end

    local toggleEspBtn, espStroke = createContentButton(mainScroll, "Player ESP: ON [R]", UDim2.new(1, -6, 0, 38), UDim2.new(), Color3.fromRGB(35, 140, 85))
    TweenService:Create(espStroke, TweenInfo.new(0.01), {Color = Color3.fromRGB(60, 200, 120)}):Play()

    local function styleEspToggle(button, stroke, enabled, label)
        button.Text = label .. (enabled and ": ON" or ": OFF")
        TweenService:Create(button, TweenInfo.new(0.15), {
            BackgroundColor3 = enabled and Color3.fromRGB(35, 140, 85) or Color3.fromRGB(28, 33, 46)
        }):Play()
        TweenService:Create(stroke, TweenInfo.new(0.15), {
            Color = enabled and Color3.fromRGB(60, 200, 120) or Color3.fromRGB(45, 55, 80)
        }):Play()
    end

    local function toggleESP()
        setESPEnabled(not espEnabled)
        toggleEspBtn.Text = "Player ESP: " .. (espEnabled and "ON [R]" or "OFF [R]")
        TweenService:Create(toggleEspBtn, TweenInfo.new(0.2), {
            BackgroundColor3 = espEnabled and Color3.fromRGB(35, 140, 85) or Color3.fromRGB(28, 33, 46)
        }):Play()
        TweenService:Create(espStroke, TweenInfo.new(0.2), {
            Color = espEnabled and Color3.fromRGB(60, 200, 120) or Color3.fromRGB(45, 55, 80)
        }):Play()
    end
    toggleEspBtn.MouseButton1Click:Connect(toggleESP)
    addConnection(UserInputService.InputBegan:Connect(function(input, processed)
        if processed or UserInputService:GetFocusedTextBox() then return end
        if input.KeyCode == Enum.KeyCode.R then toggleESP() end
    end))

    -- Optional controls are added inside the existing Main tab; no tab or layout redesign.
    local espOptionsHeader = Instance.new("TextLabel")
    espOptionsHeader.Size = UDim2.new(1, -8, 0, 20)
    espOptionsHeader.BackgroundTransparency = 1
    espOptionsHeader.Text = "PLAYER ESP OPTIONS"
    espOptionsHeader.TextColor3 = Color3.fromRGB(0, 200, 255)
    espOptionsHeader.Font = Enum.Font.GothamBold
    espOptionsHeader.TextSize = 10
    espOptionsHeader.TextXAlignment = Enum.TextXAlignment.Left
    espOptionsHeader.Parent = mainScroll

    local function addEspOption(text, initial, callback)
        local button, stroke = createContentButton(mainScroll, text .. (initial and ": ON" or ": OFF"), UDim2.new(1, -6, 0, 30), UDim2.new(), initial and Color3.fromRGB(35, 100, 75) or Color3.fromRGB(28, 33, 46))
        styleEspToggle(button, stroke, initial, text)
        button.MouseButton1Click:Connect(function()
            local enabled = callback()
            styleEspToggle(button, stroke, enabled, text)
            for player, data in pairs(espObjects) do
                updateESPDisplay(player, data)
            end
        end)
        return button
    end

    addEspOption("ESP Highlights", espHighlightsEnabled, function()
        espHighlightsEnabled = not espHighlightsEnabled
        return espHighlightsEnabled
    end)
    addEspOption("ESP Names", espNamesEnabled, function()
        espNamesEnabled = not espNamesEnabled
        return espNamesEnabled
    end)
    addEspOption("ESP Health", espHealthEnabled, function()
        espHealthEnabled = not espHealthEnabled
        return espHealthEnabled
    end)
    addEspOption("ESP Distance", espDistanceEnabled, function()
        espDistanceEnabled = not espDistanceEnabled
        return espDistanceEnabled
    end)

    local rangeRow = Instance.new("Frame")
    rangeRow.Size = UDim2.new(1, -6, 0, 34)
    rangeRow.BackgroundTransparency = 1
    rangeRow.Parent = mainScroll
    local rangeInput = Instance.new("TextBox")
    rangeInput.Size = UDim2.new(0.58, -4, 1, 0)
    rangeInput.BackgroundColor3 = Color3.fromRGB(24, 28, 40)
    rangeInput.TextColor3 = Color3.fromRGB(255, 255, 255)
    rangeInput.PlaceholderColor3 = Color3.fromRGB(145, 155, 175)
    rangeInput.PlaceholderText = "Max range (0 = unlimited)"
    rangeInput.Text = tostring(espMaxDistance)
    rangeInput.ClearTextOnFocus = false
    rangeInput.Font = Enum.Font.Gotham
    rangeInput.TextSize = 11
    rangeInput.BorderSizePixel = 0
    rangeInput.Parent = rangeRow
    Instance.new("UICorner", rangeInput).CornerRadius = UDim.new(0, 6)
    local applyRangeBtn = Instance.new("TextButton")
    applyRangeBtn.Size = UDim2.new(0.42, -2, 1, 0)
    applyRangeBtn.Position = UDim2.new(0.58, 4, 0, 0)
    applyRangeBtn.BackgroundColor3 = Color3.fromRGB(35, 75, 130)
    applyRangeBtn.TextColor3 = Color3.new(1, 1, 1)
    applyRangeBtn.Text = "Apply Range"
    applyRangeBtn.Font = Enum.Font.GothamBold
    applyRangeBtn.TextSize = 11
    applyRangeBtn.BorderSizePixel = 0
    applyRangeBtn.Parent = rangeRow
    Instance.new("UICorner", applyRangeBtn).CornerRadius = UDim.new(0, 6)
    local rangeStatus = Instance.new("TextLabel")
    rangeStatus.Size = UDim2.new(1, -6, 0, 18)
    rangeStatus.BackgroundTransparency = 1
    rangeStatus.Text = "Range: 500 studs"
    rangeStatus.TextColor3 = Color3.fromRGB(145, 165, 185)
    rangeStatus.Font = Enum.Font.Gotham
    rangeStatus.TextSize = 10
    rangeStatus.TextXAlignment = Enum.TextXAlignment.Left
    rangeStatus.Parent = mainScroll
    applyRangeBtn.MouseButton1Click:Connect(function()
        local value = tonumber(rangeInput.Text)
        if not value or value < 0 or value > 100000 then
            rangeStatus.Text = "Enter a number from 0 to 100000"
            rangeStatus.TextColor3 = Color3.fromRGB(255, 110, 110)
            return
        end
        espMaxDistance = math.floor(value)
        rangeStatus.Text = espMaxDistance == 0 and "Range: Unlimited" or ("Range: " .. espMaxDistance .. " studs")
        rangeStatus.TextColor3 = Color3.fromRGB(145, 165, 185)
    end)

    local function connectPlayer(player)
        if player == LocalPlayer then return end
        addConnection(player.CharacterAdded:Connect(function(character)
            task.spawn(function()
                local root = character:WaitForChild("HumanoidRootPart", 8)
                local humanoid = character:WaitForChild("Humanoid", 8)
                if root and humanoid and player.Parent and (espEnabled or friendESPFlags[player]) then
                    createESP(player)
                end
            end)
        end))
        addConnection(player.CharacterRemoving:Connect(function()
            removeESP(player)
        end))
        if player.Character and (espEnabled or friendESPFlags[player]) then
            task.spawn(function() createESP(player) end)
        end
    end

    addConnection(Players.PlayerRemoving:Connect(function(player)
        removeESP(player)
        friendESPFlags[player] = nil
    end))
    for _, player in ipairs(Players:GetPlayers()) do connectPlayer(player) end
    addConnection(Players.PlayerAdded:Connect(connectPlayer))

    local espLoopActive = true
    cleanupPlayerESP = function()
        espLoopActive = false
        for player in pairs(espObjects) do removeESP(player) end
        table.clear(friendESPFlags)
    end
    task.spawn(function()
        while espLoopActive and gui and gui.Parent do
            for player, data in pairs(espObjects) do
                if player.Parent then
                    updateESPDisplay(player, data)
                else
                    removeESP(player)
                end
            end
            task.wait(ESP_UPDATE_INTERVAL)
        end
    end)

    -- 3. Movement (Fly & Noclip)
    local flying = false
    local flySpeed = 50
    local flyFastSpeed = 100
    local FLY_ANIMATION_IDS = {
        Idle = 84018906210574, -- standing still / idle
        Move = 70647881989417, -- normal movement / walk
        Fast = 121381683064391 -- fast movement / run
    }
    local bodyGyro, bodyVelocity
    local flyHumanoid = nil
    local flyOriginalPlatformStand = nil
    local flyTracks = {}
    local currentFlyState = nil
    local flyBtn, flyStroke = createContentButton(mainScroll, "Fly: OFF [F]", UDim2.new(1, -6, 0, 38), UDim2.new(), Color3.fromRGB(28, 33, 46))
    local flyAnimStatus = Instance.new("TextLabel")
    flyAnimStatus.Size = UDim2.new(1, -8, 0, 22)
    flyAnimStatus.BackgroundTransparency = 1
    flyAnimStatus.Text = "Fly animations: custom Idle / Walk / Run IDs"
    flyAnimStatus.TextColor3 = Color3.fromRGB(150, 180, 205)
    flyAnimStatus.Font = Enum.Font.Gotham
    flyAnimStatus.TextSize = 10
    flyAnimStatus.TextXAlignment = Enum.TextXAlignment.Left
    flyAnimStatus.Parent = mainScroll

    -- Use the three animation asset IDs supplied directly by the user.
    local function resolveFlyAnimations()
        return FLY_ANIMATION_IDS
    end

    local function stopFlyAnimations()
        for _, track in pairs(flyTracks) do
            pcall(function() track:Stop(0.15) end)
        end
        table.clear(flyTracks)
        currentFlyState = nil
    end

    local function loadFlyAnimations(humanoid)
        stopFlyAnimations()
        local ids, err = resolveFlyAnimations()
        if not ids then
            flyAnimStatus.Text = "Fly animations unavailable: " .. tostring(err)
            return false
        end

        local animator = humanoid:FindFirstChildOfClass("Animator")
        if not animator then
            animator = Instance.new("Animator")
            animator.Parent = humanoid
        end

        for state, assetId in pairs(ids) do
            local animation = Instance.new("Animation")
            animation.Name = "UnionFly" .. state
            animation.AnimationId = "rbxassetid://" .. tostring(assetId)
            local ok, track = pcall(function()
                return animator:LoadAnimation(animation)
            end)
            if ok and track then
                track.Looped = true
                track.Priority = Enum.AnimationPriority.Action
                flyTracks[state] = track
            end
            animation:Destroy()
        end

        if flyTracks.Idle and flyTracks.Move and flyTracks.Fast then
            flyAnimStatus.Text = "Fly animations loaded: custom Idle / Walk / Run"
            return true
        end
        stopFlyAnimations()
        flyAnimStatus.Text = "Fly animations failed to load (check rig/asset permissions)"
        return false
    end

    local function playFlyState(state)
        if currentFlyState == state then return end
        local nextTrack = flyTracks[state]
        if not nextTrack then return end
        for name, track in pairs(flyTracks) do
            if name ~= state and track.IsPlaying then
                track:Stop(0.15)
            end
        end
        if not nextTrack.IsPlaying then
            nextTrack:Play(0.15, 1, 1)
        end
        currentFlyState = state
    end

    local function toggleFly()
        local char = LocalPlayer.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not root or not hum then return end

        flying = not flying
        if flying then
            flyHumanoid = hum
            flyOriginalPlatformStand = hum.PlatformStand
            loadFlyAnimations(hum)
            hum.PlatformStand = true
            bodyGyro = Instance.new("BodyGyro")
            bodyGyro.Parent = root
            bodyGyro.P = 9e4
            bodyGyro.maxTorque = Vector3.new(9e9, 9e9, 9e9)
            bodyGyro.cframe = root.CFrame

            bodyVelocity = Instance.new("BodyVelocity")
            bodyVelocity.Parent = root
            bodyVelocity.velocity = Vector3.new(0, 0.1, 0)
            bodyVelocity.maxForce = Vector3.new(9e9, 9e9, 9e9)

            task.spawn(function()
                while flying and char and char.Parent and root and root.Parent do
                    local camera = Workspace.CurrentCamera
                    local moveDir = Vector3.new()
                    if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + camera.CFrame.LookVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - camera.CFrame.LookVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - camera.CFrame.RightVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + camera.CFrame.RightVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
                    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir = moveDir - Vector3.new(0, 1, 0) end

                    local isMoving = moveDir.Magnitude > 0.05
                    local isFast = isMoving and UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
                    local speed = isFast and flyFastSpeed or flySpeed
                    bodyGyro.cframe = camera.CFrame
                    bodyVelocity.velocity = moveDir.Magnitude > 0 and moveDir.Unit * speed or Vector3.zero

                    if isFast then
                        playFlyState("Fast")
                    elseif isMoving then
                        playFlyState("Move")
                    else
                        playFlyState("Idle")
                    end
                    RunService.RenderStepped:Wait()
                end
            end)
            flyBtn.Text = "Fly: ON [F] | Ctrl: FAST"
            TweenService:Create(flyBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(35, 140, 85)}):Play()
            TweenService:Create(flyStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(60, 200, 120)}):Play()
        else
            local restoreHumanoid = flyHumanoid or hum
            if restoreHumanoid and restoreHumanoid.Parent then
                restoreHumanoid.PlatformStand = flyOriginalPlatformStand == true
            end
            flyHumanoid = nil
            flyOriginalPlatformStand = nil
            if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
            if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
            stopFlyAnimations()
            flyBtn.Text = "Fly: OFF [F]"
            TweenService:Create(flyBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(28, 33, 46)}):Play()
            TweenService:Create(flyStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(45, 55, 80)}):Play()
        end
    end
    flyBtn.MouseButton1Click:Connect(toggleFly)

    local noclip = false
    local noclipConn
    local noclipOriginalCollision = {}
    local noclipCharacter = nil

    local function restoreNoclipCollision()
        for part, originalValue in pairs(noclipOriginalCollision) do
            if part and part.Parent then
                pcall(function() part.CanCollide = originalValue end)
            end
        end
        table.clear(noclipOriginalCollision)
        noclipCharacter = nil
    end
    local noclipBtn, noclipStroke = createContentButton(mainScroll, "Noclip: OFF [N]", UDim2.new(1, -6, 0, 38), UDim2.new(), Color3.fromRGB(28, 33, 46))

    local function toggleNoclip()
        noclip = not noclip
        if noclip then
            noclipBtn.Text = "Noclip: ON [N]"
            TweenService:Create(noclipBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(35, 140, 85)}):Play()
            TweenService:Create(noclipStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(60, 200, 120)}):Play()
            noclipConn = addConnection(RunService.Stepped:Connect(function()
                if not noclip then return end
                local character = LocalPlayer.Character
                if not character then return end
                if noclipCharacter ~= character then
                    restoreNoclipCollision()
                    noclipCharacter = character
                end
                for _, part in ipairs(character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        if noclipOriginalCollision[part] == nil then
                            noclipOriginalCollision[part] = part.CanCollide
                        end
                        part.CanCollide = false
                    end
                end
            end))
        else
            noclipBtn.Text = "Noclip: OFF [N]"
            TweenService:Create(noclipBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(28, 33, 46)}):Play()
            TweenService:Create(noclipStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(45, 55, 80)}):Play()
            if noclipConn then noclipConn:Disconnect() noclipConn = nil end
            restoreNoclipCollision()
        end
    end
    noclipBtn.MouseButton1Click:Connect(toggleNoclip)

    addConnection(UserInputService.InputBegan:Connect(function(input, processed)
        if processed or UserInputService:GetFocusedTextBox() then return end
        if input.KeyCode == Enum.KeyCode.F then toggleFly()
        elseif input.KeyCode == Enum.KeyCode.N then toggleNoclip() end
    end))

    -- 4. Emotes Hub
    local emotesLoaded = false
    local loadEmotesBtn = createContentButton(mainScroll, "Load Emote Hub", UDim2.new(1, -6, 0, 38), UDim2.new(), Color3.fromRGB(35, 75, 130))
    loadEmotesBtn.MouseButton1Click:Connect(function()
        if not emotesLoaded then
            emotesLoaded = true
            loadEmotesBtn.Text = "Emote Hub Loaded ✓"
            task.spawn(function()
                pcall(function()
                    loadstring(game:HttpGet("https://raw.githubusercontent.com/7yd7/Hub/refs/heads/Branch/GUIS/Emotes.lua"))()
                end)
            end)
        end
    end)


    -- 5. Anti-Fling (client-side movement protection)
    local antiFlingEnabled = false
    local antiFlingThreshold = 120 -- studs/second; lower values may interfere with fast movement
    local antiFlingConn
    local antiFlingBtn, antiFlingStroke = createContentButton(
        mainScroll, "Anti-Fling: OFF", UDim2.new(1, -6, 0, 38), UDim2.new(), Color3.fromRGB(28, 33, 46)
    )

    local function setToggleStyle(button, stroke, enabled, label)
        button.Text = label .. (enabled and ": ON" or ": OFF")
        local bg = enabled and Color3.fromRGB(35, 140, 85) or Color3.fromRGB(28, 33, 46)
        local outline = enabled and Color3.fromRGB(60, 200, 120) or Color3.fromRGB(45, 55, 80)
        TweenService:Create(button, TweenInfo.new(0.2), {BackgroundColor3 = bg}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.2), {Color = outline}):Play()
    end

    local function toggleAntiFling()
        antiFlingEnabled = not antiFlingEnabled
        if antiFlingEnabled then
            antiFlingConn = addConnection(RunService.Heartbeat:Connect(function()
                local character = LocalPlayer.Character
                local root = character and character:FindFirstChild("HumanoidRootPart")
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                if not root or not humanoid or humanoid.Health <= 0 then return end

                local velocity = root.AssemblyLinearVelocity
                if velocity.Magnitude > antiFlingThreshold then
                    -- Reduce extreme linear impulses and stop rapid spin without anchoring the character.
                    local horizontal = Vector3.new(velocity.X, 0, velocity.Z) * 0.15
                    local vertical = math.clamp(velocity.Y, -45, 45)
                    root.AssemblyLinearVelocity = Vector3.new(horizontal.X, vertical, horizontal.Z)
                    root.AssemblyAngularVelocity = Vector3.zero
                end
            end))
        elseif antiFlingConn then
            antiFlingConn:Disconnect()
            antiFlingConn = nil
        end
        setToggleStyle(antiFlingBtn, antiFlingStroke, antiFlingEnabled, "Anti-Fling")
    end
    antiFlingBtn.MouseButton1Click:Connect(toggleAntiFling)

    -- 6. Anti-AFK (uses Roblox's idle event; does not continuously spam input)
    local antiAFKEnabled = false
    local antiAFKConn
    local antiAFKBtn, antiAFKStroke = createContentButton(
        mainScroll, "Anti-AFK: OFF", UDim2.new(1, -6, 0, 38), UDim2.new(), Color3.fromRGB(28, 33, 46)
    )

    local function toggleAntiAFK()
        antiAFKEnabled = not antiAFKEnabled
        if antiAFKEnabled then
            antiAFKConn = addConnection(LocalPlayer.Idled:Connect(function()
                if not antiAFKEnabled then return end
                pcall(function()
                    VirtualUser:CaptureController()
                    VirtualUser:ClickButton2(Vector2.new(0, 0))
                end)
            end))
        elseif antiAFKConn then
            antiAFKConn:Disconnect()
            antiAFKConn = nil
        end
        setToggleStyle(antiAFKBtn, antiAFKStroke, antiAFKEnabled, "Anti-AFK")
    end
    antiAFKBtn.MouseButton1Click:Connect(toggleAntiAFK)

    addConnection(LocalPlayer.CharacterAdded:Connect(function()
        if flying then
            flying = false
            if flyHumanoid and flyHumanoid.Parent then
                pcall(function() flyHumanoid.PlatformStand = flyOriginalPlatformStand == true end)
            end
            flyHumanoid = nil
            flyOriginalPlatformStand = nil
            if bodyGyro then pcall(function() bodyGyro:Destroy() end) bodyGyro = nil end
            if bodyVelocity then pcall(function() bodyVelocity:Destroy() end) bodyVelocity = nil end
            stopFlyAnimations()
            if flyBtn and flyBtn.Parent then flyBtn.Text = "Fly: OFF [F]" end
        end
        if noclip then
            noclip = false
            disconnectConnection(noclipConn)
            noclipConn = nil
            restoreNoclipCollision()
            if noclipBtn and noclipBtn.Parent then noclipBtn.Text = "Noclip: OFF [N]" end
        end
    end))

    registerCleanup(function()
        if flying then
            flying = false
            local restoreHumanoid = flyHumanoid or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid"))
            if restoreHumanoid and restoreHumanoid.Parent then
                pcall(function() restoreHumanoid.PlatformStand = flyOriginalPlatformStand == true end)
            end
        end
        flyHumanoid = nil
        flyOriginalPlatformStand = nil
        if bodyGyro then pcall(function() bodyGyro:Destroy() end) bodyGyro = nil end
        if bodyVelocity then pcall(function() bodyVelocity:Destroy() end) bodyVelocity = nil end
        stopFlyAnimations()
        noclip = false
        disconnectConnection(noclipConn)
        noclipConn = nil
        restoreNoclipCollision()
        antiFlingEnabled = false
        disconnectConnection(antiFlingConn)
        antiFlingConn = nil
        antiAFKEnabled = false
        disconnectConnection(antiAFKConn)
        antiAFKConn = nil
        if brightEnabled then
            brightEnabled = false
            for prop, value in pairs(originalLighting) do
                pcall(function() Lighting[prop] = value end)
            end
        end
    end)
end

--========================================================
-- MODULE 2: FRIENDS TAB
--========================================================
do
    local friendEspEnabled = true
    local friendEspObjects = {}
    local selectedFriend = nil
    local friendSpectating = false

    local headerStatus = Instance.new("TextLabel")
    headerStatus.Size = UDim2.new(1, 0, 0, 24)
    headerStatus.Position = UDim2.fromOffset(0, 4)
    headerStatus.BackgroundTransparency = 1
    headerStatus.Text = "Friends in Server: 0"
    headerStatus.TextColor3 = Color3.fromRGB(0, 220, 255)
    headerStatus.Font = Enum.Font.GothamBold
    headerStatus.TextSize = 13
    headerStatus.Parent = friendsTab

    local toggleFriendEspBtn, friendEspStroke = createContentButton(friendsTab, "Friend ESP: ON [Q]", UDim2.new(1, 0, 0, 34), UDim2.fromOffset(0, 32), Color3.fromRGB(35, 140, 85))
    TweenService:Create(friendEspStroke, TweenInfo.new(0.01), {Color = Color3.fromRGB(60, 200, 120)}):Play()

    local friendListFrame = Instance.new("ScrollingFrame")
    friendListFrame.Size = UDim2.new(1, 0, 1, -118)
    friendListFrame.Position = UDim2.fromOffset(0, 72)
    friendListFrame.BackgroundColor3 = Color3.fromRGB(16, 20, 28)
    friendListFrame.BorderSizePixel = 0
    friendListFrame.ScrollBarThickness = 4
    friendListFrame.CanvasSize = UDim2.new()
    friendListFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
    friendListFrame.Parent = friendsTab
    Instance.new("UICorner", friendListFrame).CornerRadius = UDim.new(0, 6)
    local friendListLayout = Instance.new("UIListLayout", friendListFrame)
    friendListLayout.Padding = UDim.new(0, 4)

    local specFriendBtn = createContentButton(friendsTab, "Spectate Friend", UDim2.new(0.5, -3, 0, 36), UDim2.new(0, 0, 1, -38), Color3.fromRGB(28, 33, 46))
    local tpFriendBtn = createContentButton(friendsTab, "Teleport to Friend", UDim2.new(0.5, -3, 0, 36), UDim2.new(0.5, 3, 1, -38), Color3.fromRGB(35, 75, 130))

    local function removeFriendESP(player)
        friendEspObjects[player] = nil
        if playerESPManager.SetFriend then
            playerESPManager.SetFriend(player, false)
        end
    end

    local function createFriendESP(player)
        if not friendEspEnabled then
            removeFriendESP(player)
            return
        end
        friendEspObjects[player] = true
        if playerESPManager.SetFriend then
            playerESPManager.SetFriend(player, true)
        end
    end

    local function playFriendJoinSound()
        local joinSound = Instance.new("Sound")
        joinSound.SoundId = "rbxassetid://4590662766"
        joinSound.Volume = 1
        joinSound.Parent = SoundService
        joinSound:Play()
        task.delay(3, function() joinSound:Destroy() end)
    end

    local function notifyFriendJoin(player)
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "⭐ Friend Joined!",
                Text = player.DisplayName .. " (@" .. player.Name .. ") joined the game.",
                Duration = 5,
            })
        end)
        playFriendJoinSound()
    end

    local function refreshFriendsList()
        for _, child in ipairs(friendListFrame:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end

        local count = 0
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local isFriend = false
                pcall(function()
                    isFriend = p:IsFriendsWith(LocalPlayer.UserId)
                end)

                if isFriend then
                    count = count + 1
                    if friendEspEnabled then
                        createFriendESP(p)
                    else
                        removeFriendESP(p)
                    end

                    local btn = createContentButton(friendListFrame, "⭐ " .. p.DisplayName .. " (@" .. p.Name .. ")", UDim2.new(1, -6, 0, 32), UDim2.new(), Color3.fromRGB(24, 29, 42))
                    if selectedFriend == p then
                        btn.BackgroundColor3 = Color3.fromRGB(0, 120, 200)
                    end
                    btn.MouseButton1Click:Connect(function()
                        selectedFriend = p
                        headerStatus.Text = "Selected Friend: " .. p.Name
                        refreshFriendsList()
                    end)
                else
                    removeFriendESP(p)
                end
            end
        end

        badgeText.Text = tostring(count)
        headerStatus.Text = "Friends in Server: " .. count
    end

    toggleFriendESP = function()
        friendEspEnabled = not friendEspEnabled
        if friendEspEnabled then
            toggleFriendEspBtn.Text = "Friend ESP: ON [Q]"
            TweenService:Create(toggleFriendEspBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(35, 140, 85)}):Play()
            TweenService:Create(friendEspStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(60, 200, 120)}):Play()
        else
            toggleFriendEspBtn.Text = "Friend ESP: OFF [Q]"
            TweenService:Create(toggleFriendEspBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(28, 33, 46)}):Play()
            TweenService:Create(friendEspStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(45, 55, 80)}):Play()
            for p, _ in pairs(friendEspObjects) do
                removeFriendESP(p)
            end
        end
        refreshFriendsList()
    end

    toggleFriendEspBtn.MouseButton1Click:Connect(toggleFriendESP)

    specFriendBtn.MouseButton1Click:Connect(function()
        local camera = Workspace.CurrentCamera
        if not friendSpectating then
            if selectedFriend and selectedFriend.Character and selectedFriend.Character:FindFirstChildOfClass("Humanoid") then
                camera.CameraSubject = selectedFriend.Character:FindFirstChildOfClass("Humanoid")
                friendSpectating = true
                specFriendBtn.Text = "Stop Spectating"
                headerStatus.Text = "Watching Friend: " .. selectedFriend.Name
            else
                headerStatus.Text = "Select a valid friend first!"
            end
        else
            friendSpectating = false
            specFriendBtn.Text = "Spectate Friend"
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
                camera.CameraSubject = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            end
            headerStatus.Text = "Spectating stopped"
        end
    end)

    tpFriendBtn.MouseButton1Click:Connect(function()
        if selectedFriend and selectedFriend.Character then
            local targetRoot = selectedFriend.Character:FindFirstChild("HumanoidRootPart")
            local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if targetRoot and localRoot then
                localRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3)
                headerStatus.Text = "Teleported to " .. selectedFriend.Name
            else
                headerStatus.Text = "Friend position unavailable!"
            end
        else
            headerStatus.Text = "Select a friend to teleport!"
        end
    end)

    addConnection(Players.PlayerAdded:Connect(function(p)
        local isFriend = false
        pcall(function()
            isFriend = p:IsFriendsWith(LocalPlayer.UserId)
        end)
        if isFriend then
            notifyFriendJoin(p)
        end
        refreshFriendsList()
    end))

    addConnection(Players.PlayerRemoving:Connect(function(p)
        if p == selectedFriend then
            selectedFriend = nil
            if friendSpectating then
                friendSpectating = false
                local camera = Workspace.CurrentCamera
                local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                if camera and humanoid then pcall(function() camera.CameraSubject = humanoid end) end
                specFriendBtn.Text = "Spectate Friend"
            end
        end
        removeFriendESP(p)
        refreshFriendsList()
    end))

    task.spawn(function()
        while gui and gui.Parent do
            refreshFriendsList()
            task.wait(5)
        end
    end)
    registerCleanup(function()
        friendSpectating = false
        selectedFriend = nil
        for player in pairs(friendEspObjects) do
            if playerESPManager.SetFriend then pcall(playerESPManager.SetFriend, player, false) end
        end
        table.clear(friendEspObjects)
        local camera = Workspace.CurrentCamera
        local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if camera and humanoid then pcall(function() camera.CameraSubject = humanoid end) end
    end)
end

--========================================================
-- MODULE 2.5: SERVERS TAB (PAGINATED SERVER BROWSER)
-- Preserves the existing tab style while adding safer paging,
-- filtering, sorting, friend-cache handling, and teleport recovery.
--========================================================
do
    local serverHeaderStatus = Instance.new("TextLabel")
    serverHeaderStatus.Size = UDim2.new(1, -190, 0, 24)
    serverHeaderStatus.Position = UDim2.fromOffset(0, 4)
    serverHeaderStatus.BackgroundTransparency = 1
    serverHeaderStatus.Text = "Public Server Browser"
    serverHeaderStatus.TextColor3 = Color3.fromRGB(0, 220, 255)
    serverHeaderStatus.Font = Enum.Font.GothamBold
    serverHeaderStatus.TextSize = 13
    serverHeaderStatus.TextXAlignment = Enum.TextXAlignment.Left
    serverHeaderStatus.TextTruncate = Enum.TextTruncate.AtEnd
    serverHeaderStatus.Parent = serversTab

    local refreshServersBtn = createContentButton(serversTab, "🔄 Refresh", UDim2.fromOffset(90, 26), UDim2.new(1, -90, 0, 3), Color3.fromRGB(35, 75, 130))

    -- Compact additive controls; existing colors and overall tab dimensions remain intact.
    local serverSearchBox = Instance.new("TextBox")
    serverSearchBox.Size = UDim2.new(1, -190, 0, 25)
    serverSearchBox.Position = UDim2.fromOffset(0, 35)
    serverSearchBox.BackgroundColor3 = Color3.fromRGB(18, 22, 32)
    serverSearchBox.TextColor3 = Color3.fromRGB(235, 240, 250)
    serverSearchBox.PlaceholderColor3 = Color3.fromRGB(135, 145, 160)
    serverSearchBox.PlaceholderText = "Filter by server ID..."
    serverSearchBox.Text = ""
    serverSearchBox.ClearTextOnFocus = false
    serverSearchBox.Font = Enum.Font.Gotham
    serverSearchBox.TextSize = 10
    serverSearchBox.BorderSizePixel = 0
    serverSearchBox.Parent = serversTab
    Instance.new("UICorner", serverSearchBox).CornerRadius = UDim.new(0, 5)

    local sortServersBtn = createContentButton(serversTab, "Sort: Players ↓", UDim2.fromOffset(112, 25), UDim2.new(1, -112, 0, 35), Color3.fromRGB(35, 75, 130))
    local friendsOnlyBtn = createContentButton(serversTab, "Friends: All", UDim2.fromOffset(112, 25), UDim2.new(1, -112, 0, 64), Color3.fromRGB(35, 75, 130))
    local populationFilterBtn = createContentButton(serversTab, "Slots: Any", UDim2.fromOffset(112, 25), UDim2.fromOffset(0, 64), Color3.fromRGB(35, 75, 130))

    local serverListFrame = Instance.new("ScrollingFrame")
    serverListFrame.Size = UDim2.new(1, 0, 1, -100)
    serverListFrame.Position = UDim2.fromOffset(0, 94)
    serverListFrame.BackgroundColor3 = Color3.fromRGB(16, 20, 28)
    serverListFrame.BorderSizePixel = 0
    serverListFrame.ScrollBarThickness = 4
    serverListFrame.CanvasSize = UDim2.new()
    serverListFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
    serverListFrame.Parent = serversTab
    Instance.new("UICorner", serverListFrame).CornerRadius = UDim.new(0, 6)

    local serverListLayout = Instance.new("UIListLayout", serverListFrame)
    serverListLayout.Padding = UDim.new(0, 6)
    serverListLayout.SortOrder = Enum.SortOrder.LayoutOrder

    local friendIds = {}
    local friendsCacheReady = false
    local friendsCacheError = nil
    local serverRecords = {}
    local seenServerIds = {}
    local nextServerCursor = nil
    local isFetchingServers = false
    local fetchGeneration = 0
    local hasMoreServers = false
    local sortMode = 1
    local friendsOnly = false
    local populationMode = 1
    local friendsCacheLoading = false
    local activeJoinButtons = {}
    local renderServerRows
    local updateFriendBadge

    local function cacheFriends()
        if friendsCacheLoading then
            while friendsCacheLoading do task.wait(0.1) end
            return friendsCacheReady and friendsCacheError == nil
        end
        friendsCacheLoading = true
        local freshIds = {}
        local cacheComplete = false
        local ok, err = pcall(function()
            local pages = Players:GetFriendsAsync(LocalPlayer.UserId)
            local pageCount = 0
            while pages and pageCount < 20 do
                pageCount = pageCount + 1
                for _, item in ipairs(pages:GetCurrentPage()) do
                    local id = tonumber(item.Id)
                    if id then freshIds[id] = true end
                end
                if pages.IsFinished then
                    cacheComplete = true
                    break
                end
                pages:AdvanceToNextPageAsync()
            end
            if pages and pages.IsFinished then cacheComplete = true end
        end)
        if ok then
            friendIds = freshIds
            if cacheComplete then
                friendsCacheError = nil
            else
                friendsCacheError = "Friend list may be incomplete (page limit reached)"
            end
            for _, record in ipairs(serverRecords) do
                local count = 0
                if type(record.data.players) == "table" then
                    for _, playerData in ipairs(record.data.players) do
                        local playerId = tonumber(playerData.id)
                        if playerId and friendIds[playerId] then count = count + 1 end
                    end
                end
                record.friendCount = count
            end
        else
            -- Keep the last known-good friend IDs if refresh fails.
            friendsCacheError = tostring(err)
        end
        friendsCacheReady = true
        friendsCacheLoading = false
        if ok and not shuttingDown and gui and gui.Parent and #serverRecords > 0 and renderServerRows then
            pcall(renderServerRows)
            pcall(updateFriendBadge)
        end
        return ok
    end

    local function requestServerPage(url)
        local lastError = "Request failed"
        for attempt = 1, 3 do
            local response, transportError = httpRequest({Url = url, Method = "GET"})
            if response and type(response.Body) == "string" then
                local statusCode = tonumber(response.StatusCode or response.Status or 200)
                local successStatus = response.Success
                if statusCode and statusCode >= 200 and statusCode < 300 and successStatus ~= false then
                    local decodeOk, decoded = pcall(function()
                        return HttpService:JSONDecode(response.Body)
                    end)
                    if decodeOk and type(decoded) == "table" and type(decoded.data) == "table" then
                        return decoded
                    end
                    lastError = "Invalid server response"
                else
                    lastError = "HTTP " .. tostring(statusCode or "error")
                end
            else
                lastError = transportError or "No response from server API"
            end
            if attempt < 3 then task.wait(0.5 * (2 ^ (attempt - 1))) end
        end
        return nil, lastError
    end

    local function clearRenderedServerRows()
        for _, child in ipairs(serverListFrame:GetChildren()) do
            if child:IsA("Frame") or child.Name == "LoadMoreServers" or child.Name == "ServerEmptyState" then
                child:Destroy()
            end
        end
    end

    local function getFilteredSortedServers()
        local result = {}
        local query = string.lower(serverSearchBox.Text or "")
        for _, record in ipairs(serverRecords) do
            local server = record.data
            local id = tostring(server.id or "")
            local matchesQuery = query == "" or string.find(string.lower(id), query, 1, true) ~= nil
            local matchesFriends = not friendsOnly or record.friendCount > 0
            local playing = tonumber(server.playing) or 0
            local capacity = tonumber(server.maxPlayers) or 0
            local matchesPopulation = populationMode == 1
                or (populationMode == 2 and capacity > playing)
                or (populationMode == 3 and capacity > 0 and playing >= capacity)
                or (populationMode == 4 and capacity > 0 and playing >= math.ceil(capacity * 0.8) and playing < capacity)
            if matchesQuery and matchesFriends and matchesPopulation then
                table.insert(result, record)
            end
        end
        table.sort(result, function(a, b)
            local aPlayers = tonumber(a.data.playing) or 0
            local bPlayers = tonumber(b.data.playing) or 0
            if sortMode == 2 then
                if a.friendCount ~= b.friendCount then return a.friendCount > b.friendCount end
                if aPlayers ~= bPlayers then return aPlayers > bPlayers end
            elseif sortMode == 3 then
                if aPlayers ~= bPlayers then return aPlayers < bPlayers end
            else
                if aPlayers ~= bPlayers then return aPlayers > bPlayers end
            end
            return tostring(a.data.id) < tostring(b.data.id)
        end)
        return result
    end

    updateFriendBadge = function()
        local total = 0
        for _, record in ipairs(serverRecords) do total = total + (record.friendCount or 0) end
        if total > 0 then
            serverBadgeText.Text = tostring(total)
            serverBadgeFrame.Visible = true
        else
            serverBadgeFrame.Visible = false
        end
    end

    local fetchServers

    renderServerRows = function()
        clearRenderedServerRows()
        local visibleRecords = getFilteredSortedServers()
        local rowIndex = 0

        for _, record in ipairs(visibleRecords) do
            rowIndex = rowIndex + 1
            local serverData = record.data
            local friendsInThisServer = record.friendCount or 0
            local serverFrame = Instance.new("Frame")
            serverFrame.Name = "ServerRow"
            serverFrame.LayoutOrder = rowIndex
            serverFrame.Size = UDim2.new(1, -6, 0, 44)
            serverFrame.BackgroundColor3 = Color3.fromRGB(24, 29, 42)
            serverFrame.BorderSizePixel = 0
            serverFrame.Parent = serverListFrame
            Instance.new("UICorner", serverFrame).CornerRadius = UDim.new(0, 6)
            local sfStroke = Instance.new("UIStroke", serverFrame)
            sfStroke.Color = Color3.fromRGB(40, 50, 70)
            sfStroke.Thickness = 1

            local infoLabel = Instance.new("TextLabel")
            infoLabel.Size = UDim2.new(1, -125, 1, 0)
            infoLabel.Position = UDim2.fromOffset(9, 0)
            infoLabel.BackgroundTransparency = 1
            infoLabel.Text = "#" .. tostring(rowIndex) .. "  |  " .. tostring(serverData.playing or "?") .. "/" .. tostring(serverData.maxPlayers or "?") .. " players  |  Ping unavailable"
            infoLabel.TextColor3 = Color3.fromRGB(220, 230, 245)
            infoLabel.Font = Enum.Font.GothamSemibold
            infoLabel.TextSize = 10
            infoLabel.TextXAlignment = Enum.TextXAlignment.Left
            infoLabel.TextTruncate = Enum.TextTruncate.AtEnd
            infoLabel.Parent = serverFrame

            if friendsInThisServer > 0 then
                local badge = Instance.new("TextLabel")
                badge.Size = UDim2.fromOffset(22, 20)
                badge.Position = UDim2.new(1, -116, 0.5, -10)
                badge.BackgroundColor3 = Color3.fromRGB(0, 150, 190)
                badge.Text = tostring(friendsInThisServer) .. "F"
                badge.TextColor3 = Color3.new(1, 1, 1)
                badge.Font = Enum.Font.GothamBold
                badge.TextSize = 9
                badge.BorderSizePixel = 0
                badge.Parent = serverFrame
                Instance.new("UICorner", badge).CornerRadius = UDim.new(0, 5)
            end

            local joinBtn = Instance.new("TextButton")
            joinBtn.Size = UDim2.fromOffset(78, 26)
            joinBtn.Position = UDim2.new(1, -86, 0.5, -13)
            local isCurrent = serverData.id == game.JobId
            joinBtn.BackgroundColor3 = isCurrent and Color3.fromRGB(40, 50, 65) or Color3.fromRGB(0, 150, 90)
            joinBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            joinBtn.Text = isCurrent and "Current" or "Join"
            joinBtn.Font = Enum.Font.GothamBold
            joinBtn.TextSize = 10
            joinBtn.BorderSizePixel = 0
            joinBtn.AutoButtonColor = not isCurrent
            joinBtn.Parent = serverFrame
            Instance.new("UICorner", joinBtn).CornerRadius = UDim.new(0, 5)

            if not isCurrent and type(serverData.id) == "string" and serverData.id ~= "" then
                joinBtn.MouseButton1Click:Connect(function()
                    if joinBtn:GetAttribute("Joining") then return end
                    joinBtn:SetAttribute("Joining", true)
                    joinBtn.Text = "Joining..."
                    activeJoinButtons[joinBtn] = true
                    local ok, err = pcall(function()
                        TeleportService:TeleportToPlaceInstance(game.PlaceId, serverData.id, LocalPlayer)
                    end)
                    if not ok then
                        joinBtn:SetAttribute("Joining", false)
                        joinBtn.Text = "Retry"
                        activeJoinButtons[joinBtn] = nil
                        serverHeaderStatus.Text = "Teleport failed: " .. string.sub(tostring(err), 1, 70)
                    else
                        task.delay(12, function()
                            if joinBtn and joinBtn.Parent and joinBtn:GetAttribute("Joining") then
                                joinBtn:SetAttribute("Joining", false)
                                joinBtn.Text = "Retry"
                                activeJoinButtons[joinBtn] = nil
                            end
                        end)
                    end
                end)
            end
        end

        if rowIndex == 0 then
            local empty = Instance.new("TextLabel")
            empty.Name = "ServerEmptyState"
            empty.LayoutOrder = 1
            empty.Size = UDim2.new(1, -8, 0, 36)
            empty.BackgroundTransparency = 1
            empty.Text = #serverRecords == 0 and "No server data loaded yet." or "No servers match these filters."
            empty.TextColor3 = Color3.fromRGB(150, 160, 175)
            empty.Font = Enum.Font.Gotham
            empty.TextSize = 11
            empty.Parent = serverListFrame
        end

        if hasMoreServers then
            local moreBtn = Instance.new("TextButton")
            moreBtn.Name = "LoadMoreServers"
            moreBtn.LayoutOrder = rowIndex + 1
            moreBtn.Size = UDim2.new(1, -8, 0, 30)
            moreBtn.BackgroundColor3 = Color3.fromRGB(35, 75, 130)
            moreBtn.Text = "Load More Servers"
            moreBtn.TextColor3 = Color3.new(1, 1, 1)
            moreBtn.Font = Enum.Font.GothamBold
            moreBtn.TextSize = 10
            moreBtn.BorderSizePixel = 0
            moreBtn.Parent = serverListFrame
            Instance.new("UICorner", moreBtn).CornerRadius = UDim.new(0, 5)
            moreBtn.MouseButton1Click:Connect(function()
                if not isFetchingServers then
                    moreBtn.Text = "Loading..."
                    fetchServers(true)
                end
            end)
        end
    end

    fetchServers = function(loadNextPage, forceRefresh)
        if isFetchingServers and not forceRefresh then return end
        if loadNextPage and not nextServerCursor then return end
        isFetchingServers = true
        fetchGeneration = fetchGeneration + 1
        local thisGeneration = fetchGeneration
        refreshServersBtn.Text = "Loading..."
        refreshServersBtn.Active = true
        serverHeaderStatus.Text = loadNextPage and "Loading next page..." or "Refreshing servers..."

        task.spawn(function()
            if not friendsCacheReady then
                cacheFriends()
            end
            if thisGeneration ~= fetchGeneration then return end

            local placeId = game.PlaceId
            local baseUrl = "https://games.roblox.com/v1/games/" .. tostring(placeId) .. "/servers/Public?limit=100&sortOrder=Desc"
            local url = baseUrl
            if loadNextPage and nextServerCursor then
                url = baseUrl .. "&cursor=" .. HttpService:UrlEncode(nextServerCursor)
            end

            local bodyData, requestError = requestServerPage(url)
            if thisGeneration ~= fetchGeneration then return end
            if not bodyData then
                if thisGeneration == fetchGeneration then
                    serverHeaderStatus.Text = "Load failed: " .. tostring(requestError) .. " (existing results kept)"
                    refreshServersBtn.Text = "🔄 Refresh"
                    refreshServersBtn.Active = true
                    isFetchingServers = false
                end
                return
            end

            if not loadNextPage then
                serverRecords = {}
                seenServerIds = {}
            end

            local added = 0
            for _, serverData in ipairs(bodyData.data) do
                if type(serverData) == "table" and type(serverData.id) == "string" and serverData.id ~= "" and not seenServerIds[serverData.id] then
                    seenServerIds[serverData.id] = true
                    local friendCount = 0
                    if type(serverData.players) == "table" then
                        for _, playerData in ipairs(serverData.players) do
                            local playerId = tonumber(playerData.id)
                            if playerId and friendIds[playerId] then friendCount = friendCount + 1 end
                        end
                    end
                    table.insert(serverRecords, {data = serverData, friendCount = friendCount})
                    added = added + 1
                end
            end

            nextServerCursor = bodyData.nextPageCursor
            hasMoreServers = type(nextServerCursor) == "string" and nextServerCursor ~= ""
            if thisGeneration ~= fetchGeneration then return end
            renderServerRows()
            updateFriendBadge()
            local friendNote = friendsCacheError and " · Friend detection incomplete/unavailable" or ""
            serverHeaderStatus.Text = "Loaded " .. tostring(#serverRecords) .. " servers" .. (hasMoreServers and " · More available" or " · End of list") .. friendNote
            refreshServersBtn.Text = "🔄 Refresh"
            refreshServersBtn.Active = true
            isFetchingServers = false
        end)
    end

    sortServersBtn.MouseButton1Click:Connect(function()
        sortMode = (sortMode % 3) + 1
        local labels = {"Sort: Players ↓", "Sort: Friends ↓", "Sort: Players ↑"}
        sortServersBtn.Text = labels[sortMode]
        renderServerRows()
    end)

    friendsOnlyBtn.MouseButton1Click:Connect(function()
        friendsOnly = not friendsOnly
        friendsOnlyBtn.Text = friendsOnly and "Friends: Only" or "Friends: All"
        friendsOnlyBtn.BackgroundColor3 = friendsOnly and Color3.fromRGB(0, 115, 145) or Color3.fromRGB(35, 75, 130)
        renderServerRows()
    end)

    populationFilterBtn.MouseButton1Click:Connect(function()
        populationMode = (populationMode % 4) + 1
        local labels = {"Slots: Any", "Slots: Open", "Slots: Full", "Slots: Nearly Full"}
        populationFilterBtn.Text = labels[populationMode]
        renderServerRows()
    end)

    serverSearchBox:GetPropertyChangedSignal("Text"):Connect(renderServerRows)
    refreshServersBtn.MouseButton1Click:Connect(function()
        fetchServers(false, true)
    end)

    addConnection(TeleportService.TeleportInitFailed:Connect(function(player, result, message)
        if player ~= LocalPlayer then return end
        for button in pairs(activeJoinButtons) do
            if button and button.Parent then
                button:SetAttribute("Joining", false)
                button.Text = "Retry"
            end
            activeJoinButtons[button] = nil
        end
        serverHeaderStatus.Text = "Teleport failed: " .. string.sub(tostring(message or result), 1, 75)
    end))

    task.spawn(cacheFriends)
    task.spawn(function()
        while gui and gui.Parent and not shuttingDown do
            task.wait(30)
            if gui and gui.Parent and not shuttingDown then task.spawn(cacheFriends) end
        end
    end)
    task.spawn(function() fetchServers(false) end)
    registerCleanup(function()
        fetchGeneration = fetchGeneration + 1
        isFetchingServers = false
        for button in pairs(activeJoinButtons) do
            if button and button.Parent then
                pcall(function() button:SetAttribute("Joining", false); button.Text = "Join" end)
            end
            activeJoinButtons[button] = nil
        end
    end)
end

--========================================================
-- MODULE 2.8: ADVANCED PLAYER SEARCH TAB & DETAIL INSPECTOR
-- Search logic hardened while preserving the existing Search tab layout and styling.
do
    local searchInput = Instance.new("TextBox")
    searchInput.Size = UDim2.new(1, -95, 0, 32)
    searchInput.Position = UDim2.fromOffset(0, 4)
    searchInput.BackgroundColor3 = Color3.fromRGB(18, 22, 32)
    searchInput.TextColor3 = Color3.fromRGB(255, 255, 255)
    searchInput.PlaceholderText = "Search by Username or Display Name..."
    searchInput.Text = ""
    searchInput.Font = Enum.Font.Gotham
    searchInput.TextSize = 12
    searchInput.BorderSizePixel = 0
    searchInput.Parent = searchTab
    Instance.new("UICorner", searchInput).CornerRadius = UDim.new(0, 6)

    local searchSubmitBtn = createContentButton(searchTab, "🔍 Search", UDim2.fromOffset(90, 32), UDim2.new(1, -90, 0, 4), Color3.fromRGB(0, 140, 200))

    local resultsContainer = Instance.new("Frame")
    resultsContainer.Size = UDim2.new(1, 0, 1, -42)
    resultsContainer.Position = UDim2.fromOffset(0, 42)
    resultsContainer.BackgroundTransparency = 1
    resultsContainer.Parent = searchTab

    local function createScrollingFrame(parent)
        local sf = Instance.new("ScrollingFrame")
        sf.Size = UDim2.new(1, 0, 1, 0)
        sf.BackgroundTransparency = 1
        sf.BorderSizePixel = 0
        sf.ScrollBarThickness = 4
        sf.AutomaticCanvasSize = Enum.AutomaticSize.Y
        sf.CanvasSize = UDim2.new()
        sf.Parent = parent
        Instance.new("UIListLayout", sf).Padding = UDim.new(0, 6)
        return sf
    end

    local searchScroll = createScrollingFrame(resultsContainer)
    local viewToken = 0
    local recentSearches = {}
    local MAX_RECENT_SEARCHES = 8

    local function beginView()
        viewToken = viewToken + 1
        return viewToken
    end

    local function isCurrentView(token)
        return token == viewToken and searchScroll and searchScroll.Parent ~= nil
    end

    local function resetSearchScroll()
        searchScroll:ClearAllChildren()
        local layout = Instance.new("UIListLayout")
        layout.Padding = UDim.new(0, 6)
        layout.Parent = searchScroll
    end

    local function setSearchMessage(message, color)
        resetSearchScroll()
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -6, 0, 36)
        label.BackgroundTransparency = 1
        label.Text = tostring(message)
        label.TextColor3 = color or Color3.fromRGB(0, 200, 255)
        label.Font = Enum.Font.GothamBold
        label.TextSize = 11
        label.TextWrapped = true
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = searchScroll
        return label
    end

    local function safeDecodeResponse(response)
        if not response or type(response.Body) ~= "string" or response.Body == "" then
            return nil, "Empty response"
        end
        if response.Success == false then
            return nil, "HTTP request failed"
        end
        if type(response.StatusCode) == "number" and (response.StatusCode < 200 or response.StatusCode >= 300) then
            return nil, "HTTP " .. tostring(response.StatusCode)
        end
        local ok, decoded = pcall(function()
            return HttpService:JSONDecode(response.Body)
        end)
        if not ok or type(decoded) ~= "table" then
            return nil, "Invalid JSON response"
        end
        return decoded
    end

    local function requestJson(method, url, body)
        local options = { Url = url, Method = method or "GET" }
        if body ~= nil then
            options.Headers = { ["Content-Type"] = "application/json" }
            options.Body = HttpService:JSONEncode(body)
        end
        local ok, response = pcall(function()
            return httpRequest(options)
        end)
        if not ok or not response then
            return nil, "Request unavailable"
        end
        return safeDecodeResponse(response)
    end

    local function encodeQuery(value)
        local ok, encoded = pcall(function()
            return HttpService:UrlEncode(value)
        end)
        if ok and type(encoded) == "string" then
            return encoded
        end
        return tostring(value):gsub("([^%w%-_%.~])", function(char)
            return string.format("%%%02X", string.byte(char))
        end)
    end

    local function formatCount(value)
        local number = tonumber(value)
        if not number then return "N/A" end
        if number >= 1000000 then
            return string.format("%.1fM", number / 1000000)
        elseif number >= 1000 then
            return string.format("%.1fK", number / 1000)
        end
        return tostring(math.floor(number))
    end

    local function addRecentSearch(query)
        for index = #recentSearches, 1, -1 do
            if recentSearches[index]:lower() == query:lower() then
                table.remove(recentSearches, index)
            end
        end
        table.insert(recentSearches, 1, query)
        while #recentSearches > MAX_RECENT_SEARCHES do
            table.remove(recentSearches)
        end
    end

    local executeSearch

    local function showRecentSearches()
        local token = beginView()
        resetSearchScroll()
        local header = Instance.new("TextLabel")
        header.Size = UDim2.new(1, -6, 0, 24)
        header.BackgroundTransparency = 1
        header.Text = "Recent Searches"
        header.TextColor3 = Color3.fromRGB(0, 200, 255)
        header.Font = Enum.Font.GothamBold
        header.TextSize = 11
        header.TextXAlignment = Enum.TextXAlignment.Left
        header.Parent = searchScroll

        if #recentSearches == 0 then
            local empty = Instance.new("TextLabel")
            empty.Size = UDim2.new(1, -6, 0, 28)
            empty.BackgroundTransparency = 1
            empty.Text = "Your recent searches will appear here."
            empty.TextColor3 = Color3.fromRGB(155, 165, 180)
            empty.Font = Enum.Font.Gotham
            empty.TextSize = 10
            empty.TextXAlignment = Enum.TextXAlignment.Left
            empty.Parent = searchScroll
            return
        end

        for _, recentQuery in ipairs(recentSearches) do
            local recentButton = createContentButton(searchScroll, "↻  " .. recentQuery, UDim2.new(1, -6, 0, 30), UDim2.new(), Color3.fromRGB(24, 29, 42))
            recentButton.TextXAlignment = Enum.TextXAlignment.Left
            recentButton.MouseButton1Click:Connect(function()
                if isCurrentView(token) then
                    searchInput.Text = recentQuery
                    executeSearch()
                end
            end)
        end
    end

    local function showPlayerDetails(targetUserId, parentToken)
        if parentToken and parentToken ~= viewToken then
            return
        end
        local token = beginView()
        resetSearchScroll()

        local loadingLabel = Instance.new("TextLabel")
        loadingLabel.Size = UDim2.new(1, -6, 0, 40)
        loadingLabel.BackgroundTransparency = 1
        loadingLabel.Text = "⚡ Loading player profile..."
        loadingLabel.TextColor3 = Color3.fromRGB(0, 200, 255)
        loadingLabel.Font = Enum.Font.GothamBold
        loadingLabel.TextSize = 12
        loadingLabel.Parent = searchScroll

        task.spawn(function()
            local userId = tonumber(targetUserId)
            if not userId or userId <= 0 then
                if isCurrentView(token) then setSearchMessage("Invalid User ID.", Color3.fromRGB(255, 120, 120)) end
                return
            end

            local targetPlayerObj = Players:GetPlayerByUserId(userId)
            local isTargetInServer = targetPlayerObj ~= nil

            -- Each endpoint is isolated: a failed optional endpoint does not cancel the profile.
            local userData = requestJson("GET", "https://users.roblox.com/v1/users/" .. tostring(userId)) or {}
            if not isCurrentView(token) then return end
            if not userData.id then
                setSearchMessage("Unable to load this profile. The account may be unavailable or the request was blocked.", Color3.fromRGB(255, 150, 120))
                return
            end

            local onlineStatusText = isTargetInServer and "🟢 In This Server" or "⚪ Offline / Unknown"
            local presenceData = requestJson("POST", "https://presence.roblox.com/v1/presence/users", { userIds = { userId } })
            if presenceData and presenceData.userPresences and presenceData.userPresences[1] then
                local presenceType = tonumber(presenceData.userPresences[1].userPresenceType) or 0
                if presenceType == 0 then
                    onlineStatusText = "⚪ Offline"
                elseif presenceType == 1 then
                    onlineStatusText = "🟢 Online (Website)"
                elseif presenceType == 2 then
                    onlineStatusText = "🟢 In Game"
                elseif presenceType == 3 then
                    onlineStatusText = "🟢 In Studio"
                end
            end

            local wearData = requestJson("GET", "https://avatar.roblox.com/v1/users/" .. tostring(userId) .. "/currently-wearing") or {}
            local assetIds = type(wearData.assetIds) == "table" and wearData.assetIds or {}
            local totalRobux, pricedItems, itemNames = 0, 0, {}
            local catalogAvailable = #assetIds == 0
            if #assetIds > 0 then
                local itemsPayload = { items = {} }
                for _, assetId in ipairs(assetIds) do
                    local numericId = tonumber(assetId)
                    if numericId then
                        table.insert(itemsPayload.items, { itemType = "Asset", id = numericId })
                    end
                end
                if #itemsPayload.items > 0 then
                    local catalogData = requestJson("POST", "https://catalog.roblox.com/v1/catalog/items/details", itemsPayload)
                    if catalogData and type(catalogData.data) == "table" then
                        catalogAvailable = true
                        for _, item in ipairs(catalogData.data) do
                            local price = tonumber(item.price) or tonumber(item.lowestPrice)
                            local itemName = tostring(item.name or "Asset")
                            if price then
                                totalRobux = totalRobux + price
                                pricedItems = pricedItems + 1
                                table.insert(itemNames, itemName .. " (" .. tostring(price) .. " R$)")
                            else
                                table.insert(itemNames, itemName .. " (price unavailable)")
                            end
                        end
                    end
                end
            end

            local friendsData = requestJson("GET", "https://friends.roblox.com/v1/users/" .. tostring(userId) .. "/friends/count") or {}
            local followersData = requestJson("GET", "https://friends.roblox.com/v1/users/" .. tostring(userId) .. "/followers/count") or {}
            local followingData = requestJson("GET", "https://friends.roblox.com/v1/users/" .. tostring(userId) .. "/followings/count") or {}
            local friendsCount = tonumber(friendsData.count)
            local followersCount = tonumber(followersData.count)
            local followingCount = tonumber(followingData.count)

            -- Mutual-friend lookup is deliberately capped to avoid unbounded paging/API traffic.
            local mutualFriends = {}
            local mutualLookupAvailable = false
            pcall(function()
                local localFriendPages = Players:GetFriendsAsync(LocalPlayer.UserId)
                local targetFriendPages = Players:GetFriendsAsync(userId)
                local localFriendSet = {}
                local maxPages = 3
                local pageCount = 0
                repeat
                    pageCount = pageCount + 1
                    for _, friend in ipairs(localFriendPages:GetCurrentPage()) do
                        localFriendSet[friend.Id] = true
                    end
                    if localFriendPages.IsFinished or pageCount >= maxPages then break end
                    localFriendPages:AdvanceToNextPageAsync()
                until false

                pageCount = 0
                repeat
                    pageCount = pageCount + 1
                    for _, friend in ipairs(targetFriendPages:GetCurrentPage()) do
                        if localFriendSet[friend.Id] then
                            table.insert(mutualFriends, tostring(friend.DisplayName or friend.Username or "User") .. " (@" .. tostring(friend.Username or "unknown") .. ")")
                        end
                    end
                    if targetFriendPages.IsFinished or pageCount >= maxPages then break end
                    targetFriendPages:AdvanceToNextPageAsync()
                until false
                mutualLookupAvailable = true
            end)

            if not isCurrentView(token) then return end
            resetSearchScroll()

            local profileCard = Instance.new("Frame")
            profileCard.Size = UDim2.new(1, -6, 0, 110)
            profileCard.BackgroundColor3 = Color3.fromRGB(20, 25, 38)
            profileCard.Parent = searchScroll
            Instance.new("UICorner", profileCard).CornerRadius = UDim.new(0, 8)
            local pcStroke = Instance.new("UIStroke", profileCard)
            pcStroke.Color = Color3.fromRGB(0, 180, 255)
            pcStroke.Thickness = 1.2

            local avatarImg = Instance.new("ImageLabel")
            avatarImg.Size = UDim2.fromOffset(80, 80)
            avatarImg.Position = UDim2.fromOffset(8, 15)
            avatarImg.BackgroundColor3 = Color3.fromRGB(12, 15, 22)
            avatarImg.Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(userId) .. "&w=150&h=150"
            avatarImg.Parent = profileCard
            Instance.new("UICorner", avatarImg).CornerRadius = UDim.new(0, 6)

            local nameLabel = Instance.new("TextLabel")
            nameLabel.Size = UDim2.new(1, -95, 0, 18)
            nameLabel.Position = UDim2.fromOffset(95, 6)
            nameLabel.BackgroundTransparency = 1
            nameLabel.Text = tostring(userData.displayName or "User") .. " (@" .. tostring(userData.name or "unknown") .. ")"
            nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            nameLabel.Font = Enum.Font.GothamBold
            nameLabel.TextSize = 12
            nameLabel.TextXAlignment = Enum.TextXAlignment.Left
            nameLabel.Parent = profileCard

            local statusLabel = Instance.new("TextLabel")
            statusLabel.Size = UDim2.new(1, -95, 0, 16)
            statusLabel.Position = UDim2.fromOffset(95, 24)
            statusLabel.BackgroundTransparency = 1
            statusLabel.Text = "Status: " .. onlineStatusText .. " | ID: " .. tostring(userId)
            statusLabel.TextColor3 = Color3.fromRGB(0, 230, 255)
            statusLabel.Font = Enum.Font.GothamSemibold
            statusLabel.TextSize = 10
            statusLabel.TextXAlignment = Enum.TextXAlignment.Left
            statusLabel.Parent = profileCard

            local outfitText
            if #assetIds == 0 then
                outfitText = "💎 Outfit Value: No catalog assets found"
            elseif catalogAvailable then
                outfitText = "💎 Outfit Value: ~" .. tostring(totalRobux) .. " R$ (" .. tostring(pricedItems) .. "/" .. tostring(#assetIds) .. " priced)"
            else
                outfitText = "💎 Outfit Value: Unavailable"
            end
            local robuxLabel = Instance.new("TextLabel")
            robuxLabel.Size = UDim2.new(1, -95, 0, 16)
            robuxLabel.Position = UDim2.fromOffset(95, 42)
            robuxLabel.BackgroundTransparency = 1
            robuxLabel.Text = outfitText
            robuxLabel.TextColor3 = Color3.fromRGB(0, 230, 140)
            robuxLabel.Font = Enum.Font.GothamBold
            robuxLabel.TextSize = 10
            robuxLabel.TextXAlignment = Enum.TextXAlignment.Left
            robuxLabel.Parent = profileCard

            local friendStatsLbl = Instance.new("TextLabel")
            friendStatsLbl.Size = UDim2.new(1, -95, 0, 16)
            friendStatsLbl.Position = UDim2.fromOffset(95, 60)
            friendStatsLbl.BackgroundTransparency = 1
            friendStatsLbl.Text = "👥 Friends: " .. formatCount(friendsCount) .. " | Followers: " .. formatCount(followersCount) .. " | Following: " .. formatCount(followingCount) .. " | Mutual: " .. (mutualLookupAvailable and tostring(#mutualFriends) or "N/A")
            friendStatsLbl.TextColor3 = Color3.fromRGB(200, 220, 255)
            friendStatsLbl.Font = Enum.Font.GothamSemibold
            friendStatsLbl.TextSize = 9
            friendStatsLbl.TextXAlignment = Enum.TextXAlignment.Left
            friendStatsLbl.Parent = profileCard

            local joinMapBtn = Instance.new("TextButton")
            joinMapBtn.Size = UDim2.new(1, -100, 0, 24)
            joinMapBtn.Position = UDim2.fromOffset(95, 79)
            joinMapBtn.BackgroundColor3 = isTargetInServer and Color3.fromRGB(0, 140, 200) or Color3.fromRGB(35, 75, 130)
            joinMapBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            joinMapBtn.Text = isTargetInServer and "🟢 Teleport to Player in Server" or "Player Not in This Server"
            joinMapBtn.Font = Enum.Font.GothamBold
            joinMapBtn.TextSize = 10
            joinMapBtn.BorderSizePixel = 0
            joinMapBtn.Parent = profileCard
            joinMapBtn.AutoButtonColor = isTargetInServer
            Instance.new("UICorner", joinMapBtn).CornerRadius = UDim.new(0, 4)
            if isTargetInServer then
                joinMapBtn.MouseButton1Click:Connect(function()
                    local targetCharacter = targetPlayerObj and targetPlayerObj.Character
                    local localCharacter = LocalPlayer.Character
                    local targetRoot = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
                    local localRoot = localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")
                    if targetRoot and localRoot then
                        localRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3)
                    else
                        joinMapBtn.Text = "Character unavailable"
                    end
                end)
            end

            local bioBox = Instance.new("TextLabel")
            bioBox.Size = UDim2.new(1, -6, 0, 60)
            bioBox.BackgroundColor3 = Color3.fromRGB(16, 20, 28)
            local description = tostring(userData.description or "")
            bioBox.Text = "📝 Description: " .. (description ~= "" and description or "No description provided.")
            bioBox.TextColor3 = Color3.fromRGB(180, 190, 210)
            bioBox.Font = Enum.Font.Gotham
            bioBox.TextSize = 10
            bioBox.TextWrapped = true
            bioBox.TextYAlignment = Enum.TextYAlignment.Top
            bioBox.TextXAlignment = Enum.TextXAlignment.Left
            bioBox.Parent = searchScroll
            Instance.new("UICorner", bioBox).CornerRadius = UDim.new(0, 6)
            local bioPad = Instance.new("UIPadding", bioBox)
            bioPad.PaddingTop = UDim.new(0, 6)
            bioPad.PaddingLeft = UDim.new(0, 6)
            bioPad.PaddingRight = UDim.new(0, 6)

            local createdText = tostring(userData.created or "Unknown")
            if #createdText >= 10 then createdText = string.sub(createdText, 1, 10) end
            local createdLabel = Instance.new("TextLabel")
            createdLabel.Size = UDim2.new(1, -6, 0, 20)
            createdLabel.BackgroundColor3 = Color3.fromRGB(24, 28, 40)
            createdLabel.Text = "📅 Account created: " .. createdText
            createdLabel.TextColor3 = Color3.fromRGB(200, 220, 255)
            createdLabel.Font = Enum.Font.Gotham
            createdLabel.TextSize = 10
            createdLabel.TextXAlignment = Enum.TextXAlignment.Left
            createdLabel.Parent = searchScroll

            local wearHeader = Instance.new("TextLabel")
            wearHeader.Size = UDim2.new(1, 0, 0, 18)
            wearHeader.BackgroundTransparency = 1
            wearHeader.Text = "👕 Currently Wearing Items (" .. tostring(#itemNames) .. "):"
            wearHeader.TextColor3 = Color3.fromRGB(0, 200, 255)
            wearHeader.Font = Enum.Font.GothamBold
            wearHeader.TextSize = 11
            wearHeader.TextXAlignment = Enum.TextXAlignment.Left
            wearHeader.Parent = searchScroll

            if #itemNames == 0 then
                local emptyItems = Instance.new("TextLabel")
                emptyItems.Size = UDim2.new(1, -6, 0, 20)
                emptyItems.BackgroundColor3 = Color3.fromRGB(24, 28, 40)
                emptyItems.Text = " • No public catalog items returned."
                emptyItems.TextColor3 = Color3.fromRGB(170, 180, 195)
                emptyItems.Font = Enum.Font.Gotham
                emptyItems.TextSize = 10
                emptyItems.TextXAlignment = Enum.TextXAlignment.Left
                emptyItems.Parent = searchScroll
            else
                for _, itemName in ipairs(itemNames) do
                    local itemLbl = Instance.new("TextLabel")
                    itemLbl.Size = UDim2.new(1, -6, 0, 20)
                    itemLbl.BackgroundColor3 = Color3.fromRGB(24, 28, 40)
                    itemLbl.Text = " • " .. tostring(itemName)
                    itemLbl.TextColor3 = Color3.fromRGB(220, 230, 245)
                    itemLbl.Font = Enum.Font.Gotham
                    itemLbl.TextSize = 10
                    itemLbl.TextXAlignment = Enum.TextXAlignment.Left
                    itemLbl.Parent = searchScroll
                    Instance.new("UICorner", itemLbl).CornerRadius = UDim.new(0, 4)
                end
            end

            if not mutualLookupAvailable then
                local mutualNote = Instance.new("TextLabel")
                mutualNote.Size = UDim2.new(1, -6, 0, 20)
                mutualNote.BackgroundTransparency = 1
                mutualNote.Text = "Mutual friends unavailable (private/limited friend data or API restriction)."
                mutualNote.TextColor3 = Color3.fromRGB(150, 160, 175)
                mutualNote.Font = Enum.Font.Gotham
                mutualNote.TextSize = 9
                mutualNote.TextWrapped = true
                mutualNote.Parent = searchScroll
            end
        end)
    end

    executeSearch = function()
        local rawQuery = tostring(searchInput.Text or "")
        local query = rawQuery:match("^%s*(.-)%s*$") or ""
        if query == "" then
            showRecentSearches()
            return
        end

        local token = beginView()
        addRecentSearch(query)
        searchSubmitBtn.Text = "Searching..."
        searchSubmitBtn.AutoButtonColor = false
        setSearchMessage("Searching for '" .. query .. "'...")

        task.spawn(function()
            local results, seenIds = {}, {}
            local function addResult(data)
                if type(data) ~= "table" then return end
                local id = tonumber(data.id)
                if not id or seenIds[id] then return end
                seenIds[id] = true
                table.insert(results, {
                    id = id,
                    name = tostring(data.name or data.username or "Unknown"),
                    displayName = tostring(data.displayName or data.name or data.username or "Unknown")
                })
            end

            -- Numeric input is treated as a direct User ID lookup.
            local numericId = tonumber(query)
            if numericId and numericId > 0 and numericId % 1 == 0 then
                local directData = requestJson("GET", "https://users.roblox.com/v1/users/" .. string.format("%.0f", numericId))
                if directData and directData.id then addResult(directData) end
            else
                -- Exact username lookup first, then display-name/partial search.
                local nameSuccess, resolvedId = pcall(function()
                    return Players:GetUserIdFromNameAsync(query)
                end)
                if nameSuccess and resolvedId then
                    local exactData = requestJson("GET", "https://users.roblox.com/v1/users/" .. tostring(resolvedId))
                    if exactData and exactData.id then addResult(exactData) end
                end
            end

            if #results == 0 or not (numericId and numericId > 0 and numericId % 1 == 0) then
                local searchUrl = "https://users.roblox.com/v1/users/search?keyword=" .. encodeQuery(query) .. "&limit=10"
                local searchData = requestJson("GET", searchUrl)
                if searchData and type(searchData.data) == "table" then
                    for _, result in ipairs(searchData.data) do addResult(result) end
                end
            end

            if not isCurrentView(token) then return end
            searchSubmitBtn.Text = "🔍 Search"
            searchSubmitBtn.AutoButtonColor = true

            if #results == 0 then
                local message = setSearchMessage("No players found, or Roblox search is temporarily unavailable. Check the spelling and try again.", Color3.fromRGB(255, 150, 120))
                return
            end

            if #results == 1 then
                showPlayerDetails(results[1].id, token)
                return
            end

            resetSearchScroll()
            local resultsHeader = Instance.new("TextLabel")
            resultsHeader.Size = UDim2.new(1, -6, 0, 22)
            resultsHeader.BackgroundTransparency = 1
            resultsHeader.Text = "Found " .. tostring(#results) .. " matching accounts"
            resultsHeader.TextColor3 = Color3.fromRGB(0, 200, 255)
            resultsHeader.Font = Enum.Font.GothamBold
            resultsHeader.TextSize = 11
            resultsHeader.TextXAlignment = Enum.TextXAlignment.Left
            resultsHeader.Parent = searchScroll

            for _, playerData in ipairs(results) do
                if not isCurrentView(token) then return end
                local card = Instance.new("Frame")
                card.Size = UDim2.new(1, -6, 0, 48)
                card.BackgroundColor3 = Color3.fromRGB(24, 29, 42)
                card.Parent = searchScroll
                Instance.new("UICorner", card).CornerRadius = UDim.new(0, 6)

                local headshot = Instance.new("ImageLabel")
                headshot.Size = UDim2.fromOffset(38, 38)
                headshot.Position = UDim2.fromOffset(5, 5)
                headshot.BackgroundColor3 = Color3.fromRGB(15, 18, 26)
                headshot.Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(playerData.id) .. "&w=150&h=150"
                headshot.Parent = card
                Instance.new("UICorner", headshot).CornerRadius = UDim.new(1, 0)

                local title = Instance.new("TextLabel")
                title.Size = UDim2.new(1, -140, 1, 0)
                title.Position = UDim2.fromOffset(50, 0)
                title.BackgroundTransparency = 1
                title.Text = playerData.displayName .. "\n@" .. playerData.name
                title.TextColor3 = Color3.fromRGB(240, 245, 255)
                title.Font = Enum.Font.GothamSemibold
                title.TextSize = 10
                title.TextXAlignment = Enum.TextXAlignment.Left
                title.Parent = card

                local inspectBtn = createContentButton(card, "Inspect Profile", UDim2.fromOffset(80, 26), UDim2.new(1, -85, 0.5, -13), Color3.fromRGB(0, 120, 200))
                inspectBtn.MouseButton1Click:Connect(function()
                    if isCurrentView(token) then showPlayerDetails(playerData.id, token) end
                end)
            end
        end)
    end

    searchSubmitBtn.MouseButton1Click:Connect(executeSearch)
    searchInput.FocusLost:Connect(function(enterPressed)
        if enterPressed then executeSearch() end
    end)
end

