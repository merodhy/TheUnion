    local function addFilterOption(name, callback, customBg)
        local btn = createContentButton(scroll, name, UDim2.new(1, -6, 0, 36), UDim2.new(), customBg or Color3.fromRGB(20, 24, 34))
        btn.MouseButton1Click:Connect(callback)
        return btn
    end

    local filterEffects = {}
    local filterLightingOriginal = {
        GlobalShadows = Lighting.GlobalShadows,
        OutdoorAmbient = Lighting.OutdoorAmbient,
        Ambient = Lighting.Ambient,
        Brightness = Lighting.Brightness,
        ClockTime = Lighting.ClockTime,
        ExposureCompensation = Lighting.ExposureCompensation,
    }

    local function trackFilterEffect(effect)
        table.insert(filterEffects, effect)
        return effect
    end

    local function clearAllFilters()
        for _, effect in ipairs(filterEffects) do
            if effect and effect.Parent then pcall(function() effect:Destroy() end) end
        end
        table.clear(filterEffects)
    end

    local function restoreFilterLighting()
        clearAllFilters()
        for property, value in pairs(filterLightingOriginal) do
            pcall(function() Lighting[property] = value end)
        end
    end

