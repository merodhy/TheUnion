    addFilterOption("🌌 7. Deep Space Midnight Engine", function()
        clearAllFilters()
        local cc = Instance.new("ColorCorrectionEffect", Lighting)
        cc.Name = "RTXFilterSpace"
        cc.TintColor = Color3.fromRGB(100, 150, 255)
