local tabButtons = {}
local tabContents = {}

local function styleButton(btn, active)
    local targetColor = active and Color3.fromRGB(0, 120, 200) or Color3.fromRGB(20, 24, 34)
    local strokeColor = active and Color3.fromRGB(0, 220, 255) or Color3.fromRGB(35, 42, 60)
    
    TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = targetColor}):Play()
    local stroke = btn:FindFirstChildOfClass("UIStroke")
    if stroke then
        TweenService:Create(stroke, TweenInfo.new(0.2), {Color = strokeColor}):Play()
    end
end

local function createTabButton(name, widthScale)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(widthScale, -2, 1, 0)
    btn.BackgroundColor3 = Color3.fromRGB(20, 24, 34)
    btn.TextColor3 = Color3.fromRGB(240, 240, 255)
    btn.Text = name
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 10
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    btn.Parent = navBar

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    local btnStroke = Instance.new("UIStroke")
    btnStroke.Color = Color3.fromRGB(35, 42, 60)
    btnStroke.Thickness = 1
    btnStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    btnStroke.Parent = btn

    local contentFrame = Instance.new("Frame")
    contentFrame.Name = name .. "Tab"
    contentFrame.Size = UDim2.new(1, -24, 1, -100)
    contentFrame.Position = UDim2.fromOffset(12, 92)
    contentFrame.BackgroundTransparency = 1
    contentFrame.Visible = false
    contentFrame.Parent = mainFrame

    tabButtons[name] = btn
    tabContents[name] = contentFrame

    btn.MouseButton1Click:Connect(function()
        for tName, tFrame in pairs(tabContents) do
            local isActive = (tName == name)
            tFrame.Visible = isActive
            styleButton(tabButtons[tName], isActive)
        end
    end)

    return contentFrame
end

