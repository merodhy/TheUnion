--========================================================
-- MODULE 3.5: SKY TIME STUDIO TAB (HOURLY SHIFTS & RESET)
--========================================================
do
    local skyScroll = Instance.new("ScrollingFrame")
    skyScroll.Size = UDim2.new(1, 0, 1, -10)
    skyScroll.Position = UDim2.fromOffset(0, 5)
    skyScroll.BackgroundTransparency = 1
    skyScroll.BorderSizePixel = 0
    skyScroll.ScrollBarThickness = 4
    skyScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    skyScroll.CanvasSize = UDim2.new()
    skyScroll.Parent = skyTab
    local skyLayout = Instance.new("UIListLayout", skyScroll)
    skyLayout.Padding = UDim.new(0, 8)

    local originalClockTime = Lighting.ClockTime
    local originalBrightness = Lighting.Brightness

    local function addSkyButton(name, callback, customBg)
        local btn = createContentButton(skyScroll, name, UDim2.new(1, -6, 0, 36), UDim2.new(), customBg or Color3.fromRGB(20, 24, 34))
        btn.MouseButton1Click:Connect(callback)
        return btn
    end

    -- 1. Reset Sky Time Button
    addSkyButton("🔄 Reset Sky Time to Default", function()
        if activeSkyLoopConnection then
            activeSkyLoopConnection:Disconnect()
            activeSkyLoopConnection = nil
        end
        Lighting.ClockTime = originalClockTime
        Lighting.Brightness = originalBrightness
    end, Color3.fromRGB(120, 35, 45))

    -- 2. Dynamic Every 1 Hour Cycle Button
    local autoCycleActive = false
    local autoCycleBtn, autoCycleStroke = createContentButton(skyScroll, "⏱️ Dynamic Sky: Change Every 1 Hour [OFF]", UDim2.new(1, -6, 0, 38), UDim2.new(), Color3.fromRGB(28, 33, 46))

    local function toggleDynamicSkyCycle()
        autoCycleActive = not autoCycleActive
        if autoCycleActive then
            autoCycleBtn.Text = "⏱️ Dynamic Sky: Change Every 1 Hour [ON]"
            TweenService:Create(autoCycleBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(35, 140, 85)}):Play()
            TweenService:Create(autoCycleStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(60, 200, 120)}):Play()

            -- Changes ClockTime automatically every 1 real-life second (simulating 1 in-game hour jump per second)
            local accumulatedTime = Lighting.ClockTime
            activeSkyLoopConnection = addConnection(RunService.Stepped:Connect(function(dt)
                if not autoCycleActive then return end
                accumulatedTime = (accumulatedTime + (dt * 1)) % 24
                Lighting.ClockTime = accumulatedTime
            end))
        else
            if activeSkyLoopConnection then
                activeSkyLoopConnection:Disconnect()
                activeSkyLoopConnection = nil
            end
            autoCycleBtn.Text = "⏱️ Dynamic Sky: Change Every 1 Hour [OFF]"
            TweenService:Create(autoCycleBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(28, 33, 46)}):Play()
            TweenService:Create(autoCycleStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(45, 55, 80)}):Play()
        end
    end
    autoCycleBtn.MouseButton1Click:Connect(toggleDynamicSkyCycle)

    -- 3. Static Hourly Sky Time Selection Buttons (00:00 to 23:00)
    local hoursData = {
        {name = "🕛 00:00 Midnight (Deep Night)", time = 0},
        {name = "🕐 01:00 AM (Late Night)", time = 1},
        {name = "🕑 02:00 AM (Starlit Night)", time = 2},
        {name = "🕒 03:00 AM (Pre-Dawn)", time = 3},
        {name = "🕓 04:00 AM (Deep Twilight)", time = 4},
        {name = "🕔 05:00 AM (Early Dawn)", time = 5},
        {name = "🕕 06:00 AM (Sunrise)", time = 6, bg = Color3.fromRGB(100, 60, 30)},
        {name = "🕖 07:00 AM (Morning Glow)", time = 7},
        {name = "🕗 08:00 AM (Late Morning)", time = 8},
        {name = "🕘 09:00 AM (Bright Morning)", time = 9},
        {name = "🕙 10:00 AM (Late Morning Sun)", time = 10},
        {name = "🕚 11:00 AM (Pre-Noon)", time = 11},
        {name = "🕛 12:00 PM (Midday Noon Sun)", time = 12, bg = Color3.fromRGB(80, 70, 20)},
        {name = "🕐 01:00 PM (Early Afternoon)", time = 13},
        {name = "🕑 02:00 PM (Bright Afternoon)", time = 14},
        {name = "🕒 03:00 PM (Late Afternoon Sun)", time = 15},
        {name = "🕓 04:00 PM (Golden Hour Start)", time = 16},
        {name = "🕔 05:00 PM (Sunset Peak)", time = 17, bg = Color3.fromRGB(120, 50, 20)},
        {name = "🕕 06:00 PM (Dusk / Twilight)", time = 18},
        {name = "🕖 07:00 PM (Evening Dusk)", time = 19},
        {name = "🕗 08:00 PM (Nightfall)", time = 20},
        {name = "🕘 09:00 PM (Early Night)", time = 21},
        {name = "🕙 10:00 PM (Deep Night Sky)", time = 22},
        {name = "🕚 11:00 PM (Midnight Approach)", time = 23},
    }

    for _, hd in ipairs(hoursData) do
        addSkyButton(hd.name, function()
            if activeSkyLoopConnection then
                activeSkyLoopConnection:Disconnect()
                activeSkyLoopConnection = nil
                autoCycleActive = false
                autoCycleBtn.Text = "⏱️ Dynamic Sky: Change Every 1 Hour [OFF]"
                TweenService:Create(autoCycleBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(28, 33, 46)}):Play()
            end
            Lighting.ClockTime = hd.time
        end, hd.bg)
    end

    registerCleanup(function()
        autoCycleActive = false
        disconnectConnection(activeSkyLoopConnection)
        activeSkyLoopConnection = nil
        pcall(function() Lighting.ClockTime = originalClockTime end)
        pcall(function() Lighting.Brightness = originalBrightness end)
    end)
end

--========================================================
-- MODULE 4: SPECTATE & TELEPORT (ALL PLAYERS)
--========================================================
do
    local selectedTarget = nil
    local spectating = false

    local statusLabel = Instance.new("TextLabel")
    statusLabel.Size = UDim2.new(1, 0, 0, 22)
    statusLabel.Position = UDim2.fromOffset(0, 5)
    statusLabel.BackgroundTransparency = 1
    statusLabel.Text = "Select player to watch/teleport"
    statusLabel.TextColor3 = Color3.fromRGB(180, 190, 210)
    statusLabel.Font = Enum.Font.Gotham
    statusLabel.TextSize = 12
    statusLabel.Parent = specTab

    local searchBox = Instance.new("TextBox")
    searchBox.Size = UDim2.new(1, 0, 0, 32)
    searchBox.Position = UDim2.fromOffset(0, 32)
    searchBox.BackgroundColor3 = Color3.fromRGB(18, 22, 32)
    searchBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    searchBox.PlaceholderText = "Search player..."
    searchBox.Text = ""
    searchBox.Font = Enum.Font.Gotham
    searchBox.TextSize = 12
    searchBox.BorderSizePixel = 0
    searchBox.Parent = specTab
    Instance.new("UICorner", searchBox).CornerRadius = UDim.new(0, 6)

    local playerListFrame = Instance.new("ScrollingFrame")
    playerListFrame.Size = UDim2.new(1, 0, 1, -125)
    playerListFrame.Position = UDim2.fromOffset(0, 72)
    playerListFrame.BackgroundColor3 = Color3.fromRGB(16, 20, 28)
    playerListFrame.BorderSizePixel = 0
    playerListFrame.ScrollBarThickness = 4
    playerListFrame.CanvasSize = UDim2.new()
    playerListFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
    playerListFrame.Parent = specTab
    Instance.new("UICorner", playerListFrame).CornerRadius = UDim.new(0, 6)
    local listLayout = Instance.new("UIListLayout", playerListFrame)
    listLayout.Padding = UDim.new(0, 4)

    local toggleSpecBtn = createContentButton(specTab, "Start Spectating", UDim2.new(0.5, -4, 0, 38), UDim2.new(0, 0, 1, -42), Color3.fromRGB(28, 33, 46))
    local teleportBtn = createContentButton(specTab, "Teleport to Player", UDim2.new(0.5, -4, 0, 38), UDim2.new(0.5, 4, 1, -42), Color3.fromRGB(35, 75, 130))

    local function refreshList()
        for _, child in ipairs(playerListFrame:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end

        local query = searchBox.Text:lower()
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                if query == "" or p.Name:lower():find(query, 1, true) or p.DisplayName:lower():find(query, 1, true) then
                    local pBtn = createContentButton(playerListFrame, p.DisplayName .. " (@" .. p.Name .. ")", UDim2.new(1, -6, 0, 30), UDim2.new(), Color3.fromRGB(24, 28, 40))
                    if selectedTarget == p then pBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 200) end
                    pBtn.MouseButton1Click:Connect(function()
                        selectedTarget = p
                        statusLabel.Text = "Selected: " .. p.Name
                        refreshList()
                    end)
                end
            end
        end
    end

    addConnection(searchBox:GetPropertyChangedSignal("Text"):Connect(refreshList))

    toggleSpecBtn.MouseButton1Click:Connect(function()
        local camera = Workspace.CurrentCamera
        if not spectating then
            if selectedTarget and selectedTarget.Character and selectedTarget.Character:FindFirstChildOfClass("Humanoid") then
                camera.CameraSubject = selectedTarget.Character:FindFirstChildOfClass("Humanoid")
                spectating = true
                toggleSpecBtn.Text = "Stop Spectating"
                statusLabel.Text = "Watching: " .. selectedTarget.Name
            end
        else
            spectating = false
            toggleSpecBtn.Text = "Start Spectating"
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
                camera.CameraSubject = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            end
        end
    end)

    teleportBtn.MouseButton1Click:Connect(function()
        if selectedTarget and selectedTarget.Character then
            local targetRoot = selectedTarget.Character:FindFirstChild("HumanoidRootPart")
            local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if targetRoot and localRoot then
                localRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3)
            end
        end
    end)

    addConnection(Players.PlayerAdded:Connect(refreshList))
    addConnection(Players.PlayerRemoving:Connect(function(player)
        if selectedTarget == player then
            selectedTarget = nil
            if spectating then
                spectating = false
                local camera = Workspace.CurrentCamera
                local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                if camera and humanoid then camera.CameraSubject = humanoid end
                toggleSpecBtn.Text = "Start Spectating"
                statusLabel.Text = "Target left the server"
            end
        end
        refreshList()
    end))
    registerCleanup(function()
        spectating = false
        selectedTarget = nil
        local camera = Workspace.CurrentCamera
        local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if camera and humanoid then pcall(function() camera.CameraSubject = humanoid end) end
    end)
    refreshList()
end

--========================================================
-- MODULE 5: SUBMERGE & ARM ANIMATION
--========================================================
do
    local submergeOffset = 7
    local minSubmergeDepth, maxSubmergeDepth = 2, 100
    local submergeBaseplate = nil
    local swimSpeed = 20
    local riseMultiplier = 1.1

    local submerged = false
    local animationPlaying = false
    local savedSubmergeY = nil
    local savedSubmergeCFrame = nil
    local savedCameraCFrame = nil
    local savedCameraType = nil
    local savedCameraSubject = nil
    local savedPlatformStand = nil
    local originalCollision = {}
    local submergeHighlight = nil
    local savedAutoRotate = nil
    local animationTrack = nil
    local armBtn, armStroke
    local setButtonState
    local animationStoppedConnection = nil
    local humanoidDiedConnection = nil
    local currentCharacter, currentHumanoid, currentRoot
    local submergeCharacter, submergeHumanoid, submergeRoot

    local function getCharacterParts()
        currentCharacter = LocalPlayer.Character
        if not currentCharacter then return false end
        currentHumanoid = currentCharacter:FindFirstChildOfClass("Humanoid")
        currentRoot = currentCharacter:FindFirstChild("HumanoidRootPart")
        return currentHumanoid ~= nil and currentRoot ~= nil
    end

    local function loadArmAnimation(expectedCharacter)
        local character = expectedCharacter or LocalPlayer.Character
        if not character or character ~= LocalPlayer.Character then return false end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid then return false end

        currentCharacter = character
        currentHumanoid = humanoid
        currentRoot = character:FindFirstChild("HumanoidRootPart")

        local animator = humanoid:FindFirstChildOfClass("Animator")
        if not animator then
            local createdAnimator = Instance.new("Animator")
            createdAnimator.Parent = humanoid
            animator = createdAnimator
        end

        if animationTrack then
            pcall(function() animationTrack:Stop(0) end)
            pcall(function() animationTrack:Destroy() end)
            animationTrack = nil
        end
        if animationStoppedConnection then
            animationStoppedConnection:Disconnect()
            animationStoppedConnection = nil
        end

        local animation = Instance.new("Animation")
        animation.AnimationId = "rbxassetid://536135263"
        local ok, trackOrError = pcall(function()
            return animator:LoadAnimation(animation)
        end)
        animation:Destroy()

        if not ok or not trackOrError then
            animationTrack = nil
            warn("[TheUnionHub] Arm animation could not be loaded: " .. tostring(trackOrError))
            return false
        end

        animationTrack = trackOrError
        animationTrack.Looped = true
        animationStoppedConnection = animationTrack.Stopped:Connect(function()
            if animationPlaying then
                animationPlaying = false
                setButtonState(armBtn, armStroke, false, "Arm Animation")
            end
        end)
        return true
    end

    local submergeBtn, submergeStroke = createContentButton(
        submergeTab,
        "Submerge: OFF",
        UDim2.new(1, 0, 0, 38),
        UDim2.fromOffset(0, 34),
        Color3.fromRGB(28, 33, 46)
    )
    armBtn, armStroke = createContentButton(
        submergeTab,
        "Arm Animation: OFF",
        UDim2.new(1, 0, 0, 38),
        UDim2.fromOffset(0, 82),
        Color3.fromRGB(28, 33, 46)
    )

    local depthLabel = Instance.new("TextLabel")
    depthLabel.Size = UDim2.new(1, 0, 0, 24)
    depthLabel.Position = UDim2.fromOffset(0, 4)
    depthLabel.BackgroundTransparency = 1
    depthLabel.Text = "Submerge depth: " .. tostring(submergeOffset) .. " studs | Speed: " .. tostring(swimSpeed)
    depthLabel.TextColor3 = Color3.fromRGB(180, 190, 210)
    depthLabel.Font = Enum.Font.Gotham
    depthLabel.TextSize = 11
    depthLabel.Parent = submergeTab

    local depthInput = Instance.new("TextBox")
    depthInput.Name = "SubmergeDepthInput"
    depthInput.Size = UDim2.new(1, 0, 0, 30)
    depthInput.Position = UDim2.fromOffset(0, 128)
    depthInput.BackgroundColor3 = Color3.fromRGB(20, 25, 36)
    depthInput.BorderSizePixel = 0
    depthInput.TextColor3 = Color3.fromRGB(235, 240, 250)
    depthInput.PlaceholderColor3 = Color3.fromRGB(130, 140, 160)
    depthInput.Font = Enum.Font.Gotham
    depthInput.TextSize = 12
    depthInput.ClearTextOnFocus = false
    depthInput.Text = tostring(submergeOffset)
    depthInput.PlaceholderText = "Depth in studs (2-100)"
    depthInput.Parent = submergeTab
    local depthInputCorner = Instance.new("UICorner")
    depthInputCorner.CornerRadius = UDim.new(0, 7)
    depthInputCorner.Parent = depthInput

    local function updateDepth()
        local value = tonumber(depthInput.Text)
        if value then
            submergeOffset = math.clamp(value, minSubmergeDepth, maxSubmergeDepth)
            depthInput.Text = tostring(submergeOffset)
            depthLabel.Text = "Depth: " .. tostring(submergeOffset) .. " studs | Speed: " .. tostring(swimSpeed)
        else
            depthInput.Text = tostring(submergeOffset)
        end
    end
    depthInput.FocusLost:Connect(updateDepth)

    setButtonState = function(btn, stroke, enabled, label)
        btn.Text = label .. (enabled and ": ON" or ": OFF")
        local bg = enabled and Color3.fromRGB(35, 140, 85) or Color3.fromRGB(28, 33, 46)
        local outline = enabled and Color3.fromRGB(60, 200, 120) or Color3.fromRGB(45, 55, 80)
        TweenService:Create(btn, TweenInfo.new(0.18), {BackgroundColor3 = bg}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.18), {Color = outline}):Play()
    end

    local function restoreCollision()
        for part, canCollide in pairs(originalCollision) do
            if part and part.Parent then
                pcall(function()
                    part.CanCollide = canCollide
                end)
            end
        end
        table.clear(originalCollision)
    end

    -- Cleanup is deliberately independent of the current LocalPlayer.Character:
    -- on respawn, restore the exact Humanoid and parts that were modified earlier.
    local function stopSubmerge(restorePosition)
        submerged = false

        if submergeBaseplate then
            pcall(function() submergeBaseplate:Destroy() end)
            submergeBaseplate = nil
        end

        local humanoidToRestore = submergeHumanoid
        if humanoidToRestore and humanoidToRestore.Parent then
            pcall(function()
                if savedPlatformStand ~= nil then
                    humanoidToRestore.PlatformStand = savedPlatformStand
                end
                if savedAutoRotate ~= nil then
                    humanoidToRestore.AutoRotate = savedAutoRotate
                end
            end)
        end

        -- On a normal user-requested stop, return only to the character's own
        -- saved starting transform. Respawn/death cleanup passes false and never
        -- moves a replacement character.
        if restorePosition and submergeRoot and submergeRoot.Parent and savedSubmergeCFrame then
            pcall(function()
                submergeRoot.CFrame = savedSubmergeCFrame
            end)
        end
        restoreCollision()

        if submergeHighlight then
            pcall(function() submergeHighlight:Destroy() end)
            submergeHighlight = nil
        end

        -- The module does not intentionally take control of the camera, so do not
        -- force an old camera CFrame onto a newly spawned character/camera.
        savedSubmergeY = nil
        savedSubmergeCFrame = nil
        savedCameraCFrame = nil
        savedCameraType = nil
        savedCameraSubject = nil
        savedPlatformStand = nil
        savedAutoRotate = nil
        submergeCharacter = nil
        submergeHumanoid = nil
        submergeRoot = nil
        setButtonState(submergeBtn, submergeStroke, false, "Submerge")
    end

    local function startSubmerge()
        if submerged or not getCharacterParts() then return end
        local camera = Workspace.CurrentCamera
        if not camera then return end

        savedSubmergeY = currentRoot.Position.Y
        savedSubmergeCFrame = currentRoot.CFrame
        submergeCharacter = currentCharacter
        submergeHumanoid = currentHumanoid
        submergeRoot = currentRoot
        savedPlatformStand = currentHumanoid.PlatformStand
        savedAutoRotate = currentHumanoid.AutoRotate

        table.clear(originalCollision)
        for _, part in ipairs(currentCharacter:GetDescendants()) do
            if part:IsA("BasePart") then
                originalCollision[part] = part.CanCollide
                part.CanCollide = (part == currentRoot)
            end
        end

        currentHumanoid.PlatformStand = false
        currentHumanoid.AutoRotate = false
        local targetY = savedSubmergeY - submergeOffset
        currentRoot.CFrame = CFrame.new(currentRoot.Position.X, targetY, currentRoot.Position.Z) * currentRoot.CFrame.Rotation

        submergeBaseplate = Instance.new("Part")
        submergeBaseplate.Name = "SubmergeSafetyBaseplate"
        submergeBaseplate.Size = Vector3.new(100, 1, 100)
        submergeBaseplate.Anchored = true
        submergeBaseplate.CanCollide = true
        submergeBaseplate.CanTouch = false
        submergeBaseplate.CanQuery = false
        submergeBaseplate.Transparency = 1
        submergeBaseplate.TopSurface = Enum.SurfaceType.Smooth
        submergeBaseplate.BottomSurface = Enum.SurfaceType.Smooth
        local platformY = targetY - currentHumanoid.HipHeight - (currentRoot.Size.Y * 0.5) - 0.5
        submergeBaseplate.CFrame = CFrame.new(currentRoot.Position.X, platformY, currentRoot.Position.Z)
        submergeBaseplate.Parent = Workspace

        submergeHighlight = Instance.new("Highlight")
        submergeHighlight.Name = "SubmergeHighlight"
        submergeHighlight.FillTransparency = 1
        submergeHighlight.OutlineTransparency = 0
        submergeHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        submergeHighlight.Parent = currentCharacter

        submerged = true
        setButtonState(submergeBtn, submergeStroke, true, "Submerge")
    end

    toggleSubmerge = function()
        if submerged then
            stopSubmerge(true)
        else
            startSubmerge()
        end
    end

    local function toggleArmAnimation()
        if animationPlaying then
            animationPlaying = false
            if animationTrack then
                pcall(function() animationTrack:Stop(0.15) end)
            end
            setButtonState(armBtn, armStroke, false, "Arm Animation")
            return
        end

        if not animationTrack and not loadArmAnimation() then
            armBtn.Text = "Animation unavailable"
            return
        end

        local ok = pcall(function() animationTrack:Play(0.15) end)
        if ok then
            animationPlaying = true
            setButtonState(armBtn, armStroke, true, "Arm Animation")
        else
            animationPlaying = false
            armBtn.Text = "Animation unavailable"
        end
    end

    submergeBtn.MouseButton1Click:Connect(toggleSubmerge)
    armBtn.MouseButton1Click:Connect(toggleArmAnimation)

    addConnection(RunService.RenderStepped:Connect(function()
        if submerged then
            if not getCharacterParts() then
                stopSubmerge(false)
                return
            end
            local targetY = savedSubmergeY - submergeOffset
            currentRoot.CFrame = CFrame.new(
                currentRoot.Position.X,
                targetY,
                currentRoot.Position.Z
            ) * currentRoot.CFrame.Rotation
            if submergeBaseplate then
                local platformY = targetY - currentHumanoid.HipHeight - (currentRoot.Size.Y * 0.5) - 0.5
                submergeBaseplate.CFrame = CFrame.new(currentRoot.Position.X, platformY, currentRoot.Position.Z)
            end
            currentRoot.AssemblyLinearVelocity = currentHumanoid.MoveDirection * swimSpeed
        end
    end))

    addConnection(LocalPlayer.CharacterAdded:Connect(function(character)
        -- Always clean up references to the previous character before loading the new one.
        stopSubmerge(false)

        if humanoidDiedConnection then
            humanoidDiedConnection:Disconnect()
            humanoidDiedConnection = nil
        end
        if animationTrack then
            pcall(function() animationTrack:Stop(0) end)
            pcall(function() animationTrack:Destroy() end)
            animationTrack = nil
        end
        if animationStoppedConnection then
            animationStoppedConnection:Disconnect()
            animationStoppedConnection = nil
        end

        local shouldResumeAnimation = animationPlaying
        animationPlaying = false
        task.spawn(function()
            local humanoid = character:WaitForChild("Humanoid", 8)
            if not humanoid or character ~= LocalPlayer.Character then
                animationPlaying = false
                setButtonState(armBtn, armStroke, false, "Arm Animation")
                return
            end

            humanoidDiedConnection = humanoid.Died:Connect(function()
                stopSubmerge(false)
                animationPlaying = false
                if animationTrack then
                    pcall(function() animationTrack:Stop(0) end)
                end
                setButtonState(armBtn, armStroke, false, "Arm Animation")
            end)

            if loadArmAnimation(character) and shouldResumeAnimation then
                animationPlaying = true
                local played = pcall(function() animationTrack:Play(0.15) end)
                if played then
                    setButtonState(armBtn, armStroke, true, "Arm Animation")
                else
                    animationPlaying = false
                    setButtonState(armBtn, armStroke, false, "Arm Animation")
                end
            else
                animationPlaying = false
                setButtonState(armBtn, armStroke, false, "Arm Animation")
            end
        end)
    end))

    cleanupSubmerge = function()
        stopSubmerge(false)
        animationPlaying = false
        if humanoidDiedConnection then
            humanoidDiedConnection:Disconnect()
            humanoidDiedConnection = nil
        end
        if animationStoppedConnection then
            animationStoppedConnection:Disconnect()
            animationStoppedConnection = nil
        end
        if animationTrack then
            pcall(function() animationTrack:Stop(0) end)
            pcall(function() animationTrack:Destroy() end)
            animationTrack = nil
        end
        setButtonState(armBtn, armStroke, false, "Arm Animation")
    end

    loadArmAnimation()
    if currentHumanoid then
        humanoidDiedConnection = currentHumanoid.Died:Connect(function()
            stopSubmerge(false)
            animationPlaying = false
            if animationTrack then
                pcall(function() animationTrack:Stop(0) end)
            end
            setButtonState(armBtn, armStroke, false, "Arm Animation")
        end)
    end
end

--========================================================
-- CHARACTER REFRESH
--========================================================
local function refreshCharacter()
    if refreshingCharacter then return end

    local oldCharacter = LocalPlayer.Character
    local oldRoot = oldCharacter and (
        oldCharacter:FindFirstChild("HumanoidRootPart")
        or oldCharacter:FindFirstChild("Torso")
        or oldCharacter:FindFirstChild("UpperTorso")
    )
    local oldHumanoid = oldCharacter and oldCharacter:FindFirstChildOfClass("Humanoid")

    if not oldCharacter or not oldRoot or not oldHumanoid then
        warn("[TheUnionHub] Refresh failed: character parts not found.")
        return
    end

    local returnCFrame = oldRoot.CFrame
    refreshingCharacter = true
    refreshCharacterGeneration = refreshCharacterGeneration + 1
    local thisRefresh = refreshCharacterGeneration

    if cleanupSubmerge then
        pcall(cleanupSubmerge)
    end

    local characterAddedConnection
    local finished = false

    local function restoreNewCharacter(newCharacter)
        if finished or thisRefresh ~= refreshCharacterGeneration or shuttingDown then return end
        finished = true

        task.spawn(function()
            local newRoot = newCharacter:WaitForChild("HumanoidRootPart", 10)
            local newHumanoid = newCharacter:WaitForChild("Humanoid", 10)

            if newRoot and newHumanoid and newCharacter == LocalPlayer.Character then
                pcall(function()
                    newCharacter:PivotTo(returnCFrame)
                    newRoot.AssemblyLinearVelocity = Vector3.zero
                    newRoot.AssemblyAngularVelocity = Vector3.zero
                end)
            end

            if characterAddedConnection then
                characterAddedConnection:Disconnect()
                characterAddedConnection = nil
            end
            if thisRefresh == refreshCharacterGeneration then refreshingCharacter = false end
        end)
    end

    characterAddedConnection = addConnection(LocalPlayer.CharacterAdded:Connect(restoreNewCharacter))

    local died = pcall(function()
        oldHumanoid.Health = 0
    end)

    if not died then
        if characterAddedConnection then
            characterAddedConnection:Disconnect()
            characterAddedConnection = nil
        end
        refreshingCharacter = false
        return
    end

    task.delay(15, function()
        if not finished and thisRefresh == refreshCharacterGeneration then
            if characterAddedConnection then
                characterAddedConnection:Disconnect()
                characterAddedConnection = nil
            end
            refreshingCharacter = false
        end
    end)
end

--========================================================
-- WINDOW DRAGGING & GLOBAL SHORTCUT KEYBINDS [T, P, Q, M, G]
--========================================================
addConnection(UserInputService.InputBegan:Connect(function(input, processed)
    if processed or UserInputService:GetFocusedTextBox() then return end
    if input.KeyCode == Enum.KeyCode.T then
        gui.Enabled = not gui.Enabled
    elseif input.KeyCode == Enum.KeyCode.P then
        destroyAll()
    elseif input.KeyCode == Enum.KeyCode.Q then
        if toggleFriendESP then
            toggleFriendESP()
        end
    elseif input.KeyCode == Enum.KeyCode.M then
        if toggleSubmerge then
            toggleSubmerge()
        end
    elseif input.KeyCode == Enum.KeyCode.G then
        refreshCharacter()
    end
end))

local minimized = false
minimizeBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    navBar.Visible = not minimized
    for _, content in pairs(tabContents) do content.Visible = false end
    if not minimized then
        tabContents["Main"].Visible = true
        styleButton(tabButtons["Main"], true)
    end
    local targetSize = minimized and UDim2.fromOffset(600, 42) or UDim2.fromOffset(600, 530)
    TweenService:Create(mainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Size = targetSize}):Play()
    minimizeBtn.Text = minimized and "+" or "—"
end)

closeBtn.MouseButton1Click:Connect(destroyAll)

local dragging, dragStart, startPos = false, Vector3.new(), UDim2.new()
local function onInputBegan(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
    end
end
addConnection(header.InputBegan:Connect(onInputBegan))
addConnection(robotHead.InputBegan:Connect(onInputBegan))

addConnection(UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end))
addConnection(UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end))

print("⚡ THEUNION HUB — Core Stability Update loaded. Existing GUI and tabs retained.")
