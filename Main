}

-- Safe HTTP Request Helper
local function httpRequest(options)
    if type(options) ~= "table" or type(options.Url) ~= "string" then
        return nil, "Invalid request options"
    end
    local req = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    local ok, response
    if type(req) == "function" then
        ok, response = pcall(req, options)
    else
        ok, response = pcall(function() return game:HttpGet(options.Url) end)
        if ok and type(response) == "string" then
            response = {Success = true, StatusCode = 200, Body = response}
        end
    end
    if not ok then return nil, tostring(response) end
    if type(response) ~= "table" or type(response.Body) ~= "string" then
        return nil, "Malformed HTTP response"
    end
    return response
end

