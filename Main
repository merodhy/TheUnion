local function createContentButton(parent, text, size, pos, defaultBg)
    local bg = defaultBg or Color3.fromRGB(24, 28, 40)
    local btn = Instance.new("TextButton")
    btn.Size = size
    btn.Position = pos
    btn.BackgroundColor3 = bg
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    btn.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(45, 55, 80)
    stroke.Thickness = 1
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = btn

    return btn, stroke
end

--========================================================
-- GLOBAL DESTROY / KILLSWITCH FUNCTION [KEYBIND P]
--========================================================
destroyAll = function()
    if cleanupSubmerge then
        pcall(cleanupSubmerge)
    end
    for _, conn in ipairs(activeConnections) do
        if conn and typeof(conn) == "RBXScriptConnection" then
            pcall(function() conn:Disconnect() end)
        end
    end
    pcall(function()
        for _, obj in ipairs(Lighting:GetChildren()) do
            if obj.Name:find("Hub") or obj.Name:find("RTX") or obj.Name:find("CustomSky") then
                obj:Destroy()
            end
        end
    end)
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            local hl = p.Character:FindFirstChild("ESPHighlight")
            local fhl = p.Character:FindFirstChild("FriendHighlight")
            if hl then hl:Destroy() end
            if fhl then fhl:Destroy() end
        end
    end
    if gui then
        gui:Destroy()
    end
end

--========================================================
-- MAIN TAB: BRIGHTNESS, ESP, MOVEMENT, EMOTES
--========================================================
do
    local mainScroll = Instance.new("ScrollingFrame")
    mainScroll.Size = UDim2.new(1, 0, 1, -5)
    mainScroll.Position = UDim2.fromOffset(0, 5)
    mainScroll.BackgroundTransparency = 1
    mainScroll.BorderSizePixel = 0
    mainScroll.ScrollBarThickness = 4
    mainScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    mainScroll.CanvasSize = UDim2.new()
    mainScroll.Parent = mainTab

    local mainLayout = Instance.new("UIListLayout")
    mainLayout.Padding = UDim.new(0, 8)
    mainLayout.Parent = mainScroll

    -- 1. Brightness
    local originalLighting = {
        Brightness = Lighting.Brightness,
        ClockTime = Lighting.ClockTime,
        Ambient = Lighting.Ambient,
        OutdoorAmbient = Lighting.OutdoorAmbient,
        GlobalShadows = Lighting.GlobalShadows,
        ExposureCompensation = Lighting.ExposureCompensation
    }
    local brightEnabled = false
    local brightBtn, brightStroke = createContentButton(mainScroll, "Brightness: OFF [L]", UDim2.new(1, -6, 0, 38), UDim2.new(), Color3.fromRGB(28, 33, 46))

    local function toggleBrightness()
        brightEnabled = not brightEnabled
        if brightEnabled then
            Lighting.Brightness = 3
            Lighting.ClockTime = 14
            Lighting.Ambient = Color3.fromRGB(200, 200, 200)
            Lighting.GlobalShadows = false
            brightBtn.Text = "Brightness: ON [L]"
            TweenService:Create(brightBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(35, 140, 85)}):Play()
            TweenService:Create(brightStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(60, 200, 120)}):Play()
        else
            for prop, val in pairs(originalLighting) do pcall(function() Lighting[prop] = val end) end
            brightBtn.Text = "Brightness: OFF [L]"
            TweenService:Create(brightBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(28, 33, 46)}):Play()
            TweenService:Create(brightStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(45, 55, 80)}):Play()
        end
    end
    brightBtn.MouseButton1Click:Connect(toggleBrightness)
    addConnection(UserInputService.InputBegan:Connect(function(input, processed)
        if processed or UserInputService:GetFocusedTextBox() then return end
        if input.KeyCode == Enum.KeyCode.L then toggleBrightness() end
    end))

    -- 2. Player ESPlocal espEnabled = true
    local espObjects = {}

    local function removeESP(player)
        local data = espObjects[player]
        if data then
            if data.Highlight then data.Highlight:Destroy() end
            if data.Billboard then data.Billboard:Destroy() end
            espObjects[player] = nil
        end
    end

    local function createESP(player)
        if player == LocalPlayer then return end
        removeESP(player)
        local char = player.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        local highlight = Instance.new("Highlight")
        highlight.Name = "ESPHighlight"
        highlight.Adornee = char
        highlight.FillColor = Color3.fromRGB(0, 200, 255)
        highlight.OutlineColor = Color3.new(1, 1, 1)
        highlight.FillTransparency = 0.65
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Enabled = espEnabled
        highlight.Parent = char

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "ESPName"
        billboard.Adornee = root
        billboard.Size = UDim2.fromOffset(200, 30)
        billboard.StudsOffset = Vector3.new(0, 3.2, 0)
        billboard.AlwaysOnTop = true
        billboard.Enabled = espEnabled
        billboard.Parent = PlayerGui

        local label = Instance.new("TextLabel")
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.Text = player.DisplayName .. " (@" .. player.Name .. ")"
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.TextStrokeTransparency = 0.2
        label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        label.TextSize = 13
        label.Font = Enum.Font.GothamBold
        label.Parent = billboard

        espObjects[player] = { Highlight = highlight, Billboard = billboard }
    end

    local toggleEspBtn, espStroke = createContentButton(mainScroll, "Player ESP: ON [R]", UDim2.new(1, -6, 0, 38), UDim2.new(), Color3.fromRGB(35, 140, 85))
    TweenService:Create(espStroke, TweenInfo.new(0.01), {Color = Color3.fromRGB(60, 200, 120)}):Play()

    local function toggleESP()
        espEnabled = not espEnabled
        if espEnabled then
            toggleEspBtn.Text = "Player ESP: ON [R]"
            TweenService:Create(toggleEspBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(35, 140, 85)}):Play()
            TweenService:Create(espStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(60, 200, 120)}):Play()
        else
            toggleEspBtn.Text = "Player ESP: OFF [R]"
            TweenService:Create(toggleEspBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(28, 33, 46)}):Play()
            TweenService:Create(espStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(45, 55, 80)}):Play()
        end
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local data = espObjects[p]
                if data then
                    data.Highlight.Enabled = espEnabled
                    data.Billboard.Enabled = espEnabled
                elseif espEnabled then
                    createESP(p)
                end
            end
        end
    end
    toggleEspBtn.MouseButton1Click:Connect(toggleESP)
    addConnection(UserInputService.InputBegan:Connect(function(input, processed)
        if processed or UserInputService:GetFocusedTextBox() then return end
        if input.KeyCode == Enum.KeyCode.R then toggleESP() end
    end))

    local function onCharacterAdded(p)
        task.wait(1)
        if espEnabled then createESP(p) end
    end

    addConnection(Players.PlayerRemoving:Connect(removeESP))

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            addConnection(p.CharacterAdded:Connect(function()
                onCharacterAdded(p)
            end))
            if p.Character then
                task.spawn(function()
                    if espEnabled then createESP(p) end
                end)
            end
        end
    end

    addConnection(Players.PlayerAdded:Connect(function(p)
        if p ~= LocalPlayer then
            addConnection(p.CharacterAdded:Connect(function()
                onCharacterAdded(p)
            end))
        end
    end))

    -- 3. Movement (Fly & Noclip)
    local flying = false
    local flySpeed = 50
    local flyFastSpeed = 100
    local FLY_ANIMATION_IDS = {
        Idle = 84018906210574, -- standing still / idle
        Move = 70647881989417, -- normal movement / walk
        Fast = 121381683064391 -- fast movement / run
    }
    local bodyGyro, bodyVelocity
    local flyTracks = {}
    local currentFlyState = nil
    local flyBtn, flyStroke = createContentButton(mainScroll, "Fly: OFF [F]", UDim2.new(1, -6, 0, 38), UDim2.new(), Color3.fromRGB(28, 33, 46))
    local flyAnimStatus = Instance.new("TextLabel")
    flyAnimStatus.Size = UDim2.new(1, -8, 0, 22)
    flyAnimStatus.BackgroundTransparency = 1
    flyAnimStatus.Text = "Fly animations: custom Idle / Walk / Run IDs"
    flyAnimStatus.TextColor3 = Color3.fromRGB(150, 180, 205)
    flyAnimStatus.Font = Enum.Font.Gotham
    flyAnimStatus.TextSize = 10
    flyAnimStatus.TextXAlignment = Enum.TextXAlignment.Left
    flyAnimStatus.Parent = mainScroll

    -- Use the three animation asset IDs supplied directly by the user.
    local function resolveFlyAnimations()
        return FLY_ANIMATION_IDS
    end

    local function stopFlyAnimations()
        for _, track in pairs(flyTracks) do
            pcall(function() track:Stop(0.15) end)
        end
        table.clear(flyTracks)
        currentFlyState = nil
    end

    local function loadFlyAnimations(humanoid)
        stopFlyAnimations()
        local ids, err = resolveFlyAnimations()
        if not ids then
            flyAnimStatus.Text = "Fly animations unavailable: " .. tostring(err)
            return false
        end

        local animator = humanoid:FindFirstChildOfClass("Animator")
        if not animator then
            animator = Instance.new("Animator")
            animator.Parent = humanoid
        end

        for state, assetId in pairs(ids) do
            local animation = Instance.new("Animation")
            animation.Name = "UnionFly" .. state
            animation.AnimationId = "rbxassetid://" .. tostring(assetId)
            local ok, track = pcall(function()
                return animator:LoadAnimation(animation)
            end)
            if ok and track then
                track.Looped = true
                track.Priority = Enum.AnimationPriority.Action
                flyTracks[state] = track
            end
            animation:Destroy()
        end

        if flyTracks.Idle and flyTracks.Move and flyTracks.Fast then
            flyAnimStatus.Text = "Fly animations loaded: custom Idle / Walk / Run"
            return true
        end
        stopFlyAnimations()
        flyAnimStatus.Text = "Fly animations failed to load (check rig/asset permissions)"
        return false
    end

    local function playFlyState(state)
        if currentFlyState == state then return end
        local nextTrack = flyTracks[state]
        if not nextTrack then return end
        for name, track in pairs(flyTracks) do
            if name ~= state and track.IsPlaying then
                track:Stop(0.15)
            end
        end
        if not nextTrack.IsPlaying then
            nextTrack:Play(0.15, 1, 1)
        end
        currentFlyState = state
    end

    local function toggleFly()
        local char = LocalPlayer.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not root or not hum then return end

        flying = not flying
        if flying then
            loadFlyAnimations(hum)
            hum.PlatformStand = true
            bodyGyro = Instance.new("BodyGyro")
            bodyGyro.Parent = root
            bodyGyro.P = 9e4
            bodyGyro.maxTorque = Vector3.new(9e9, 9e9, 9e9)
            bodyGyro.cframe = root.CFrame

            bodyVelocity = Instance.new("BodyVelocity")
            bodyVelocity.Parent = root
            bodyVelocity.velocity = Vector3.new(0, 0.1, 0)
            bodyVelocity.maxForce = Vector3.new(9e9, 9e9, 9e9)

            task.spawn(function()
                while flying and char and char.Parent and root and root.Parent do
                    local camera = Workspace.CurrentCamera
                    local moveDir = Vector3.new()
                    if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + camera.CFrame.LookVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - camera.CFrame.LookVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - camera.CFrame.RightVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + camera.CFrame.RightVector end
                    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
                    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then moveDir = moveDir - Vector3.new(0, 1, 0) end

                    local isMoving = moveDir.Magnitude > 0.05
                    local isFast = isMoving and UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
                    local speed = isFast and flyFastSpeed or flySpeed
                    bodyGyro.cframe = camera.CFrame
                    bodyVelocity.velocity = moveDir.Magnitude > 0 and moveDir.Unit * speed or Vector3.zero

                    if isFast then
                        playFlyState("Fast")
                    elseif isMoving then
                        playFlyState("Move")
                    else
                        playFlyState("Idle")
                    end
                    RunService.RenderStepped:Wait()
                end
            end)
            flyBtn.Text = "Fly: ON [F] | Ctrl: FAST"
            TweenService:Create(flyBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(35, 140, 85)}):Play()
            TweenService:Create(flyStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(60, 200, 120)}):Play()
        else
            hum.PlatformStand = false
            if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
            if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
            stopFlyAnimations()
            flyBtn.Text = "Fly: OFF [F]"
            TweenService:Create(flyBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(28, 33, 46)}):Play()
            TweenService:Create(flyStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(45, 55, 80)}):Play()
        end
    end
    flyBtn.MouseButton1Click:Connect(toggleFly)

    local noclip = false
    local noclipConn
    local noclipBtn, noclipStroke = createContentButton(mainScroll, "Noclip: OFF [N]", UDim2.new(1, -6, 0, 38), UDim2.new(), Color3.fromRGB(28, 33, 46))

    local function toggleNoclip()
        noclip = not noclip
        if noclip then
            noclipBtn.Text = "Noclip: ON [N]"
            TweenService:Create(noclipBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(35, 140, 85)}):Play()
            TweenService:Create(noclipStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(60, 200, 120)}):Play()
            noclipConn = addConnection(RunService.Stepped:Connect(function()
                if noclip and LocalPlayer.Character then
                    for _, v in ipairs(LocalPlayer.Character:GetDescendants()) do
                        if v:IsA("BasePart") then v.CanCollide = false end
                    end
                end
            end))
        else
            noclipBtn.Text = "Noclip: OFF [N]"
            TweenService:Create(noclipBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(28, 33, 46)}):Play()
            TweenService:Create(noclipStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(45, 55, 80)}):Play()
            if noclipConn then noclipConn:Disconnect() noclipConn = nil end
        end
    end
    noclipBtn.MouseButton1Click:Connect(toggleNoclip)

    addConnection(UserInputService.InputBegan:Connect(function(input, processed)
        if processed or UserInputService:GetFocusedTextBox() then return end
        if input.KeyCode == Enum.KeyCode.F then toggleFly()
        elseif input.KeyCode == Enum.KeyCode.N then toggleNoclip() end
    end))

    -- 4. Emotes Hub
    local emotesLoaded = false
    local loadEmotesBtn = createContentButton(mainScroll, "Load Emote Hub", UDim2.new(1, -6, 0, 38), UDim2.new(), Color3.fromRGB(35, 75, 130))
    loadEmotesBtn.MouseButton1Click:Connect(function()
        if not emotesLoaded then
            emotesLoaded = true
            loadEmotesBtn.Text = "Emote Hub Loaded ✓"
            task.spawn(function()
                pcall(function()
                    loadstring(game:HttpGet("https://raw.githubusercontent.com/7yd7/Hub/refs/heads/Branch/GUIS/Emotes.lua"))()
                end)
            end)
        end
    end)


    -- 5. Anti-Fling (client-side movement protection)
    local antiFlingEnabled = false
    local antiFlingThreshold = 120 -- studs/second; lower values may interfere with fast movement
    local antiFlingConn
    local antiFlingBtn, antiFlingStroke = createContentButton(
        mainScroll, "Anti-Fling: OFF", UDim2.new(1, -6, 0, 38), UDim2.new(), Color3.fromRGB(28, 33, 46)
    )

    local function setToggleStyle(button, stroke, enabled, label)
        button.Text = label .. (enabled and ": ON" or ": OFF")
        local bg = enabled and Color3.fromRGB(35, 140, 85) or Color3.fromRGB(28, 33, 46)
        local outline = enabled and Color3.fromRGB(60, 200, 120) or Color3.fromRGB(45, 55, 80)
        TweenService:Create(button, TweenInfo.new(0.2), {BackgroundColor3 = bg}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.2), {Color = outline}):Play()
    end

    local function toggleAntiFling()
        antiFlingEnabled = not antiFlingEnabled
        if antiFlingEnabled then
            antiFlingConn = addConnection(RunService.Heartbeat:Connect(function()
                local character = LocalPlayer.Character
                local root = character and character:FindFirstChild("HumanoidRootPart")
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                if not root or not humanoid or humanoid.Health <= 0 then return end

                local velocity = root.AssemblyLinearVelocity
                if velocity.Magnitude > antiFlingThreshold then
                    -- Reduce extreme linear impulses and stop rapid spin without anchoring the character.
                    local horizontal = Vector3.new(velocity.X, 0, velocity.Z) * 0.15
                    local vertical = math.clamp(velocity.Y, -45, 45)
                    root.AssemblyLinearVelocity = Vector3.new(horizontal.X, vertical, horizontal.Z)
                    root.AssemblyAngularVelocity = Vector3.zero
                end
            end))
        elseif antiFlingConn then
            antiFlingConn:Disconnect()
            antiFlingConn = nil
        end
        setToggleStyle(antiFlingBtn, antiFlingStroke, antiFlingEnabled, "Anti-Fling")
    end
    antiFlingBtn.MouseButton1Click:Connect(toggleAntiFling)

    -- 6. Anti-AFK (uses Roblox's idle event; does not continuously spam input)
    local antiAFKEnabled = false
    local antiAFKConn
    local antiAFKBtn, antiAFKStroke = createContentButton(
        mainScroll, "Anti-AFK: OFF", UDim2.new(1, -6, 0, 38), UDim2.new(), Color3.fromRGB(28, 33, 46)
    )

    local function toggleAntiAFK()
        antiAFKEnabled = not antiAFKEnabled
        if antiAFKEnabled then
            antiAFKConn = addConnection(LocalPlayer.Idled:Connect(function()
                if not antiAFKEnabled then return end
                pcall(function()
                    VirtualUser:CaptureController()
                    VirtualUser:ClickButton2(Vector2.new(0, 0))
                end)
            end))
        elseif antiAFKConn then
            antiAFKConn:Disconnect()
            antiAFKConn = nil
        end
        setToggleStyle(antiAFKBtn, antiAFKStroke, antiAFKEnabled, "Anti-AFK")
    end
    antiAFKBtn.MouseButton1Click:Connect(toggleAntiAFK)
end

--========================================================
-- MODULE 2: FRIENDS TAB
--========================================================
do
    local friendEspEnabled = true
    local friendEspObjects = {}
    local selectedFriend = nil
    local friendSpectating = false

    local headerStatus = Instance.new("TextLabel")
    headerStatus.Size = UDim2.new(1, 0, 0, 24)
    headerStatus.Position = UDim2.fromOffset(0, 4)
    headerStatus.BackgroundTransparency = 1
    headerStatus.Text = "Friends in Server: 0"
    headerStatus.TextColor3 = Color3.fromRGB(0, 220, 255)
    headerStatus.Font = Enum.Font.GothamBold
    headerStatus.TextSize = 13
    headerStatus.Parent = friendsTab

    local toggleFriendEspBtn, friendEspStroke = createContentButton(friendsTab, "Friend ESP: ON [Q]", UDim2.new(1, 0, 0, 34), UDim2.fromOffset(0, 32), Color3.fromRGB(35, 140, 85))
    TweenService:Create(friendEspStroke, TweenInfo.new(0.01), {Color = Color3.fromRGB(60, 200, 120)}):Play()

    local friendListFrame = Instance.new("ScrollingFrame")
    friendListFrame.Size = UDim2.new(1, 0, 1, -118)
    friendListFrame.Position = UDim2.fromOffset(0, 72)
    friendListFrame.BackgroundColor3 = Color3.fromRGB(16, 20, 28)
    friendListFrame.BorderSizePixel = 0
    friendListFrame.ScrollBarThickness = 4
    friendListFrame.CanvasSize = UDim2.new()
    friendListFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
    friendListFrame.Parent = friendsTab
    Instance.new("UICorner", friendListFrame).CornerRadius = UDim.new(0, 6)
    local friendListLayout = Instance.new("UIListLayout", friendListFrame)
    friendListLayout.Padding = UDim.new(0, 4)

    local specFriendBtn = createContentButton(friendsTab, "Spectate Friend", UDim2.new(0.5, -3, 0, 36), UDim2.new(0, 0, 1, -38), Color3.fromRGB(28, 33, 46))
    local tpFriendBtn = createContentButton(friendsTab, "Teleport to Friend", UDim2.new(0.5, -3, 0, 36), UDim2.new(0.5, 3, 1, -38), Color3.fromRGB(35, 75, 130))

    local function removeFriendESP(player)
        local data = friendEspObjects[player]
        if data then
            if data.Highlight then data.Highlight:Destroy() end
            if data.Billboard then data.Billboard:Destroy() end
            friendEspObjects[player] = nil
        end
    end

    local function createFriendESP(player)
        removeFriendESP(player)
        if not friendEspEnabled then return end
        local char = player.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        local highlight = Instance.new("Highlight")
        highlight.Name = "FriendHighlight"
        highlight.Adornee = char
        highlight.FillColor = Color3.fromRGB(255, 215, 0)
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.4
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Enabled = friendEspEnabled
        highlight.Parent = char

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "FriendESPName"
        billboard.Adornee = root
        billboard.Size = UDim2.fromOffset(200, 30)
        billboard.StudsOffset = Vector3.new(0, 3.2, 0)
        billboard.AlwaysOnTop = true
        billboard.Enabled = friendEspEnabled
        billboard.Parent = PlayerGui

        local label = Instance.new("TextLabel")
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.Text = "⭐ [FRIEND] " .. player.DisplayName
        label.TextColor3 = Color3.fromRGB(255, 225, 100)
        label.TextStrokeTransparency = 0.2
        label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        label.TextSize = 13
        label.Font = Enum.Font.GothamBold
        label.Parent = billboard

        friendEspObjects[player] = { Highlight = highlight, Billboard = billboard }
    end

    local function playFriendJoinSound()
        local joinSound = Instance.new("Sound")
        joinSound.SoundId = "rbxassetid://4590662766"
        joinSound.Volume = 1
        joinSound.Parent = SoundService
        joinSound:Play()
        task.delay(3, function() joinSound:Destroy() end)
    end

    local function notifyFriendJoin(player)
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "⭐ Friend Joined!",
                Text = player.DisplayName .. " (@" .. player.Name .. ") joined the game.",
                Duration = 5,
            })
        end)
        playFriendJoinSound()
    end

    local function refreshFriendsList()
        for _, child in ipairs(friendListFrame:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end

        local count = 0
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local isFriend = false
                pcall(function()
                    isFriend = p:IsFriendsWith(LocalPlayer.UserId)
                end)

                if isFriend then
                    count = count + 1
                    if friendEspEnabled then
                        createFriendESP(p)
                    else
                        removeFriendESP(p)
                    end

                    local btn = createContentButton(friendListFrame, "⭐ " .. p.DisplayName .. " (@" .. p.Name .. ")", UDim2.new(1, -6, 0, 32), UDim2.new(), Color3.fromRGB(24, 29, 42))
                    if selectedFriend == p then
                        btn.BackgroundColor3 = Color3.fromRGB(0, 120, 200)
                    end
                    btn.MouseButton1Click:Connect(function()
                        selectedFriend = p
                        headerStatus.Text = "Selected Friend: " .. p.Name
                        refreshFriendsList()
                    end)
                else
                    removeFriendESP(p)
                end
            end
        end

        badgeText.Text = tostring(count)
        headerStatus.Text = "Friends in Server: " .. count
    end

    toggleFriendESP = function()
        friendEspEnabled = not friendEspEnabled
        if friendEspEnabled then
            toggleFriendEspBtn.Text = "Friend ESP: ON [Q]"
            TweenService:Create(toggleFriendEspBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(35, 140, 85)}):Play()
            TweenService:Create(friendEspStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(60, 200, 120)}):Play()
        else
            toggleFriendEspBtn.Text = "Friend ESP: OFF [Q]"
            TweenService:Create(toggleFriendEspBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(28, 33, 46)}):Play()
            TweenService:Create(friendEspStroke, TweenInfo.new(0.2), {Color = Color3.fromRGB(45, 55, 80)}):Play()
            for p, _ in pairs(friendEspObjects) do
                removeFriendESP(p)
            end
        end
        refreshFriendsList()
    end

    toggleFriendEspBtn.MouseButton1Click:Connect(toggleFriendESP)

    specFriendBtn.MouseButton1Click:Connect(function()
        local camera = Workspace.CurrentCamera
        if not friendSpectating then
            if selectedFriend and selectedFriend.Character and selectedFriend.Character:FindFirstChildOfClass("Humanoid") then
                camera.CameraSubject = selectedFriend.Character:FindFirstChildOfClass("Humanoid")
                friendSpectating = true
                specFriendBtn.Text = "Stop Spectating"
                headerStatus.Text = "Watching Friend: " .. selectedFriend.Name
            else
                headerStatus.Text = "Select a valid friend first!"
            end
        else
            friendSpectating = false
            specFriendBtn.Text = "Spectate Friend"
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
                camera.CameraSubject = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            end
            headerStatus.Text = "Spectating stopped"
        end
    end)

    tpFriendBtn.MouseButton1Click:Connect(function()
        if selectedFriend and selectedFriend.Character then
            local targetRoot = selectedFriend.Character:FindFirstChild("HumanoidRootPart")
            local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if targetRoot and localRoot then
                localRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3)
                headerStatus.Text = "Teleported to " .. selectedFriend.Name
            else
                headerStatus.Text = "Friend position unavailable!"
            end
        else
            headerStatus.Text = "Select a friend to teleport!"
        end
    end)

    addConnection(Players.PlayerAdded:Connect(function(p)
        local isFriend = false
        pcall(function()
            isFriend = p:IsFriendsWith(LocalPlayer.UserId)
        end)
        if isFriend then
            notifyFriendJoin(p)
        end
        refreshFriendsList()
    end))

    addConnection(Players.PlayerRemoving:Connect(function(p)
        if p == selectedFriend then selectedFriend = nil end
        removeFriendESP(p)
        refreshFriendsList()
    end))

    task.spawn(function()
        while gui and gui.Parent do
            refreshFriendsList()
            task.wait(5)
        end
    end)
end

--========================================================
-- MODULE 2.5: SERVERS TAB (SERVER BROWSER & FRIEND DETECTOR)
--========================================================
do
    local serverHeaderStatus = Instance.new("TextLabel")
    serverHeaderStatus.Size = UDim2.new(1, -100, 0, 24)
    serverHeaderStatus.Position = UDim2.fromOffset(0, 4)
    serverHeaderStatus.BackgroundTransparency = 1
    serverHeaderStatus.Text = "Public Server Browser"
    serverHeaderStatus.TextColor3 = Color3.fromRGB(0, 220, 255)
    serverHeaderStatus.Font = Enum.Font.GothamBold
    serverHeaderStatus.TextSize = 13
    serverHeaderStatus.TextXAlignment = Enum.TextXAlignment.Left
    serverHeaderStatus.Parent = serversTab

    local refreshServersBtn = createContentButton(serversTab, "🔄 Refresh", UDim2.fromOffset(90, 26), UDim2.new(1, -90, 0, 3), Color3.fromRGB(35, 75, 130))

    local serverListFrame = Instance.new("ScrollingFrame")
    serverListFrame.Size = UDim2.new(1, 0, 1, -40)
    serverListFrame.Position = UDim2.fromOffset(0, 36)
    serverListFrame.BackgroundColor3 = Color3.fromRGB(16, 20, 28)
    serverListFrame.BorderSizePixel = 0
    serverListFrame.ScrollBarThickness = 4
    serverListFrame.CanvasSize = UDim2.new()
    serverListFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
    serverListFrame.Parent = serversTab
    Instance.new("UICorner", serverListFrame).CornerRadius = UDim.new(0, 6)

    local serverListLayout = Instance.new("UIListLayout", serverListFrame)
    serverListLayout.Padding = UDim.new(0, 6)

    local friendIds = {}
    local function cacheFriends()
        friendIds = {}
        pcall(function()
            local pages = Players:GetFriendsAsync(LocalPlayer.UserId)
            while true do
                for _, item in ipairs(pages:GetCurrentPage()) do
                    friendIds[item.Id] = true
                end
                if pages.IsFinished then break end
                pages:AdvanceToNextPageAsync()
            end
        end)
    end
    task.spawn(cacheFriends)

    local function fetchServers()
        for _, child in ipairs(serverListFrame:GetChildren()) do
            if child:IsA("Frame") then child:Destroy() end
        end

        serverHeaderStatus.Text = "Fetching servers..."

        task.spawn(function()
            local totalFriendsInServers = 0
            local placeId = game.PlaceId
            local url = "https://games.roblox.com/v1/games/" .. tostring(placeId) .. "/servers/Public?limit=50&sortOrder=Desc"
            
            local res = httpRequest({Url = url, Method = "GET"})
            local bodyData = nil

            if res and res.Body then
                pcall(function() bodyData = HttpService:JSONDecode(res.Body) end)
            end

            if not bodyData or not bodyData.data then
                serverHeaderStatus.Text = "Failed to load servers."
                return
            end

            local servers = bodyData.data
            serverHeaderStatus.Text = "Found " .. tostring(#servers) .. " Servers"

            for idx, serverData in ipairs(servers) do
                local serverFrame = Instance.new("Frame")
                serverFrame.Size = UDim2.new(1, -6, 0, 42)
                serverFrame.BackgroundColor3 = Color3.fromRGB(24, 29, 42)
                serverFrame.BorderSizePixel = 0
                serverFrame.Parent = serverListFrame

                Instance.new("UICorner", serverFrame).CornerRadius = UDim.new(0, 6)
                local sfStroke = Instance.new("UIStroke", serverFrame)
                sfStroke.Color = Color3.fromRGB(40, 50, 70)
                sfStroke.Thickness = 1

                local friendsInThisServer = 0
                if serverData.players then
                    for _, pData in ipairs(serverData.players) do
                        if pData.id and friendIds[pData.id] then
                            friendsInThisServer = friendsInThisServer + 1
                        end
                    end
                end

                totalFriendsInServers = totalFriendsInServers + friendsInThisServer

                local infoLabel = Instance.new("TextLabel")
                infoLabel.Size = UDim2.new(1, -120, 1, 0)
                infoLabel.Position = UDim2.fromOffset(10, 0)
                infoLabel.BackgroundTransparency = 1
                infoLabel.Text = "Server #" .. tostring(idx) .. "  |  👤 " .. tostring(serverData.playing) .. "/" .. tostring(serverData.maxPlayers) .. "  |  ⚡ " .. tostring(serverData.ping or "N/A") .. "ms"
                infoLabel.TextColor3 = Color3.fromRGB(220, 230, 245)
                infoLabel.Font = Enum.Font.GothamSemibold
                infoLabel.TextSize = 11
                infoLabel.TextXAlignment = Enum.TextXAlignment.Left
                infoLabel.Parent = serverFrame

                if friendsInThisServer > 0 then
                    local sBadgeFrame = Instance.new("Frame")
                    sBadgeFrame.Size = UDim2.fromOffset(20, 20)
                    sBadgeFrame.Position = UDim2.new(1, -135, 0.5, -10)
                    sBadgeFrame.BackgroundColor3 = Color3.fromRGB(0, 200, 255)
                    sBadgeFrame.BorderSizePixel = 0
                    sBadgeFrame.Parent = serverFrame

                    Instance.new("UICorner", sBadgeFrame).CornerRadius = UDim.new(1, 0)
                    local sBadgeStroke = Instance.new("UIStroke", sBadgeFrame)
                    sBadgeStroke.Color = Color3.fromRGB(255, 255, 255)
                    sBadgeStroke.Thickness = 1.5

                    local sBadgeLbl = Instance.new("TextLabel")
                    sBadgeLbl.Size = UDim2.fromScale(1, 1)
                    sBadgeLbl.BackgroundTransparency = 1
                    sBadgeLbl.Text = tostring(friendsInThisServer)
                    sBadgeLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
                    sBadgeLbl.Font = Enum.Font.GothamBold
                    sBadgeLbl.TextSize = 10
                    sBadgeLbl.Parent = sBadgeFrame
                end

                local joinBtn = Instance.new("TextButton")
                joinBtn.Size = UDim2.fromOffset(80, 26)
                joinBtn.Position = UDim2.new(1, -90, 0.5, -13)
                joinBtn.BackgroundColor3 = (serverData.id == game.JobId) and Color3.fromRGB(40, 50, 65) or Color3.fromRGB(0, 150, 90)
                joinBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                joinBtn.Text = (serverData.id == game.JobId) and "Current" or "Join"
                joinBtn.Font = Enum.Font.GothamBold
                joinBtn.TextSize = 11
                joinBtn.BorderSizePixel = 0
                joinBtn.AutoButtonColor = false
                joinBtn.Parent = serverFrame

                Instance.new("UICorner", joinBtn).CornerRadius = UDim.new(0, 5)

                if serverData.id ~= game.JobId then
                    joinBtn.MouseButton1Click:Connect(function()
                        joinBtn.Text = "Joining..."
                        TeleportService:TeleportToPlaceInstance(placeId, serverData.id, LocalPlayer)
                    end)
                end
            end

            if totalFriendsInServers > 0 then
                serverBadgeText.Text = tostring(totalFriendsInServers)
                serverBadgeFrame.Visible = true
            else
                serverBadgeFrame.Visible = false
            end
        end)
    end

    refreshServersBtn.MouseButton1Click:Connect(fetchServers)
    task.spawn(fetchServers)
end

--========================================================
-- MODULE 2.8: ADVANCED PLAYER SEARCH TAB & DETAIL INSPECTOR
--========================================================
do
    local searchInput = Instance.new("TextBox")
    searchInput.Size = UDim2.new(1, -95, 0, 32)
    searchInput.Position = UDim2.fromOffset(0, 4)
    searchInput.BackgroundColor3 = Color3.fromRGB(18, 22, 32)
    searchInput.TextColor3 = Color3.fromRGB(255, 255, 255)
    searchInput.PlaceholderText = "Search by Username or Display Name..."
    searchInput.Text = ""
    searchInput.Font = Enum.Font.Gotham
    searchInput.TextSize = 12
    searchInput.BorderSizePixel = 0
    searchInput.Parent = searchTab
    Instance.new("UICorner", searchInput).CornerRadius = UDim.new(0, 6)

    local searchSubmitBtn = createContentButton(searchTab, "🔍 Search", UDim2.fromOffset(90, 32), UDim2.new(1, -90, 0, 4), Color3.fromRGB(0, 140, 200))

    local resultsContainer = Instance.new("Frame")
    resultsContainer.Size = UDim2.new(1, 0, 1, -42)
    resultsContainer.Position = UDim2.fromOffset(0, 42)
    resultsContainer.BackgroundTransparency = 1
    resultsContainer.Parent = searchTab

    local function createScrollingFrame(parent)
        local sf = Instance.new("ScrollingFrame")
        sf.Size = UDim2.new(1, 0, 1, 0)
        sf.BackgroundTransparency = 1
        sf.BorderSizePixel = 0
        sf.ScrollBarThickness = 4
        sf.AutomaticCanvasSize = Enum.AutomaticSize.Y
        sf.CanvasSize = UDim2.new()
        sf.Parent = parent
        Instance.new("UIListLayout", sf).Padding = UDim.new(0, 6)
        return sf
    end

    local searchScroll = createScrollingFrame(resultsContainer)

    local function showPlayerDetails(targetUserId)
        searchScroll:ClearAllChildren()
        Instance.new("UIListLayout", searchScroll).Padding = UDim.new(0, 6)

        local loadingLabel = Instance.new("TextLabel")
        loadingLabel.Size = UDim2.new(1, -6, 0, 40)
        loadingLabel.BackgroundTransparency = 1
        loadingLabel.Text = "⚡ Loading Full Player Profile & Robux Value..."
        loadingLabel.TextColor3 = Color3.fromRGB(0, 200, 255)
        loadingLabel.Font = Enum.Font.GothamBold
        loadingLabel.TextSize = 12
        loadingLabel.Parent = searchScroll

        task.spawn(function()
            local targetPlayerObj = Players:GetPlayerByUserId(targetUserId)
            local isTargetInServer = targetPlayerObj ~= nil

            -- 1. User Info & Bio
            local userUrl = "https://users.roblox.com/v1/users/" .. tostring(targetUserId)
            local userRes = httpRequest({Url = userUrl, Method = "GET"})
            local userData = userRes and HttpService:JSONDecode(userRes.Body) or {}

            -- 2. Online Status via Presence API
            local onlineStatusText = "⚪ Offline"
            local presenceUrl = "https://presence.roblox.com/v1/presence/users"
            local presenceRes = httpRequest({
                Url = presenceUrl,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode({ userIds = { targetUserId } })
            })
            if presenceRes and presenceRes.Body then
                local pData = HttpService:JSONDecode(presenceRes.Body)
                if pData and pData.userPresences and pData.userPresences[1] then
                    local typeVal = pData.userPresences[1].userPresenceType
                    if typeVal == 1 then
                        onlineStatusText = "🟢 Online (Website)"
                    elseif typeVal == 2 then
                        onlineStatusText = "🟢 In Game"
                    elseif typeVal == 3 then
                        onlineStatusText = "🟢 In Studio"
                    end
                end
            end

            -- 3. Currently Wearing & Correct Robux Value via Catalog Items Details POST API
            local wearUrl = "https://avatar.roblox.com/v1/users/" .. tostring(targetUserId) .. "/currently-wearing"
            local wearRes = httpRequest({Url = wearUrl, Method = "GET"})
            local wearData = wearRes and HttpService:JSONDecode(wearRes.Body) or { assetIds = {} }
            local assetIds = wearData.assetIds or {}

            local totalRobux = 0
            local itemNames = {}
            if #assetIds > 0 then
                local catalogUrl = "https://catalog.roblox.com/v1/catalog/items/details"
                local itemsPayload = { items = {} }
                for _, id in ipairs(assetIds) do
                    table.insert(itemsPayload.items, { itemType = "Asset", id = id })
                end

                local catalogRes = httpRequest({
                    Url = catalogUrl,
                    Method = "POST",
                    Headers = { ["Content-Type"] = "application/json" },
                    Body = HttpService:JSONEncode(itemsPayload)
                })

                if catalogRes and catalogRes.Body then
                    local catalogJson = HttpService:JSONDecode(catalogRes.Body)
                    if catalogJson and catalogJson.data then
                        for _, item in ipairs(catalogJson.data) do
                            local price = item.price or (item.lowestPrice and item.lowestPrice) or 0
                            totalRobux = totalRobux + price
                            table.insert(itemNames, (item.name or "Asset") .. " (" .. tostring(price) .. " R$)")
                        end
                    end
                end
            end

            -- 4. Friends Count & Mutual Friends
            local friendsCount = 0
            local fCountUrl = "https://friends.roblox.com/v1/users/" .. tostring(targetUserId) .. "/friends/count"
            local fCountRes = httpRequest({Url = fCountUrl, Method = "GET"})
            if fCountRes then
                local fCountData = HttpService:JSONDecode(fCountRes.Body)
                friendsCount = fCountData and fCountData.count or 0
            end

            local mutualFriends = {}
            pcall(function()
                local targetFriendsPages = Players:GetFriendsAsync(targetUserId)
                local localFriendsPages = Players:GetFriendsAsync(LocalPlayer.UserId)
                local localFriendSet = {}
                while true do
                    for _, f in ipairs(localFriendsPages:GetCurrentPage()) do localFriendSet[f.Id] = f.DisplayName end
                    if localFriendsPages.IsFinished then break end
                    localFriendsPages:AdvanceToNextPageAsync()
                end
                while true do
                    for _, f in ipairs(targetFriendsPages:GetCurrentPage()) do
                        if localFriendSet[f.Id] then
                            table.insert(mutualFriends, f.DisplayName .. " (@" .. f.Username .. ")")
                        end
                    end
                    if targetFriendsPages.IsFinished then break end
                    targetFriendsPages:AdvanceToNextPageAsync()
                end
            end)

            searchScroll:ClearAllChildren()
            Instance.new("UIListLayout", searchScroll).Padding = UDim.new(0, 6)

            -- Header Profile Card
            local profileCard = Instance.new("Frame")
            profileCard.Size = UDim2.new(1, -6, 0, 110)
            profileCard.BackgroundColor3 = Color3.fromRGB(20, 25, 38)
            profileCard.Parent = searchScroll
            Instance.new("UICorner", profileCard).CornerRadius = UDim.new(0, 8)
            local pcStroke = Instance.new("UIStroke", profileCard)
            pcStroke.Color = Color3.fromRGB(0, 180, 255)
            pcStroke.Thickness = 1.2

            local avatarImg = Instance.new("ImageLabel")
            avatarImg.Size = UDim2.fromOffset(80, 80)
            avatarImg.Position = UDim2.fromOffset(8, 15)
            avatarImg.BackgroundColor3 = Color3.fromRGB(12, 15, 22)
            avatarImg.Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(targetUserId) .. "&w=150&h=150"
            avatarImg.Parent = profileCard
            Instance.new("UICorner", avatarImg).CornerRadius = UDim.new(0, 6)

            local nameLabel = Instance.new("TextLabel")
            nameLabel.Size = UDim2.new(1, -95, 0, 18)
            nameLabel.Position = UDim2.fromOffset(95, 6)
            nameLabel.BackgroundTransparency = 1
            nameLabel.Text = (userData.displayName or "User") .. " (@" .. (userData.name or "Name") .. ")"
            nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            nameLabel.Font = Enum.Font.GothamBold
            nameLabel.TextSize = 12
            nameLabel.TextXAlignment = Enum.TextXAlignment.Left
            nameLabel.Parent = profileCard

            local statusLabel = Instance.new("TextLabel")
            statusLabel.Size = UDim2.new(1, -95, 0, 16)
            statusLabel.Position = UDim2.fromOffset(95, 24)
            statusLabel.BackgroundTransparency = 1
            statusLabel.Text = "Status: " .. onlineStatusText
            statusLabel.TextColor3 = Color3.fromRGB(0, 230, 255)
            statusLabel.Font = Enum.Font.GothamSemibold
            statusLabel.TextSize = 10
            statusLabel.TextXAlignment = Enum.TextXAlignment.Left
            statusLabel.Parent = profileCard

            local robuxLabel = Instance.new("TextLabel")
            robuxLabel.Size = UDim2.new(1, -95, 0, 16)
            robuxLabel.Position = UDim2.fromOffset(95, 42)
            robuxLabel.BackgroundTransparency = 1
            robuxLabel.Text = "💎 Outfit Value: " .. tostring(totalRobux) .. " Robux"
            robuxLabel.TextColor3 = Color3.fromRGB(0, 230, 140)
            robuxLabel.Font = Enum.Font.GothamBold
            robuxLabel.TextSize = 10
            robuxLabel.TextXAlignment = Enum.TextXAlignment.Left
            robuxLabel.Parent = profileCard

            local friendStatsLbl = Instance.new("TextLabel")
            friendStatsLbl.Size = UDim2.new(1, -95, 0, 16)
            friendStatsLbl.Position = UDim2.fromOffset(95, 60)
            friendStatsLbl.BackgroundTransparency = 1
            friendStatsLbl.Text = "👥 Friends: " .. tostring(friendsCount) .. " | ⭐ Mutual: " .. tostring(#mutualFriends)
            friendStatsLbl.TextColor3 = Color3.fromRGB(200, 220, 255)
            friendStatsLbl.Font = Enum.Font.GothamSemibold
            friendStatsLbl.TextSize = 10
            friendStatsLbl.TextXAlignment = Enum.TextXAlignment.Left
            friendStatsLbl.Parent = profileCard

            local joinMapBtn = Instance.new("TextButton")
            joinMapBtn.Size = UDim2.new(1, -100, 0, 24)
            joinMapBtn.Position = UDim2.fromOffset(95, 79)
            joinMapBtn.BackgroundColor3 = isTargetInServer and Color3.fromRGB(0, 140, 200) or Color3.fromRGB(35, 75, 130)
            joinMapBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            joinMapBtn.Text = isTargetInServer and "🟢 Teleport to Player in Server" or "🚀 Join Player Map Server"
            joinMapBtn.Font = Enum.Font.GothamBold
            joinMapBtn.TextSize = 10
            joinMapBtn.BorderSizePixel = 0
            joinMapBtn.Parent = profileCard
            Instance.new("UICorner", joinMapBtn).CornerRadius = UDim.new(0, 4)

            joinMapBtn.MouseButton1Click:Connect(function()
                if isTargetInServer and targetPlayerObj.Character then
                    local tRoot = targetPlayerObj.Character:FindFirstChild("HumanoidRootPart")
                    local lRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if tRoot and lRoot then lRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3) end
                else
                    joinMapBtn.Text = "Attempting Join..."
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
                end
            end)

            -- Bio / Description Box
            local bioBox = Instance.new("TextLabel")
            bioBox.Size = UDim2.new(1, -6, 0, 60)
            bioBox.BackgroundColor3 = Color3.fromRGB(16, 20, 28)
            bioBox.Text = "📝 Description: " .. (userData.description ~= "" and userData.description or "No description provided.")
            bioBox.TextColor3 = Color3.fromRGB(180, 190, 210)
            bioBox.Font = Enum.Font.Gotham
            bioBox.TextSize = 10
            bioBox.TextWrapped = true
            bioBox.TextYAlignment = Enum.TextYAlignment.Top
            bioBox.TextXAlignment = Enum.TextXAlignment.Left
            bioBox.Parent = searchScroll
            Instance.new("UICorner", bioBox).CornerRadius = UDim.new(0, 6)
            local bioPad = Instance.new("UIPadding", bioBox)
            bioPad.PaddingTop = UDim.new(0, 6) bioPad.PaddingLeft = UDim.new(0, 6) bioPad.PaddingRight = UDim.new(0, 6)

            -- Wearing List
            local wearHeader = Instance.new("TextLabel")
            wearHeader.Size = UDim2.new(1, 0, 0, 18)
            wearHeader.BackgroundTransparency = 1
            wearHeader.Text = "👕 Currently Wearing Items (" .. tostring(#itemNames) .. "):"
            wearHeader.TextColor3 = Color3.fromRGB(0, 200, 255)
            wearHeader.Font = Enum.Font.GothamBold
            wearHeader.TextSize = 11
            wearHeader.TextXAlignment = Enum.TextXAlignment.Left
            wearHeader.Parent = searchScroll

            for _, itemName in ipairs(itemNames) do
                local itemLbl = Instance.new("TextLabel")
                itemLbl.Size = UDim2.new(1, -6, 0, 20)
                itemLbl.BackgroundColor3 = Color3.fromRGB(24, 28, 40)
                itemLbl.Text = " • " .. itemName
                itemLbl.TextColor3 = Color3.fromRGB(220, 230, 245)
                itemLbl.Font = Enum.Font.Gotham
                itemLbl.TextSize = 10
                itemLbl.TextXAlignment = Enum.TextXAlignment.Left
                itemLbl.Parent = searchScroll
                Instance.new("UICorner", itemLbl).CornerRadius = UDim.new(0, 4)
            end
        end)
    end

    local function executeSearch()
        local query = searchInput.Text:lower():gsub("%s+", "")
        if query == "" then return end

        searchScroll:ClearAllChildren()
        Instance.new("UIListLayout", searchScroll).Padding = UDim.new(0, 6)

        local status = Instance.new("TextLabel")
        status.Size = UDim2.new(1, -6, 0, 30)
        status.BackgroundTransparency = 1
        status.Text = "Searching for '" .. query .. "'..."
        status.TextColor3 = Color3.fromRGB(0, 200, 255)
        status.Font = Enum.Font.GothamBold
        status.TextSize = 11
        status.Parent = searchScroll

        task.spawn(function()
            local targetUserId = nil
            local idSuccess, idResult = pcall(function() return Players:GetUserIdFromNameAsync(searchInput.Text) end)
            if idSuccess and idResult then
                targetUserId = idResult
            end

            local results = {}
            if targetUserId then
                local userUrl = "https://users.roblox.com/v1/users/" .. tostring(targetUserId)
                local res = httpRequest({Url = userUrl, Method = "GET"})
                if res and res.Body then
                    local data = HttpService:JSONDecode(res.Body)
                    if data and data.id then
                        table.insert(results, { id = data.id, name = data.name, displayName = data.displayName })
                    end
                end
            end

            if #results == 0 then
                local searchUrl = "https://users.roblox.com/v1/users/search?keyword=" .. query .. "&limit=10"
                local res = httpRequest({Url = searchUrl, Method = "GET"})
                local searchData = res and HttpService:JSONDecode(res.Body) or { data = {} }
                results = searchData.data or {}
            end

            searchScroll:ClearAllChildren()
            Instance.new("UIListLayout", searchScroll).Padding = UDim.new(0, 6)

            if #results == 0 then
                status.Text = "No players found matching '" .. query .. "'."
                status.Parent = searchScroll
                return
            end

            if #results == 1 then
                showPlayerDetails(results[1].id)
                return
            end

            for _, pData in ipairs(results) do
                local card = Instance.new("Frame")
                card.Size = UDim2.new(1, -6, 0, 48)
                card.BackgroundColor3 = Color3.fromRGB(24, 29, 42)
                card.Parent = searchScroll
                Instance.new("UICorner", card).CornerRadius = UDim.new(0, 6)

                local headshot = Instance.new("ImageLabel")
                headshot.Size = UDim2.fromOffset(38, 38)
                headshot.Position = UDim2.fromOffset(5, 5)
                headshot.BackgroundColor3 = Color3.fromRGB(15, 18, 26)
                headshot.Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(pData.id) .. "&w=150&h=150"
                headshot.Parent = card
                Instance.new("UICorner", headshot).CornerRadius = UDim.new(1, 0)

                local title = Instance.new("TextLabel")
                title.Size = UDim2.new(1, -140, 1, 0)
                title.Position = UDim2.fromOffset(50, 0)
                title.BackgroundTransparency = 1
                title.Text = pData.displayName .. "\n@" .. pData.name
                title.TextColor3 = Color3.fromRGB(240, 245, 255)
                title.Font = Enum.Font.GothamSemibold
                title.TextSize = 10
                title.TextXAlignment = Enum.TextXAlignment.Left
                title.Parent = card

                local inspectBtn = createContentButton(card, "Inspect Profile", UDim2.fromOffset(80, 26), UDim2.new(1, -85, 0.5, -13), Color3.fromRGB(0, 120, 200))
                inspectBtn.MouseButton1Click:Connect(function()
                    showPlayerDetails(pData.id)
                end)
            end
        end)
    end

    searchSubmitBtn.MouseButton1Click:Connect(executeSearch)
    searchInput.FocusLost:Connect(function(enterPressed) if enterPressed then executeSearch() end end)
end

